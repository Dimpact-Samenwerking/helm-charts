[MAIN]
# ruff (see ruff.toml, same directory) already covers everything else this
# project wants checked; pylint is added on top ONLY for the one thing ruff
# has no equivalent rule for at all: total module line count. Narrow and
# deliberate on purpose, matching ruff.toml's own "one rule, one documented
# reason" precedent -- not a general-purpose second linter running in
# parallel with the first.
#
# Invoke explicitly against the extensionless top-level scripts too (pylint
# won't discover them via a bare directory/glob scan the way it does *.py
# files) -- and against tests/ (several test modules are themselves well
# over 1000 lines), e.g.:
#   pylint --rcfile=charts/podiumd/bin/pylintrc \
#       charts/podiumd/bin/lib/*.py charts/podiumd/bin/<script-name...> \
#       $(find charts/podiumd/bin/tests -name '*.py')

[MESSAGES CONTROL]
disable = all
enable = too-many-lines

[FORMAT]
# Matches ruff.toml's own line-length (see that file's own comment for why
# 120: this codebase's deliberate long-docstring style). max-module-lines
# is left at pylint's own upstream default (1000) -- not re-tuned here.
max-line-length = 120
