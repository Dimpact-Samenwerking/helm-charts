#!/usr/bin/env python3
"""
Rebase every docs/_UPGRADE_PATHS/<baseline>-to-<target>-*.md doc (and
docs/images/images-<target>.yaml) for the current chart's target
version — charts/podiumd/Chart.yaml's own "version:" — onto
charts/podiumd/etc/release-baseline.yaml's own upgrade_docs baseline,
e.g. renaming "4.8.2-to-4.9.0-upgrade.md" to "4.8.3-to-4.9.0-upgrade.md"
once upgrade_docs reads "4.8.3", updating titles/headings and any
sibling-doc cross-reference (any "<X>-to-<target>-*.md" mention,
wherever it appears in the text — this chart supports exactly one
upgrade path per target, so every such reference always means the
current baseline). A doc already
at the target baseline is checked for a stale sibling reference too
(a scar from an earlier, incomplete rebase this doc's own baseline
already moved past) even though nothing else about it changes. Also
correcting the
"Component versions" table and images-manifest entries against
Chart.yaml/values.yaml, ADDING a new table row + matching "### ..."
Changes section for a component that changed vs the baseline but has no
row at all yet (see add_missing_component_rows — the same "component ...
changed vs ... but has no row" gap verify-podiumd's own doc-consistency
check reports), and likewise for a sidecar/shared image whose OWN row is
missing even though its owning dependency's row already exists (see
lib.image.docs.add_missing_sidecar_rows — the "sidecar/shared image ...
changed vs ... but has no row" gap, e.g. a nested init-container image
bumped alongside its parent component but never given its own
"<component> - <basename>" row), reordering the table's rows and the
"## Changes" section's "### ..." blocks to match values.yaml's own
top-level component order. Also ADDING a brand new "## <name> ..."
section to the values-deltas doc for a component that changed but has
no section of its own yet (see lib.component_docs.sync_values_delta_
sections — the "component ... changed vs ... but has no section" gap),
and appending any "- Key `...` was added/removed" lines for NESTED
schema changes to whichever section (new or already existing) covers
that component, reordering the doc's own "## ..." sections the same way
(see sort_values_delta_sections). Any of the three standard docs that
don't already exist under ANY baseline for this target are created as
TODO stubs instead (nothing to rebase) — see create-doc-version for a
script that ONLY ever does that, refusing outright if docs already
exist under some other baseline (this script owns rebasing those on
purpose; that one refuses to touch them). See fix_component_version_
table, add_missing_component_rows, add_missing_sidecar_rows, sync_
values_delta_sections, fix_images_manifest_entries, and add_missing_
images_manifest_entries for exactly what gets rewritten/added vs. just
reported for manual review. A
missing images-manifest entry IS auto-added now (its own "# ... — <old>
-> <new>" comment and version/digest all mechanically derivable from
values.yaml's own already-pinned tag) — but with "name:"/"url:" both set
to the same resolved repository string rather than the curated ACR
mirror slug docs/images/acr-mirror-naming.md documents, which has no
reliable mechanical formula and stays a human's job to correct by hand
afterward. A sidecar row's own values-delta mention is still never
auto-added — no mechanically-derivable placeholder exists for prose
explaining WHY a change happened, unlike a manifest entry's own fields.

Never takes the baseline as an argument — always release-baseline.
yaml's own upgrade_docs key, so change-podiumd-baseline only has to
write that key (which it does right before calling this script) for
this to pick it up; that's also the only sanctioned way to actually
change what baseline this script rebases onto, see that script for
the usual "rebase onto a different baseline" workflow. This script
itself never writes release-baseline.yaml. Errors if the file or key
doesn't exist yet — run create-podiumd-version (new release cycle) or
change-podiumd-baseline <baseline> (existing cycle) first. Also
runnable standalone, to repair the current baseline's docs in place
without rebasing (e.g. after a manual values.yaml edit).

Usage:
    fix-doc-consistency

Example:
    fix-doc-consistency
        # if Chart.yaml's version is 4.9.0 and release-baseline.yaml's
        # upgrade_docs is "4.8.3", renames *-to-4.9.0-*.md accordingly
        # and repairs their content against Chart.yaml/values.yaml
"""

import sys
from pathlib import Path

import yaml

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# Not installed as a package -- sys.path must be patched before
# lib.* can be imported, so these imports can't move to the top.
# pylint: disable=wrong-import-position
from lib.chart.historical_baselines import SEMVER_RE as BASELINE_VERSION_RE
from lib.chart.pull_and_subchart_resolution import global_image_paths
from lib.chart.release_baseline_basics import chart_version
from lib.chart.release_baseline_basics import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.chart.repo_and_path_resolution import (
    canonical_sidecar_row_names,
    paths_by_repository,
    repo_group_representative,
)
from lib.component_docs.baseline_doc_stubs import (
    IMAGES_STUB_TEMPLATE,
    STANDARD_SUFFIXES,
    STUB_TEMPLATES,
    existing_doc_baselines,
)
from lib.component_docs.changes_section import add_missing_component_rows, strip_stale_upgrade_placeholders
from lib.component_docs.images_manifest_changes_header import renumber_images_manifest_changes_items
from lib.component_docs.values_delta_sections import (
    prune_empty_values_delta_sections,
    strip_stale_values_deltas_todo_stub,
    sync_values_delta_sections,
)
from lib.fix_doc_consistency.baseline_and_images_manifest_handling import (
    extract_images_baseline,
    update_images_manifest_baseline,
    update_sibling_doc_refs,
)
from lib.fix_doc_consistency.component_version_table import (
    fix_changes_heading_app_versions,
    fix_component_version_table,
    fix_values_delta_heading_app_versions,
)
from lib.fix_doc_consistency.manifest_changes_items import (
    dedupe_images_manifest_changes_items,
    sort_images_manifest_changes_items,
)

# resolve_entry_version below is test-only, see cdb.resolve_entry_version
# in tests/fix-doc-consistency -- pylint attributes unused-import to the
# "from" line of a multi-import statement, not the unused name's own line.
from lib.fix_doc_consistency.manifest_entries_core import (  # pylint: disable=unused-import
    fix_images_manifest_entries,
    resolve_entry_version,  # noqa: F401
)
from lib.fix_doc_consistency.manifest_entries_new_and_urls import (
    add_missing_images_manifest_entries,
    fix_images_manifest_entry_urls,
)

# ensure_blank_lines_around_headings below is test-only, see
# cdb.ensure_blank_lines_around_headings in tests/fix-doc-consistency.
from lib.fix_doc_consistency.text_helpers_and_repo_rename import (  # pylint: disable=unused-import
    collapse_multiple_blank_lines,
    ensure_blank_lines_around_headings,  # noqa: F401
    find_collisions,
    git_mv,
    join_and,
    remaining_mentions,
    update_component_versions_heading,
    update_title_line,
)
from lib.gitutil import baseline_ref_candidates, find_repo_root, git_show_yaml, resolve_git_ref
from lib.image.docs import (
    add_missing_changes_sections,
    add_missing_sidecar_rows,
    regenerate_images_baseline_manifest,
    update_stale_app_version_headings,
)
from lib.render_scope import lint_args_for, render_chart, rendered_chart_paths
from lib.upgradedoc.app_version_and_image_paths import find_all_image_and_version_paths, find_image_tag_paths
from lib.upgradedoc.images_manifest_list_diff import compute_changed_components
from lib.upgradedoc.images_manifest_ordering import (
    images_manifest_display_name_positions,
    images_manifest_entry_positions,
    sort_images_manifest_entries,
)
from lib.upgradedoc.sorting_and_ordering import sort_changes_blocks, sort_upgrade_doc_rows, sort_values_delta_sections

# canonical_version_cell below is test-only, see cdb.canonical_version_cell
# in tests/fix-doc-consistency.
from lib.upgradedoc.version_cells_and_key_changes import (  # pylint: disable=unused-import
    canonical_version_cell,  # noqa: F401
)

CHART_YAML = SCRIPT_DIR.parents[0] / "Chart.yaml"
VALUES_YAML = SCRIPT_DIR.parents[0] / "values.yaml"
DOC_DIR = SCRIPT_DIR.parents[0] / "docs" / "_UPGRADE_PATHS"
IMAGES_DIR = SCRIPT_DIR.parents[0] / "docs" / "images"


def current_chart_version():
    """Returns the rebase target: charts/podiumd/Chart.yaml's own
    "version:" field."""
    return chart_version(CHART_YAML)


# The exact shape a baseline argument must have — bare MAJOR.MINOR.PATCH,
# matching every doc filename's own "<baseline>-to-<target>-*.md" pattern
# (see lib.component_docs.DOC_FILENAME_RE_TMPL). Anything else (a flag
# like "--help", a git ref, a version with a suffix) is rejected up front
# by main(), rather than silently being treated as a literal baseline and
# renaming docs to nonsense like "--help-to-4.9.0-upgrade.md".
# (BASELINE_VERSION_RE is lib.chart.historical_baselines.SEMVER_RE, imported under this
# script's own established name.)


def images_manifest_path(target):
    """Returns the path of the images manifest for `target`
    (docs/images/images-<target>.yaml), whether or not it exists yet."""
    return IMAGES_DIR / f"images-{target}.yaml"


def load_target_state():
    """Returns (deps, values) as they currently are on disk: charts/
    podiumd/Chart.yaml's own dependencies list and values.yaml's parsed
    contents — the "current" side of every baseline-vs-target comparison
    this script makes, paired with load_baseline_state's own (deps,
    values) for the old baseline."""
    chart_yaml = yaml.safe_load(CHART_YAML.read_text(encoding="utf-8"))
    values = yaml.safe_load(VALUES_YAML.read_text(encoding="utf-8")) or {}
    return chart_yaml.get("dependencies", []), values


def load_baseline_state(new_baseline):
    """(deps, values) as they were at new_baseline's resolved git ref, or
    (None, None) if it can't be resolved (e.g. that release hasn't been cut
    yet) — callers skip table-version correction gracefully in that case."""
    repo_root = find_repo_root(CHART_YAML.parent)
    if repo_root is None:
        return None, None
    ref = resolve_git_ref(repo_root, baseline_ref_candidates(new_baseline))
    if ref is None:
        return None, None
    rel_chart_dir = CHART_YAML.parent.relative_to(repo_root)
    baseline_chart_yaml = git_show_yaml(repo_root, ref, f"{rel_chart_dir}/Chart.yaml")
    if baseline_chart_yaml is None:
        return None, None
    baseline_values = git_show_yaml(repo_root, ref, f"{rel_chart_dir}/values.yaml") or {}
    return baseline_chart_yaml.get("dependencies", []), baseline_values


def main():
    """CLI entry point: rebases every upgrade-path doc and the images
    manifest for the current target version onto release-baseline.yaml's
    own upgrade_docs baseline — renaming files, correcting the component-
    versions table, values-deltas sections and images-manifest entries
    against the current Chart.yaml/values.yaml (see module docstring for
    the full list of what gets auto-fixed vs. just reported), and creating
    TODO stubs for any of the three standard docs that don't exist yet
    under any baseline."""
    if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    if len(sys.argv) != 1:
        print(__doc__)
        sys.exit(1)

    new_baseline = read_upgrade_docs_baseline(CHART_YAML.parent)
    if new_baseline is None:
        print(
            "error: release-baseline.yaml has no upgrade_docs key (or the file doesn't "
            "exist yet) — run create-podiumd-version (new release cycle) or "
            "change-podiumd-baseline <baseline> (existing cycle) to set it first"
        )
        sys.exit(1)

    if not BASELINE_VERSION_RE.match(new_baseline):
        print(f"error: '{new_baseline}' is not a valid MAJOR.MINOR.PATCH version")
        sys.exit(1)
    target = current_chart_version()

    by_suffix = existing_doc_baselines(DOC_DIR, target)

    collisions = find_collisions(by_suffix)
    if collisions:
        print(f"error: multiple source docs would collide on the same target for '{target}':")
        for suffix, entries in sorted(collisions.items()):
            print(f"  {suffix}:")
            for baseline, path in sorted(entries):
                print(f"    {path.name}  (baseline {baseline})")
        print()
        print("Refusing to rename anything — resolve the collision above first.")
        sys.exit(1)

    print(f"=== Bumping baseline for target {target} to {new_baseline} ===")
    review_notes = []
    # Every *-upgrade.md/*-values-deltas.md doc this run touches (renamed
    # or not) gets checked for its own stub TODO placeholder stranded
    # beside real content already inserted before insert_changes_section/
    # insert_values_delta_section's own insertion-time fix existed (real
    # case, confirmed live: 4.9.1-to-4.9.2-upgrade.md and its own values-
    # deltas sibling) — collected here for one aggregate summary line.
    todo_stub_docs = []
    all_suffixes = sorted(set(by_suffix) | set(STANDARD_SUFFIXES))
    for suffix in all_suffixes:
        if suffix not in by_suffix:
            new_name = f"{new_baseline}-to-{target}-{suffix}.md"
            new_path = DOC_DIR / new_name
            new_path.write_text(
                STUB_TEMPLATES[suffix].format(upgrade_docs_baseline=new_baseline, target=target), encoding="utf-8"
            )
            print(f"  {new_name}: created (was missing)")
            continue

        [(old_baseline, path)] = by_suffix[suffix]
        if old_baseline == new_baseline:
            # Already at the target baseline itself, but a sibling-doc
            # reference can still be stale — a scar from an earlier,
            # incomplete rebase this doc's own baseline already moved past
            # (see update_sibling_doc_refs). Worth checking even on this
            # no-rename path: nothing else below would ever touch this
            # doc again once it's "unchanged".
            text = path.read_text(encoding="utf-8")
            text, refs_changed = update_sibling_doc_refs(text, target, new_baseline)
            # Retroactive stub-TODO cleanup (see todo_stub_docs above) —
            # checked here too: this "already baseline" path is the ONLY
            # write site this doc's own suffix-specific content-fixing
            # pass further below ever runs for, since that pass only
            # fires when the baseline IS being bumped this same run.
            todo_stripped = False
            if suffix == "upgrade":
                text, todo_stripped = strip_stale_upgrade_placeholders(text)
            elif suffix == "values-deltas":
                text, todo_stripped = strip_stale_values_deltas_todo_stub(text)
            # A pre-existing double blank line unrelated to refs_changed
            # (or to anything else this loop checks) must still never
            # survive untouched — for gemeente-specific.md, and any other
            # non-STANDARD_SUFFIXES doc this rename loop also covers
            # (e.g. operators-crds.md), this is the ONLY write site that
            # ever touches it at all; upgrade.md/values-deltas.md's own
            # later content-fixing pass has its own equivalent check, but
            # only ever runs when this doc's baseline is ALSO being
            # bumped this same run, never on this no-rename path.
            collapsed_text = collapse_multiple_blank_lines(text)
            blank_lines_fixed = collapsed_text != text
            if refs_changed or blank_lines_fixed or todo_stripped:
                path.write_text(collapsed_text, encoding="utf-8")
                parts = []
                if todo_stripped:
                    parts.append("removed stale TODO placeholder")
                    todo_stub_docs.append(path.name)
                if refs_changed:
                    parts.append("fixed stale sibling doc reference(s)")
                if blank_lines_fixed:
                    parts.append("collapsed multiple blank line(s)")
                print(f"  {path.name}: already baseline {new_baseline} — {join_and(parts)}")
            else:
                print(f"  {path.name}: already baseline {new_baseline} — unchanged")
            continue

        new_name = f"{new_baseline}-to-{target}-{suffix}.md"
        new_path = DOC_DIR / new_name
        text = path.read_text(encoding="utf-8")

        text, title_changed = update_title_line(text, old_baseline, target, new_baseline)
        text, heading_changed = update_component_versions_heading(text, old_baseline, target, new_baseline)
        text, refs_changed = update_sibling_doc_refs(text, target, new_baseline)
        todo_stripped = False
        if suffix == "upgrade":
            text, todo_stripped = strip_stale_upgrade_placeholders(text)
        elif suffix == "values-deltas":
            text, todo_stripped = strip_stale_values_deltas_todo_stub(text)

        if path != new_path:
            git_mv(path, new_path)
        new_path.write_text(collapse_multiple_blank_lines(text), encoding="utf-8")

        print(f"  {path.name} -> {new_name}")
        if title_changed:
            print(f"    title line: {old_baseline} -> {new_baseline}")
        if heading_changed:
            print(f"    'Component versions' heading: {old_baseline} -> {new_baseline}")
        if refs_changed:
            print(f"    sibling doc references: -> {new_baseline}-to-{target}-*.md")
        if todo_stripped:
            print("    removed stale TODO placeholder")
            todo_stub_docs.append(new_name)

        leftovers = remaining_mentions(text, old_baseline)
        if leftovers:
            review_notes.append((new_name, leftovers))

    images_path = images_manifest_path(target)
    if not images_path.is_file():
        images_path.write_text(
            IMAGES_STUB_TEMPLATE.format(upgrade_docs_baseline=new_baseline, target=target), encoding="utf-8"
        )
        print(f"  {images_path.name}: created (was missing)")
    else:
        text = images_path.read_text(encoding="utf-8")
        old_images_baseline = extract_images_baseline(text)
        if old_images_baseline == new_baseline:
            print(f"  {images_path.name}: already baseline {new_baseline} — unchanged")
        else:
            text, refs_changed = update_sibling_doc_refs(text, target, new_baseline)
            text, baseline_changed = update_images_manifest_baseline(text, target, new_baseline)
            images_path.write_text(text, encoding="utf-8")
            print(f"  {images_path.name}: baseline updated")
            if refs_changed:
                print(f"    doc references -> {new_baseline}-to-{target}-*.md")
            if baseline_changed:
                print(f"    baseline header line(s): -> {new_baseline}")
            if old_images_baseline:
                leftovers = remaining_mentions(text, old_images_baseline)
                if leftovers:
                    review_notes.append((images_path.name, leftovers))

    target_deps, target_values = load_target_state()
    baseline_deps, baseline_values = load_baseline_state(new_baseline)
    actual_changed_keys = (
        compute_changed_components(target_deps, baseline_deps, target_values, baseline_values)
        if baseline_deps is not None
        else set()
    )

    upgrade_path = DOC_DIR / f"{new_baseline}-to-{target}-upgrade.md"
    if upgrade_path.is_file():
        text = upgrade_path.read_text(encoding="utf-8")
        text, changed_rows, unmatched_names, unresolved_names = fix_component_version_table(
            text,
            CHART_YAML.parent,
            target_deps,
            target_values,
            baseline_deps,
            baseline_values,
            upgrade_docs_baseline=new_baseline,
        )
        if changed_rows:
            print()
            print(f"=== Correcting component version table in {upgrade_path.name} ===")
            for name, app_cell, chart_cell in changed_rows:
                print(f"  {name}: app {app_cell}  |  chart {chart_cell}")
        if unresolved_names:
            print()
            print(
                f"Could not verify source version for {len(unresolved_names)} component(s) in "
                f"{upgrade_path.name} — baseline {new_baseline} doesn't resolve to a git ref, "
                f"or the component didn't exist there yet. Table left as-is for these; review "
                f"by hand."
            )
            for name in unresolved_names:
                print(f"  {name}")
        if unmatched_names:
            print()
            print(
                f"Could not match {len(unmatched_names)} component(s) in {upgrade_path.name} "
                f"to a Chart.yaml dependency, left as-is:"
            )
            for name in unmatched_names:
                print(f"  {name}")

        text, added_names = add_missing_component_rows(
            text,
            CHART_YAML.parent,
            target_deps,
            target_values,
            baseline_deps,
            baseline_values,
            actual_changed_keys,
            target,
            upgrade_docs_baseline=new_baseline,
        )
        if added_names:
            print()
            print(f"=== Adding missing component row(s) + Changes section(s) to {upgrade_path.name} ===")
            for name in added_names:
                print(f"  {name}")

        if baseline_deps is not None:
            text, added_sidecar_names = add_missing_sidecar_rows(
                text,
                CHART_YAML.parent,
                target_deps,
                target_values,
                baseline_values,
                target,
                upgrade_docs_baseline=new_baseline,
            )
            if added_sidecar_names:
                print()
                print(f"=== Adding missing sidecar/shared-image row(s) + Changes section(s) to {upgrade_path.name} ===")
                for name in added_sidecar_names:
                    print(f"  {name}")
        else:
            added_sidecar_names = []

        current_paths = dict(find_image_tag_paths(target_values))
        current_paths.update(global_image_paths(target_values))
        canonical_names = canonical_sidecar_row_names(
            CHART_YAML.parent, target_deps, target_values, current_paths.keys()
        )

        text, added_section_names = add_missing_changes_sections(
            text, target_deps, target_values, target, canonical_names
        )
        if added_section_names:
            print()
            print(f"=== Adding missing '### ...' Changes section(s) to {upgrade_path.name} ===")
            for name in added_section_names:
                print(f"  {name}")

        text, updated_stale_headings = update_stale_app_version_headings(
            text, CHART_YAML.parent, target_deps, target_values, target, canonical_names
        )
        if updated_stale_headings:
            print()
            print(f"=== Updating '### ...' Changes section(s) missing their app version in {upgrade_path.name} ===")
            for heading in updated_stale_headings:
                print(f"  {heading}")

        text, updated_wrong_headings = fix_changes_heading_app_versions(
            text,
            CHART_YAML.parent,
            target_deps,
            target_values,
            baseline_deps,
            baseline_values,
            upgrade_docs_baseline=new_baseline,
        )
        if updated_wrong_headings:
            print()
            print(
                f"=== Correcting '### ...' Changes section heading(s) with the wrong name/app-version "
                f"transition in {upgrade_path.name} ==="
            )
            for heading in updated_wrong_headings:
                print(f"  {heading}")

        text, moved_rows = sort_upgrade_doc_rows(text, target_deps, target_values, canonical_names)
        text, moved_blocks = sort_changes_blocks(text, target_deps, target_values, canonical_names)
        if moved_rows or moved_blocks:
            print()
            print(f"=== Reordering {upgrade_path.name} to match values.yaml's component order ===")
            for name, old_pos, new_pos in moved_rows:
                print(f"  table row '{name}': position {old_pos} -> {new_pos}")
            for heading, old_pos, new_pos in moved_blocks:
                print(f"  changes block '### {heading}': position {old_pos} -> {new_pos}")

        # Checked (and, if needed, written) regardless of whether anything
        # ABOVE changed — a pre-existing double blank line unrelated to
        # any of this run's own edits (or one from before this check
        # itself existed) must still never survive untouched just because
        # this doc otherwise needed no correction at all.
        collapsed_text = collapse_multiple_blank_lines(text)
        blank_lines_fixed = collapsed_text != text
        if blank_lines_fixed:
            print()
            print(f"=== Collapsing multiple consecutive blank line(s) in {upgrade_path.name} ===")

        if (
            changed_rows
            or added_names
            or added_sidecar_names
            or added_section_names
            or updated_stale_headings
            or updated_wrong_headings
            or moved_rows
            or moved_blocks
            or blank_lines_fixed
        ):
            upgrade_path.write_text(collapsed_text, encoding="utf-8")

    if images_path.is_file():
        text = images_path.read_text(encoding="utf-8")
        target_paths = [p for p, _tag in find_all_image_and_version_paths(target_values, target_deps)] + [
            p for p, _tag in global_image_paths(target_values)
        ]
        repo_groups = paths_by_repository(CHART_YAML.parent, target_deps, target_values, target_paths)
        repo_map = {
            repo: repo_group_representative(group_paths, target_deps) for repo, group_paths in repo_groups.items()
        }
        canonical_names = canonical_sidecar_row_names(CHART_YAML.parent, target_deps, target_values, target_paths)
        new_text, changed_entries, unresolved_entry_names = fix_images_manifest_entries(
            text,
            CHART_YAML.parent,
            target_deps,
            target_values,
            baseline_values,
            repo_map,
            upgrade_docs_baseline=new_baseline,
        )
        if changed_entries:
            images_path.write_text(new_text, encoding="utf-8")
            print()
            print(f"=== Correcting entry comments in {images_path.name} ===")
            for name, source, target_ver in changed_entries:
                print(f"  {name}: {source} -> {target_ver}")
        if unresolved_entry_names:
            print()
            print(
                f"Could not verify source/target version for {len(unresolved_entry_names)} "
                f"entry(s) in {images_path.name} — no preceding comment, unresolvable "
                f"values-tree path, or baseline {new_baseline} doesn't resolve to a git ref. "
                f"Left as-is; review by hand."
            )
            for name in unresolved_entry_names:
                print(f"  {name}")

        text = images_path.read_text(encoding="utf-8")
        new_text, changed_urls, unresolved_url_names = fix_images_manifest_entry_urls(
            text, CHART_YAML.parent, target_deps, target_values, repo_map
        )
        if changed_urls:
            images_path.write_text(new_text, encoding="utf-8")
            print()
            print(f"=== Correcting entry url(s) in {images_path.name} ===")
            for name, old_url, new_url in changed_urls:
                print(f"  {name}: {old_url} -> {new_url}")
        if unresolved_url_names:
            print()
            print(
                f"Could not verify the fully host-qualified url for {len(unresolved_url_names)} "
                f"entry(s) in {images_path.name} — unresolvable values-tree path or repository. "
                f"Left as-is; review by hand."
            )
            for name in unresolved_url_names:
                print(f"  {name}")

        if baseline_values:
            text = images_path.read_text(encoding="utf-8")
            new_text, added_entry_names, skipped_entry_names, backfilled_header_names = (
                add_missing_images_manifest_entries(
                    text,
                    CHART_YAML.parent,
                    target_deps,
                    target_values,
                    baseline_values,
                    allow_pull=True,
                    upgrade_docs_baseline=new_baseline,
                )
            )
            if added_entry_names:
                images_path.write_text(new_text, encoding="utf-8")
                print()
                print(f"=== Adding missing entr(y/ies) to {images_path.name} ===")
                for name in added_entry_names:
                    print(f"  {name} (review 'name:' for the correct ACR mirror slug)")
            if skipped_entry_names:
                print()
                print(
                    f"Could not add an entry for {len(skipped_entry_names)} changed image(s) in "
                    f"{images_path.name} — no resolvable repository, or its values.yaml tag has no "
                    f"digest pinned yet. Add by hand."
                )
                for name in skipped_entry_names:
                    print(f"  {name}")
            if backfilled_header_names:
                images_path.write_text(new_text, encoding="utf-8")
                print()
                print(f"=== Adding missing '# Changes:' header item(s) to {images_path.name} ===")
                for name in backfilled_header_names:
                    print(f"  {name} (entry already existed — only its header item was missing)")

        lines = images_path.read_text(encoding="utf-8").splitlines(keepends=True)
        removed_duplicate_items = dedupe_images_manifest_changes_items(lines)
        if removed_duplicate_items:
            images_path.write_text("".join(lines), encoding="utf-8")
            print()
            print(f"=== Removing duplicate '# Changes:' header item(s) from {images_path.name} ===")
            for item_text in removed_duplicate_items:
                print(f"  {item_text}")

        before_sort = images_path.read_text(encoding="utf-8")
        try:
            entries_for_header_sort = yaml.safe_load(before_sort) or []
        except yaml.YAMLError:
            entries_for_header_sort = []
        entry_positions = images_manifest_entry_positions(
            before_sort, target_deps, target_values, repo_map, canonical_names
        )
        display_name_positions = images_manifest_display_name_positions(
            before_sort, target_deps, target_values, repo_map, canonical_names
        )
        lines = before_sort.splitlines(keepends=True)
        moved_header_items = sort_images_manifest_changes_items(
            lines, entries_for_header_sort, entry_positions, display_name_positions
        )
        text = "".join(lines)
        text, moved_entries = sort_images_manifest_entries(text, target_deps, target_values, repo_map, canonical_names)
        if text != before_sort:
            images_path.write_text(text, encoding="utf-8")
            print()
            print(f"=== Reordering {images_path.name} to match values.yaml's component order ===")
            for item_text, old_pos, new_pos in moved_header_items:
                print(f"  '# Changes:' item {old_pos} -> {new_pos}: {item_text}")
            for name, old_pos, new_pos in moved_entries:
                print(f"  entry '{name}': position {old_pos} -> {new_pos}")
            if not moved_header_items and not moved_entries:
                print("  (blank lines within group(s) tidied)")

        # A gap or wrong number the list already had — e.g. a human
        # hand-removing a stale item's own block without renumbering
        # everything after it (see #437-era digest cleanups) — is
        # invisible to dedupe/sort above: neither fires at all when the
        # list has no duplicates and is already in the right RELATIVE
        # order, only wrong ABSOLUTE numbers. This pass always fixes
        # that, independent of anything else.
        lines = images_path.read_text(encoding="utf-8").splitlines(keepends=True)
        if renumber_images_manifest_changes_items(lines):
            images_path.write_text("".join(lines), encoding="utf-8")
            print()
            print(f"=== Renumbering '# Changes:' list in {images_path.name} ===")

    values_deltas_path = DOC_DIR / f"{new_baseline}-to-{target}-values-deltas.md"
    if values_deltas_path.is_file():
        if baseline_deps is None or baseline_values is None:
            print()
            print(
                f"Could not resolve baseline {new_baseline} to a git ref — skipping "
                f"added/removed/renamed key detection for {values_deltas_path.name}."
            )
        else:
            changed_keys = compute_changed_components(target_deps, baseline_deps, target_values, baseline_values)
            text = values_deltas_path.read_text(encoding="utf-8")
            write_needed = False

            values_delta_target_paths = [
                p for p, _tag in find_all_image_and_version_paths(target_values, target_deps)
            ] + [p for p, _tag in global_image_paths(target_values)]
            values_delta_canonical_names = canonical_sidecar_row_names(
                CHART_YAML.parent, target_deps, target_values, values_delta_target_paths
            )

            text, created_names, updated_names = sync_values_delta_sections(
                text,
                CHART_YAML.parent,
                target_deps,
                target_values,
                baseline_deps,
                baseline_values,
                changed_keys,
                values_delta_canonical_names,
            )
            if created_names or updated_names:
                write_needed = True
                if created_names:
                    print()
                    print(f"=== Adding new component section(s) to {values_deltas_path.name} ===")
                    for name in created_names:
                        print(f"  {name}")
                if updated_names:
                    print()
                    print(f"=== Adding missing key-change mention(s) to {values_deltas_path.name} ===")
                    for name in updated_names:
                        print(f"  {name}")

            # upgrade_path's own text at this point already reflects
            # everything fix_component_version_table/fix_changes_
            # heading_app_versions corrected above (written to disk by
            # then, whether or not anything actually changed there) -
            # the SAME row data this heading correction keys against
            # (see fix_values_delta_heading_app_versions' own docstring
            # for why -upgrade.md's own table is the authoritative
            # source, not this doc, which has no table of its own).
            upgrade_doc_text = upgrade_path.read_text(encoding="utf-8") if upgrade_path.is_file() else ""
            text, updated_delta_headings = fix_values_delta_heading_app_versions(
                upgrade_doc_text,
                text,
                CHART_YAML.parent,
                target_deps,
                target_values,
                baseline_deps,
                baseline_values,
                upgrade_docs_baseline=new_baseline,
            )
            if updated_delta_headings:
                write_needed = True
                print()
                print(
                    f"=== Correcting '## ...' section heading(s) with the wrong name/app-version "
                    f"transition in {values_deltas_path.name} ==="
                )
                for heading in updated_delta_headings:
                    print(f"  {heading}")

            text, pruned_headings = prune_empty_values_delta_sections(text)
            if pruned_headings:
                write_needed = True
                print()
                print(f"=== Removing empty section(s) from {values_deltas_path.name} ===")
                for heading in pruned_headings:
                    print(f"  '## {heading}'")

            text, moved_sections = sort_values_delta_sections(
                text, target_deps, target_values, values_delta_canonical_names
            )
            if moved_sections:
                write_needed = True
                print()
                print(f"=== Reordering {values_deltas_path.name} to match values.yaml's component order ===")
                for heading, old_pos, new_pos in moved_sections:
                    print(f"  '## {heading}': position {old_pos} -> {new_pos}")

            # Checked (and, if needed, written) regardless of whether
            # anything ABOVE changed — see the matching comment on
            # upgrade_path's own write site above.
            collapsed_text = collapse_multiple_blank_lines(text)
            if collapsed_text != text:
                write_needed = True
                print()
                print(f"=== Collapsing multiple consecutive blank line(s) in {values_deltas_path.name} ===")

            if write_needed:
                values_deltas_path.write_text(collapsed_text, encoding="utf-8")

    if todo_stub_docs:
        print()
        print(f"removed stale TODO placeholder from {len(todo_stub_docs)} doc(s): {', '.join(todo_stub_docs)}")

    if review_notes:
        print()
        print("Review these lines by hand — old baseline text may remain in free-form prose:")
        for name, lines in review_notes:
            print(f"  {name}: line(s) {', '.join(map(str, lines))}")

    print()
    print("=== Regenerating images-baseline.yaml ===")
    # Rendered with ci/lint-values.yaml (same convention every other
    # render-based check in this codebase already uses) — a bare
    # `values.yaml` render fails outright: several sub-charts declare
    # required fields (JSON-schema "minLength", etc.) only ever
    # satisfied by that CI overlay, which a real deploy always supplies
    # via its own environment-specific values anyway.
    render_result = render_chart(CHART_YAML.parent, lint_args_for(CHART_YAML.parent))
    if render_result.returncode != 0:
        print(
            "  error: helm template failed to render — can't check for images defined only "
            "in a vendored sub-chart's own default values.yaml (see check_subchart_image_"
            "visibility); fix the render first"
        )
        print(render_result.stderr)
        sys.exit(1)
    rendered_paths = rendered_chart_paths(render_result.stdout)

    written, skipped, changed = regenerate_images_baseline_manifest(
        CHART_YAML.parent, target_deps, target_values, IMAGES_DIR / "images-baseline.yaml", rendered_paths
    )
    if changed:
        print(f"  wrote {written} entr{'y' if written == 1 else 'ies'}")
    else:
        print(f"  unchanged ({written} entr{'y' if written == 1 else 'ies'})")
    if skipped:
        print(
            f"  could not resolve a full url/digest for {len(skipped)} repositor{'y' if len(skipped) == 1 else 'ies'} "
            f"— review by hand:"
        )
        for repo in skipped:
            print(f"    {repo}")

    print()
    print("Done.")


if __name__ == "__main__":
    main()
