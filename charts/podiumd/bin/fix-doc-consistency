#!/usr/bin/env python3
"""
Rebase every docs/_UPGRADE_PATHS/<baseline>-to-<target>-*.md doc (and
docs/images/images-<target>.yaml) for the current chart's target
version — charts/podiumd/Chart.yaml's own "version:" — onto
charts/podiumd/etc/release-baseline.yaml's own upgrade_docs baseline,
e.g. renaming "4.8.2-to-4.9.0-upgrade.md" to "4.8.3-to-4.9.0-upgrade.md"
once upgrade_docs reads "4.8.3", updating titles/headings and any
sibling-doc cross-reference (any "<X>-to-<target>-*.md" mention,
wherever it appears in the text — this chart supports exactly one
upgrade path per target, so every such reference always means the
current baseline). A doc already
at the target baseline is checked for a stale sibling reference too
(a scar from an earlier, incomplete rebase this doc's own baseline
already moved past) even though nothing else about it changes. Also
correcting the
"Component versions" table and images-manifest entries against
Chart.yaml/values.yaml, ADDING a new table row + matching "### ..."
Changes section for a component that changed vs the baseline but has no
row at all yet (see add_missing_component_rows — the same "component ...
changed vs ... but has no row" gap verify-podiumd's own doc-consistency
check reports), and likewise for a sidecar/shared image whose OWN row is
missing even though its owning dependency's row already exists (see
lib.image.docs.add_missing_sidecar_rows — the "sidecar/shared image ...
changed vs ... but has no row" gap, e.g. a nested init-container image
bumped alongside its parent component but never given its own
"<component> - <basename>" row), reordering the table's rows and the
"## Changes" section's "### ..." blocks to match values.yaml's own
top-level component order. Also ADDING a brand new "## <name> ..."
section to the values-deltas doc for a component that changed but has
no section of its own yet (see lib.component_docs.sync_values_delta_
sections — the "component ... changed vs ... but has no section" gap),
and appending any "- Key `...` was added/removed" lines for NESTED
schema changes to whichever section (new or already existing) covers
that component, reordering the doc's own "## ..." sections the same way
(see sort_values_delta_sections). Any of the three standard docs that
don't already exist under ANY baseline for this target are created as
TODO stubs instead (nothing to rebase) — see create-doc-version for a
script that ONLY ever does that, refusing outright if docs already
exist under some other baseline (this script owns rebasing those on
purpose; that one refuses to touch them). See fix_component_version_
table, add_missing_component_rows, add_missing_sidecar_rows, sync_
values_delta_sections, fix_images_manifest_entries, and add_missing_
images_manifest_entries for exactly what gets rewritten/added vs. just
reported for manual review. A
missing images-manifest entry IS auto-added now (its own "# ... — <old>
-> <new>" comment and version/digest all mechanically derivable from
values.yaml's own already-pinned tag) — but with "name:"/"url:" both set
to the same resolved repository string rather than the curated ACR
mirror slug docs/images/acr-mirror-naming.md documents, which has no
reliable mechanical formula and stays a human's job to correct by hand
afterward. A sidecar row's own values-delta mention is still never
auto-added — no mechanically-derivable placeholder exists for prose
explaining WHY a change happened, unlike a manifest entry's own fields.

Never takes the baseline as an argument — always release-baseline.
yaml's own upgrade_docs key, so change-podiumd-baseline only has to
write that key (which it does right before calling this script) for
this to pick it up; that's also the only sanctioned way to actually
change what baseline this script rebases onto, see that script for
the usual "rebase onto a different baseline" workflow. This script
itself never writes release-baseline.yaml. Errors if the file or key
doesn't exist yet — run create-podiumd-version (new release cycle) or
change-podiumd-baseline <baseline> (existing cycle) first. Also
runnable standalone, to repair the current baseline's docs in place
without rebasing (e.g. after a manual values.yaml edit).

Usage:
    fix-doc-consistency

Example:
    fix-doc-consistency
        # if Chart.yaml's version is 4.9.0 and release-baseline.yaml's
        # upgrade_docs is "4.8.3", renames *-to-4.9.0-*.md accordingly
        # and repairs their content against Chart.yaml/values.yaml
"""
import re
import sys
from pathlib import Path

import yaml

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from lib.chart.historical_baselines import SEMVER_RE as BASELINE_VERSION_RE
from lib.chart.historical_baselines import historical_app_version_for_path
from lib.chart.pull_and_subchart_resolution import global_image_paths
from lib.chart.repo_and_path_resolution import canonical_sidecar_row_names, paths_by_repository, repo_group_representative
from lib.chart.registered_paths import image_paths_for
from lib.chart.release_baseline_basics import chart_version
from lib.chart.release_baseline_basics import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.component_docs.baseline_doc_stubs import (
    IMAGES_STUB_TEMPLATE, STANDARD_SUFFIXES, STUB_TEMPLATES, existing_doc_baselines,
)
from lib.component_docs.changes_section import add_missing_component_rows, strip_stale_upgrade_placeholders
from lib.component_docs.images_manifest_changes_header import renumber_images_manifest_changes_items
from lib.component_docs.values_delta_sections import (
    prune_empty_values_delta_sections, strip_stale_values_deltas_todo_stub, sync_values_delta_sections,
)
from lib.fix_doc_consistency.baseline_and_images_manifest_handling import (
    extract_images_baseline, update_images_manifest_baseline, update_sibling_doc_refs,
)
from lib.fix_doc_consistency.manifest_changes_items import (
    dedupe_images_manifest_changes_items, sort_images_manifest_changes_items,
)
from lib.fix_doc_consistency.manifest_entries_core import fix_images_manifest_entries, resolve_entry_version
from lib.fix_doc_consistency.manifest_entries_new_and_urls import (
    add_missing_images_manifest_entries, fix_images_manifest_entry_urls,
)
from lib.fix_doc_consistency.text_helpers_and_repo_rename import (
    collapse_multiple_blank_lines, ensure_blank_lines_around_headings, find_collisions, git_mv, join_and,
    remaining_mentions, update_component_versions_heading, update_title_line,
)
from lib.gitutil import baseline_ref_candidates, find_repo_root, git_show_yaml, resolve_git_ref
from lib.image.docs import (
    add_missing_changes_sections, add_missing_sidecar_rows, regenerate_images_baseline_manifest,
    update_stale_app_version_headings,
)
from lib.render_scope import lint_args_for, render_chart, rendered_chart_paths
