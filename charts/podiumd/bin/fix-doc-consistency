#!/usr/bin/env python3
"""
Rebase and repair the upgrade docs of the current target version.

Reads the target from Chart.yaml "version:" and the baseline from
etc/release-baseline.yaml "upgrade_docs". Renames every
docs/_UPGRADE_PATHS/<old>-to-<target>-*.md to the baseline and fixes
titles, headings and cross-references. Creates missing docs as TODO stubs.

Also repairs the content against Chart.yaml and values.yaml:
  - upgrade doc: component version table and "## Changes" sections,
    adding missing rows, removing rows unchanged vs the baseline and
    sorting them in values.yaml order; rebuilding a generated section
    that contradicts its row; a pin bullet for every values
    path that shares a YAML anchor with a documented pin; a missing
    "- Image / digest" pointer and the blank line before it
  - values-deltas doc: adds missing component sections and nested key
    added/removed lines
  - docs/images/images-<target>.yaml: fixes entries and "# Changes:"
    items, adds missing ones and removes images unchanged vs the
    baseline; review the "name:"/"url:" of added entries by hand (ACR
    mirror name)
  - docs/images/images-baseline.yaml: regenerated
Issues it cannot fix are printed for manual review.

Run change-podiumd-baseline to change the baseline; this script never
writes release-baseline.yaml. Exits 1 when that file or key is missing.

Usage:
    fix-doc-consistency

Example:
    fix-doc-consistency
        # target 4.9.0, upgrade_docs "4.8.3": renames *-to-4.9.0-*.md
        # to 4.8.3-to-4.9.0-*.md and repairs their content
"""

import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.historical_baselines import SEMVER_RE as BASELINE_VERSION_RE
from lib.chart.paths import CHART_YAML
from lib.chart.paths import DOC_DIR
from lib.chart.paths import IMAGES_DIR
from lib.chart.release_baseline_basics import chart_version
from lib.chart.release_baseline_basics import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.cli import positional_args
from lib.dependencies import ensure_vendored_dependencies
from lib.fix_doc_consistency.run import FixDocPaths
from lib.fix_doc_consistency.run import fix_docs
from lib.image.baseline_refresh import refresh_images_baseline


def current_chart_version():
    """Rebase target: Chart.yaml "version:"."""
    return chart_version(CHART_YAML)


def _parse_cli_args():
    """Handles -h/--help and rejects any other argument."""
    positional_args(__doc__, 0)


def _load_and_validate_baseline():
    """(new_baseline, target); exits if upgrade_docs is missing or not semver."""
    new_baseline = read_upgrade_docs_baseline(CHART_YAML.parent)
    if new_baseline is None:
        print(
            "error: release-baseline.yaml has no upgrade_docs key (or the file doesn't "
            "exist yet) — run create-podiumd-version (new release cycle) or "
            "change-podiumd-baseline <baseline> (existing cycle) to set it first"
        )
        sys.exit(1)

    if not BASELINE_VERSION_RE.match(new_baseline):
        print(f"error: '{new_baseline}' is not a valid MAJOR.MINOR.PATCH version")
        sys.exit(1)
    return new_baseline, current_chart_version()


def main():
    """CLI entry point."""
    _parse_cli_args()
    ensure_vendored_dependencies(CHART_YAML.parent)
    new_baseline, target = _load_and_validate_baseline()
    state = fix_docs(FixDocPaths(CHART_YAML.parent, DOC_DIR, IMAGES_DIR), target, new_baseline)
    refresh_images_baseline(
        CHART_YAML.parent, state.target_deps, state.target_values, IMAGES_DIR / "images-baseline.yaml"
    )

    print()
    print("Done.")


if __name__ == "__main__":
    main()
