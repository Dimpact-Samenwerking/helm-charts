#!/usr/bin/env python3
# The help text repeats other scripts' argument explanations on purpose;
# tests/lib/test_script_help_consistency.py keeps them equal.
# jscpd:ignore-start
"""
Bump a component's app image version and Helm chart version.

Checks both versions exist upstream before writing; a version already
at the requested value is left as is. Refuses when the component is in
etc/settings.yaml's chart_version_lockstep_components and the two
versions differ. Writes Chart.yaml and values.yaml, runs fix-helm-doc,
re-vendors the bumped sub-chart and runs fix-doc-consistency, which
writes the target version's docs (upgrade doc, values-deltas,
images-<target>.yaml, images-baseline.yaml).

Usage:
    update-component-version <component> <app-version> <chart-version>

Arguments:
    <component>       Chart.yaml dependency name or alias, or a native
                      component (defined in podiumd itself, e.g.
                      frankgateway)
    <app-version>     app image tag
    <chart-version>   Helm chart version, or "native" for a native
                      component

Examples:
    update-component-version zac 5.4.3 1.0.297
    update-component-version zgw-office-addin v0.9.352 0.0.92
    update-component-version frankgateway 104 native

Re-render the chart (verify-podiumd) before committing.
"""
# jscpd:ignore-end

import re
import sys

from dataclasses import dataclass
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.chart_yaml import ChartDependency
from lib.chart.chart_yaml import load_chart_dependencies
from lib.chart.paths import CHART_DIR
from lib.chart.paths import CHART_YAML
from lib.chart.paths import VALUES_YAML
from lib.chart.pull_and_subchart_resolution import check_image_versions
from lib.chart.pull_and_subchart_resolution import component_check_values
from lib.chart.pull_and_subchart_resolution import print_image_version_results
from lib.chart.pull_and_subchart_resolution import resolve_chart_values
from lib.chart.registered_paths import chart_version_lockstep_components
from lib.chart.registered_paths import image_paths_for
from lib.chart.registered_paths import is_native_chart_version
from lib.chart.registered_paths import resolve_native_component
from lib.chart.release_baseline_basics import chart_version as _chart_version
from lib.chart.values_tag_sha_lines import SiblingWrite
from lib.chart.values_tag_sha_lines import find_block_end
from lib.chart.values_tag_sha_lines import find_child_key_line
from lib.chart.values_tag_sha_lines import locate_dotted_key_line
from lib.chart.values_tag_sha_lines import locate_tag_and_sha
from lib.chart.values_tag_sha_lines import write_tag_and_sha
from lib.chart.values_tree_primitives import dotted_key_path
from lib.chart.values_tree_primitives import mapping_at
from lib.chart.values_tree_primitives import replace_scalar_value
from lib.chart.values_tree_primitives import require_dependency
from lib.chart.values_tree_primitives import text_at
from lib.chart.values_tree_primitives import values_key_of
from lib.chart.yaml_alias_groups import alias_groups
from lib.cli import network_errors
from lib.cli import positional_args
from lib.cli import print_section
from lib.component_docs.doc_updates import complete_docs_and_finish
from lib.dependencies import ensure_vendored_dependencies
from lib.image.version import PinUpdate
from lib.image.version import image_basename
from lib.image.version import plan_image_version_update
from lib.image.version import write_pin_updates
from lib.procutil import run_script
from lib.registry import ImagePathTagCheck
from lib.registry import parse_repo
from lib.registry import registry_tag_exists
from lib.settings import digest_pinning_exceptions
from lib.yaml_types import YamlMapping
from lib.yaml_types import load_yaml_mapping

FIX_HELM_DOC_SCRIPT = SCRIPT_DIR / "fix-helm-doc"


def find_dependency(name_or_alias: str):
    """Chart.yaml dependency by name or alias; exits if none."""
    return require_dependency(CHART_YAML, name_or_alias)


def _check_and_print_image_versions(values_for_check: YamlMapping, image_paths: list[str], app_version: str):
    """check_image_versions with FOUND/MISSING output; exits 1 if any is missing. Returns results by path."""
    image_results = check_image_versions(values_for_check, image_paths, app_version)
    if not print_image_version_results(image_results, app_version):
        print()
        print("FAIL: one or more app image versions do not exist yet — refusing to change any files")
        sys.exit(1)
    return {r["path"]: r for r in image_results}


def verify_component_version(
    dep: ChartDependency | None,
    image_paths: list[str],
    app_version: str,
    chart_version: str | None,
    component_values: YamlMapping | None = None,
):
    """Check the chart version and app image versions exist; exits 1 otherwise. Returns results by path.

    `dep is None` (native component) checks component_values directly.
    Otherwise podiumd's component_values are merged over the pulled chart's
    values, so an overridden "repository:" is the one checked.
    """
    if dep is None or chart_version is None:
        print(
            "No Chart.yaml dependency for this component — resolving image repositories "
            "directly from values.yaml (see lib.chart.native_components)"
        )
        print(f"\nChecking app version {app_version!r}:")
        return _check_and_print_image_versions(component_values or {}, image_paths, app_version)

    chart_name = dep["name"]
    print(f"=== Checking chart version {chart_version!r} for {chart_name} ===")
    upstream_values, source, error = resolve_chart_values(CHART_DIR, dep, chart_version)
    status = "FOUND  " if upstream_values is not None else "MISSING"
    suffix = f"  ({source})" if upstream_values is not None else f"  ({error})"
    print(f"  [{status}] {chart_name} {chart_version}{suffix}")
    if upstream_values is None:
        print()
        print("FAIL: chart version does not exist — refusing to change any files")
        sys.exit(1)

    values_for_check = component_check_values(upstream_values, component_values)
    print(f"\nChecking app version {app_version!r} for {values_key_of(dep)}:")
    return _check_and_print_image_versions(values_for_check, image_paths, app_version)


def update_chart_yaml(chart_name: str, new_chart_version: str):
    """Rewrite the dependency's "version:" line. Returns (old_line, new_line); SystemExit if not found."""
    lines = CHART_YAML.read_text(encoding="utf-8").splitlines(keepends=True)
    entry_re = re.compile(r"^(\s*)-\s*name:\s*(\S+)\s*$")
    block = None
    for i, line in enumerate(lines):
        m = entry_re.match(line)
        if m and m.group(2) == chart_name:
            block = (i, len(m.group(1)))
            break
    if block is None:
        msg = f"error: could not find '- name: {chart_name}' in {CHART_YAML}"
        raise SystemExit(msg)
    entry_line, entry_indent = block
    block_end = find_block_end(lines, entry_line, entry_indent)
    version_line = find_child_key_line(lines, "version", entry_indent, entry_line, block_end)
    if version_line is None:
        msg = f"error: could not find 'version:' under '- name: {chart_name}' in {CHART_YAML}"
        raise SystemExit(msg)

    old_line = lines[version_line]
    lines[version_line] = replace_scalar_value(old_line, new_chart_version)
    CHART_YAML.write_text("".join(lines), encoding="utf-8")
    return old_line.strip(), lines[version_line].strip()


def update_values_yaml(
    values_key: str, image_paths: list[str], new_tags_by_path: dict[str, str]
) -> list[tuple[str, str, str]]:
    """Rewrite each "<values_key>.<path>.tag" line. Returns (dotted_path, old_line, new_line) tuples."""
    lines = VALUES_YAML.read_text(encoding="utf-8").splitlines(keepends=True)
    changes: list[tuple[str, str, str]] = []
    for path in image_paths:
        dotted = f"{values_key}.{path}.tag"
        located = locate_dotted_key_line(lines, dotted)
        if located is None:
            msg = f"error: could not find '{dotted}' in {VALUES_YAML}"
            raise SystemExit(msg)
        line_idx, _ = located
        old_line = lines[line_idx]
        lines[line_idx] = replace_scalar_value(old_line, new_tags_by_path[path])
        changes.append((dotted, old_line.strip(), lines[line_idx].strip()))
    VALUES_YAML.write_text("".join(lines), encoding="utf-8")
    return changes


def current_chart_version():
    """Chart.yaml's current version."""
    return _chart_version(CHART_YAML)


@dataclass
class TargetVersions:
    """app_version/chart_version/new_chart, grouped for BumpContext."""

    app_version: str
    chart_version: str
    new_chart: str


@dataclass
class ComponentResolution:
    """no_chart/dep/chart_name/values_key, grouped for BumpContext."""

    no_chart: bool
    dep: ChartDependency | None
    chart_name: str
    values_key: str


def _group_getattr(groups: tuple[object, ...], name: str):
    """First `name` attribute found in `groups`; lets grouped dataclasses keep flat access."""
    for group in groups:
        if hasattr(group, name):
            return getattr(group, name)
    raise AttributeError(name)


@dataclass
class BumpContext:
    """Resolved inputs for every phase; grouped for too-many-instance-attributes."""

    versions: TargetVersions
    resolution: ComponentResolution
    deps: list[ChartDependency]
    values: YamlMapping
    image_paths: list[str]

    def __getattr__(self, name: str):
        return _group_getattr((self.versions, self.resolution), name)


@dataclass
class TagUpdatePlan:
    """paths_to_update split by tag-update strategy."""

    split_paths: list[str]
    delegated_paths: list[str]
    fallback_paths: list[str]


def _parse_cli_args():
    """(component, app_version, chart_version); exits on -h or a wrong argument count."""
    component, app_version, chart_version = positional_args(__doc__, 3)
    return component, app_version, chart_version


# Split "tag:" + sibling ("sha:"/"digest:") pins from settings.yaml
# digest_pinning.exceptions. Classified before the repository split: these
# paths also have a "repository:".
def _load_split_tag_sha_paths() -> dict[tuple[str, str], str]:
    """(values_key, path) -> sibling_field for writable exceptions with a sibling_field.

    Writable entries without one take the ordinary tag-update route.
    """
    return {
        (tuple_path[0], ".".join(tuple_path[1:])): entry["sibling_field"]
        for tuple_path, entry in digest_pinning_exceptions(CHART_DIR).items()
        if entry["writable"] and entry["sibling_field"] is not None
    }


def _resolve_bump_context(component: str, app_version: str, chart_version: str):
    """BumpContext for the arguments; exits if "native" is given for a non-native component."""
    # "-": the Helm chart cell of a chart-less row.
    no_chart = is_native_chart_version(chart_version)
    new_chart = "-" if no_chart else chart_version
    deps = load_chart_dependencies(CHART_YAML)
    values = load_yaml_mapping(VALUES_YAML)

    if no_chart:
        component = resolve_native_component(CHART_DIR, component)
        dep = None
        chart_name = component
        values_key = component
    else:
        dep = find_dependency(component)
        chart_name = dep["name"]
        values_key = values_key_of(dep)
    # Keyed by Chart.yaml name, not alias.
    image_paths = image_paths_for(chart_name, CHART_DIR)
    return BumpContext(
        TargetVersions(app_version, chart_version, new_chart),
        ComponentResolution(no_chart, dep, chart_name, values_key),
        deps,
        values,
        image_paths,
    )


def check_chart_version_lockstep(chart_name: str, app_version: str, chart_version: str, *, no_chart: bool) -> None:
    """Exit 1 before any write when a lockstep component's app and chart versions differ."""
    if no_chart or chart_name not in chart_version_lockstep_components(CHART_DIR):
        return
    if app_version != chart_version:
        print(
            f"FAIL: {chart_name} releases its chart and app image as the same version "
            f"(chart_version_lockstep_components), but app version {app_version} != "
            f"chart version {chart_version} — refusing to change any files"
        )
        sys.exit(1)


def _verify_versions(ctx: BumpContext):
    """Upfront version check. Returns (upstream_images, chart_unchanged)."""
    upstream_images = verify_component_version(
        None if ctx.no_chart else ctx.dep,
        ctx.image_paths,
        ctx.app_version,
        None if ctx.no_chart else ctx.chart_version,
        component_values=mapping_at(ctx.values, ctx.values_key),
    )

    print()
    chart_unchanged = True if ctx.no_chart else str(ctx.dep["version"]) == str(ctx.chart_version)
    if ctx.no_chart:
        print("No Chart.yaml dependency for this component — nothing to bump there")
    elif chart_unchanged:
        print(f"Chart version already {ctx.chart_version} — unchanged")
    else:
        print(f"Chart version: {ctx.dep['version']} -> {ctx.chart_version}")
    return upstream_images, chart_unchanged


def _compute_paths_to_update(ctx: BumpContext) -> list[str]:
    """The image paths needing a bump; prints a line per path."""
    paths_to_update: list[str] = []
    for path in ctx.image_paths:
        current_tag = text_at(ctx.values, f"{ctx.values_key}.{path}.tag") or ""
        current_version = current_tag.split("@", 1)[0]
        if current_version == ctx.app_version:
            print(f"{ctx.values_key}.{path}: app version already {ctx.app_version} — unchanged")
        else:
            print(f"{ctx.values_key}.{path}: app version {current_version or '(none)'} -> {ctx.app_version}")
            paths_to_update.append(path)
    return paths_to_update


def _classify_paths_to_update(
    ctx: BumpContext, paths_to_update: list[str], split_tag_sha_paths: dict[tuple[str, str], str]
) -> TagUpdatePlan:
    """Classify paths as split tag/sha pins, own "repository:", or sub-chart default."""
    split_paths: list[str] = []
    delegated_paths: list[str] = []
    fallback_paths: list[str] = []
    for path in paths_to_update:
        if (ctx.values_key, path) in split_tag_sha_paths:
            split_paths.append(path)
            continue
        explicit_repo = text_at(ctx.values, f"{ctx.values_key}.{path}.repository")
        (delegated_paths if isinstance(explicit_repo, str) and explicit_repo else fallback_paths).append(path)
    return TagUpdatePlan(split_paths, delegated_paths, fallback_paths)


def _write_split_tag_sha_pins(
    ctx: BumpContext, split_paths: list[str], split_tag_sha_paths: dict[tuple[str, str], str]
) -> None:
    """Write the split tag/sibling pin pairs for split_paths."""
    if not split_paths:
        return
    values_lines = VALUES_YAML.read_text(encoding="utf-8").splitlines(keepends=True)
    print_section(f"Writing split tag/sha pin(s) for {', '.join(f'{ctx.values_key}.{p}' for p in split_paths)}")
    for path in split_paths:
        _write_split_tag_sha_pin(ctx, values_lines, path, split_tag_sha_paths[(ctx.values_key, path)])
    VALUES_YAML.write_text("".join(values_lines), encoding="utf-8")


def _write_split_tag_sha_pin(ctx: BumpContext, values_lines: list[str], path: str, sibling_field: str):
    """Write one split pin pair into values_lines."""
    repo = text_at(ctx.values, f"{ctx.values_key}.{path}.repository")
    if not isinstance(repo, str) or not repo:
        msg = f"error: no repository found at {ctx.values_key}.{path}.repository in {VALUES_YAML}"
        raise SystemExit(msg)
    host, repo_path = parse_repo(repo)
    exists, digest = registry_tag_exists(host, repo_path, ctx.app_version)
    if not exists or not digest:
        msg = f"error: {host}/{repo_path}:{ctx.app_version} not found upstream"
        raise SystemExit(msg)
    digest_hex = digest.split("sha256:", 1)[1]
    located = locate_tag_and_sha(values_lines, ctx.values_key, path, sibling_field)
    if located is None:
        msg = f"error: could not find '{ctx.values_key}.{path}.tag' in {VALUES_YAML}"
        raise SystemExit(msg)
    write_tag_and_sha(
        values_lines, located, SiblingWrite(ctx.app_version, digest_hex, sibling_field, f"{ctx.values_key}.{path}")
    )
    sibling_idx = located[2]
    print(
        f"  {ctx.values_key}.{path}: {host}/{repo_path}:{ctx.app_version} -> sha256:{digest_hex}"
        f"{f'  (adding {sibling_field}: — no override yet)' if sibling_idx is None else ''}"
    )


@dataclass
class DelegatedUpdate:
    """The resolved, not yet written, pin updates of one basename's delegated paths."""

    basename: str
    paths: list[str]
    changes: list[PinUpdate]


def _delegated_paths_by_basename(ctx: BumpContext, delegated_paths: list[str]) -> dict[str, list[str]]:
    """Delegated paths grouped by their repository's basename."""
    by_basename: dict[str, list[str]] = {}
    for path in delegated_paths:
        repo = text_at(ctx.values, f"{ctx.values_key}.{path}.repository")
        if repo is None:
            msg = f"error: no repository found at {ctx.values_key}.{path}.repository in {VALUES_YAML}"
            raise SystemExit(msg)
        by_basename.setdefault(image_basename(repo), []).append(path)
    return by_basename


def _change_for_tag_path(
    tag_path: str, change_by_path: dict[str, PinUpdate], groups: dict[str, tuple[str, ...]]
) -> PinUpdate:
    """The change written at `tag_path` or at a path sharing its value; SystemExit if none."""
    for candidate in (tag_path, *groups.get(tag_path, ())):
        if candidate in change_by_path:
            return change_by_path[candidate]
    msg = (
        f"error: no pin to update for {tag_path}; is it already at the target "
        "version, or does another path share this basename?"
    )
    raise SystemExit(msg)


def _plan_delegated_tags(ctx: BumpContext, delegated_paths: list[str]) -> list[DelegatedUpdate]:
    """Resolve every delegated path's pins and digests, one call per basename, writing nothing.

    update_image_version bumps every pin of a basename under the key at once,
    so a second path with that basename, or a path whose tag is a YAML alias,
    has no change of its own: it is written through the path sharing its value.
    """
    values_lines = VALUES_YAML.read_text(encoding="utf-8").splitlines()
    groups = alias_groups(VALUES_YAML)
    updates: list[DelegatedUpdate] = []
    for basename, paths in _delegated_paths_by_basename(ctx, delegated_paths).items():
        changes = plan_image_version_update(VALUES_YAML, ctx.values_key, basename, ctx.app_version)
        change_by_path = {dotted_key_path(values_lines, c["line"] - 1): c for c in changes}
        for path in paths:
            _change_for_tag_path(f"{ctx.values_key}.{path}.tag", change_by_path, groups)
        updates.append(DelegatedUpdate(basename, paths, changes))
    return updates


def _write_delegated_tags(ctx: BumpContext, updates: list[DelegatedUpdate]) -> None:
    """Write the pin updates _plan_delegated_tags resolved."""
    for update in updates:
        print_section(
            f"Updating '{update.basename}' image pin(s) for {', '.join(f'{ctx.values_key}.{p}' for p in update.paths)}"
        )
        for c in update.changes:
            print(f"  values.yaml:{c['line']}  ({c['repository']})")
            print(f"    {c['old_version']}@{c['old_digest']}")
            print(f"    {c['new_version']}@{c['new_digest']}")
        write_pin_updates(VALUES_YAML, update.changes)


def _write_fallback_tags(
    ctx: BumpContext,
    fallback_paths: list[str],
    upstream_images: dict[str, ImagePathTagCheck],
) -> None:
    """Write the already-resolved sub-chart-default digests for fallback_paths."""
    if not fallback_paths:
        return
    print_section(f"Using sub-chart default digests for: {', '.join(fallback_paths)}")
    new_tags_by_path: dict[str, str] = {}
    for path in fallback_paths:
        r = upstream_images.get(path)
        if r is None or not r["exists"] or not r["digest"]:
            msg = f"error: no repository found at {path}.repository in {ctx.chart_name}'s own values.yaml"
            raise SystemExit(msg)
        new_tags_by_path[path] = f"{ctx.app_version}@{r['digest']}"
        print(f"  {ctx.values_key}.{path}: {r['host']}/{r['repo_path']}:{ctx.app_version} -> {r['digest']}")
    print_section(f"Writing {VALUES_YAML}")
    for dotted, old_v, new_v in update_values_yaml(ctx.values_key, fallback_paths, new_tags_by_path):
        print(f"  {dotted}:")
        print(f"    {old_v}")
        print(f"    {new_v}")


def _update_image_tags(
    ctx: BumpContext,
    paths_to_update: list[str],
    split_tag_sha_paths: dict[tuple[str, str], str],
    upstream_images: dict[str, ImagePathTagCheck],
) -> None:
    """Write every path's new tag."""
    if not paths_to_update:
        return
    plan = _classify_paths_to_update(ctx, paths_to_update, split_tag_sha_paths)
    # Resolve the delegated pins before writing anything, so an error leaves values.yaml untouched.
    delegated = _plan_delegated_tags(ctx, plan.delegated_paths)
    _write_split_tag_sha_pins(ctx, plan.split_paths, split_tag_sha_paths)
    _write_delegated_tags(ctx, delegated)
    _write_fallback_tags(ctx, plan.fallback_paths, upstream_images)


def _run_fix_helm_doc() -> None:
    """Run fix-helm-doc; SystemExit on failure."""
    print_section("Regenerating README.md (fix-helm-doc)")
    result = run_script([sys.executable, str(FIX_HELM_DOC_SCRIPT)])
    if result.returncode != 0:
        msg = f"error: fix-helm-doc failed (exit {result.returncode}); README.md was not regenerated"
        raise SystemExit(msg)


def main():
    """CLI entry point."""
    component, app_version, chart_version = _parse_cli_args()
    ensure_vendored_dependencies(CHART_DIR)
    split_tag_sha_paths = _load_split_tag_sha_paths()
    ctx = _resolve_bump_context(component, app_version, chart_version)
    check_chart_version_lockstep(ctx.chart_name, app_version, chart_version, no_chart=ctx.no_chart)

    upstream_images, chart_unchanged = _verify_versions(ctx)
    paths_to_update = _compute_paths_to_update(ctx)

    if chart_unchanged and not paths_to_update:
        # An earlier run may have written values.yaml/Chart.yaml and stopped before its docs.
        print()
        print("Component is already at the requested versions; completing docs.")

    _update_image_tags(ctx, paths_to_update, split_tag_sha_paths, upstream_images)

    if not chart_unchanged:
        print_section(f"Writing {CHART_YAML}")
        old_v, new_v = update_chart_yaml(ctx.chart_name, chart_version)
        print(f"  {old_v}  ->  {new_v}")

    _run_fix_helm_doc()

    print_section("Re-vendoring changed sub-charts")
    ensure_vendored_dependencies(CHART_DIR)

    # Writes the docs; last, as its render needs the re-vendored sub-charts.
    complete_docs_and_finish()


if __name__ == "__main__":
    with network_errors("container registry"):
        main()
