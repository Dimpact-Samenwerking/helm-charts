@dataclass
class TargetVersions:
    """app_version/chart_version/new_chart, grouped for BumpContext."""

    app_version: str
    chart_version: str
    new_chart: str


@dataclass
class ComponentResolution:
    """no_chart/dep/chart_name/values_key, grouped for BumpContext."""

    no_chart: bool
    dep: ChartDependency | None
    chart_name: str
    values_key: str


def _group_getattr(groups: tuple, name: str):
    """Look up `name` on each of `groups` in turn — shared __getattr__
    body below, so grouping fields into nested dataclasses (for too-many-
    instance-attributes) doesn't force ctx.app_version-style access to
    spell out which group it lives in."""
    for group in groups:
        if hasattr(group, name):
            return getattr(group, name)
    raise AttributeError(name)


@dataclass
class BumpContext:
    """Everything main() resolves up front, threaded through every phase
    below. versions/resolution are grouped into their own small
    dataclasses (too-many-instance-attributes; see _group_getattr)."""

    versions: TargetVersions
    resolution: ComponentResolution
    deps: list[ChartDependency]
    values: YamlMapping
    image_paths: list

    def __getattr__(self, name: str):
        return _group_getattr((self.versions, self.resolution), name)


@dataclass
class TagUpdatePlan:
    """paths_to_update split by tag-update strategy — see
    _classify_paths_to_update."""

    split_paths: list
    delegated_paths: list
    fallback_paths: list


@dataclass
class TagUpdateAccumulator:
    """new_tags_by_path/repos, built in place by whichever _write_*_tags
    helper runs — see _update_image_tags."""

    new_tags_by_path: dict
    repos: dict


@dataclass
class DocPaths:
    """Upgrade-path doc's resolved path pair, grouped for
    BaselineComparison."""

    upgrade_path: Path | None
    values_deltas_path: Path | None


@dataclass
class BaselineSnapshot:
    """Baseline's resolved git ref and, when resolvable, its Chart.yaml/
    values.yaml content — grouped for BaselineComparison."""

    upgrade_docs_baseline: str | None
    baseline_deps: list | None
    baseline_values: YamlMapping | None


@dataclass
class BaselineComparison:
    """Release upgrade_docs_baseline comparison result — see
    _resolve_baseline_comparison. Grouped into small dataclasses for
    too-many-instance-attributes (see _group_getattr)."""

    old_app: str | None
    old_chart: str | None
    reset_to_baseline: bool
    doc_paths: DocPaths
    snapshot: BaselineSnapshot

    def __getattr__(self, name: str):
        return _group_getattr((self.doc_paths, self.snapshot), name)


def _parse_cli_args():
    """-h/--help or a wrong argument count print the module docstring and
    exit; otherwise returns (component, app_version, chart_version) from
    sys.argv."""
    component, app_version, chart_version = positional_args(__doc__, 3)
    return component, app_version, chart_version


# (values_key, path) pairs using a split "tag:" + sibling field (e.g.
# "sha:"/"digest:") instead of the combined "tag: <version>@sha256:
# <digest>" pin — see settings.yaml's "digest_pinning.exceptions" (lib.
# settings.digest_pinning_exceptions) and _load_split_tag_sha_paths below.
# Checked BEFORE the explicit-repository/subchart-default split, since
# these paths DO have a "repository:" too.
def _load_split_tag_sha_paths():
    """digest_pinning.exceptions, filtered to writable: true entries and
    reshaped to (values_key, path) -> sibling_field (see the comment
    above)."""
    return {
        (tuple_path[0], ".".join(tuple_path[1:])): entry["sibling_field"]
        for tuple_path, entry in digest_pinning_exceptions(CHART_DIR).items()
        if entry["writable"]
    }


def _resolve_bump_context(component: str, app_version: str, chart_version: str):
    """Resolve a BumpContext: whether chart_version is "native" (a
    lib.chart.native_components component), and from that dep/chart_name/
    values_key/image_paths. Exits if "native" is passed for a component
    that isn't registered as one."""
    # "-" is the not-applicable Helm-chart cell placeholder for a chart-
    # less sidecar row (see lib.upgradedoc.component_version_cell).
    no_chart = is_native_chart_version(chart_version)
    new_chart = "-" if no_chart else chart_version
    deps = load_chart_dependencies(CHART_YAML)
    values = load_yaml_mapping(VALUES_YAML)

    if no_chart:
        component = resolve_native_component(CHART_DIR, component)
        dep = None
        chart_name = component
        values_key = component
    else:
        dep = find_dependency(component)
        chart_name = dep["name"]
        values_key = values_key_of(dep)
    # Keyed by the dependency's Chart.yaml "name", never its alias.
    image_paths = image_paths_for(chart_name, CHART_DIR)
    return BumpContext(
        TargetVersions(app_version, chart_version, new_chart),
        ComponentResolution(no_chart, dep, chart_name, values_key),
        deps,
        values,
        image_paths,
    )


def _verify_versions(ctx: BumpContext):
    """Run verify_component_version (the single upfront gate before any
    file is touched), then print the chart-version status line. Returns
    (upstream_images, chart_unchanged)."""
    if ctx.no_chart:
        component_values = ctx.values.get(ctx.values_key)
        upstream_images = verify_component_version(
            None,
            ctx.image_paths,
            ctx.app_version,
            None,
            component_values=component_values if isinstance(component_values, dict) else {},
        )
    else:
        upstream_images = verify_component_version(ctx.dep, ctx.image_paths, ctx.app_version, ctx.chart_version)

    print()
    chart_unchanged = True if ctx.no_chart else str(ctx.dep["version"]) == str(ctx.chart_version)
    if ctx.no_chart:
        print("No Chart.yaml dependency for this component — nothing to bump there")
    elif chart_unchanged:
        print(f"Chart version already {ctx.chart_version} — unchanged")
    else:
        print(f"Chart version: {ctx.dep['version']} -> {ctx.chart_version}")
    return upstream_images, chart_unchanged


def _compute_paths_to_update(ctx: BumpContext):
    """Per-path current app version vs. ctx.app_version, printing an
    unchanged/bump line for each. old_app_by_path keeps every path's
    prior version (even unchanged ones) for phases below."""
    paths_to_update = []
    old_app_by_path = {}
    for path in ctx.image_paths:
        current_tag = text_at(ctx.values, f"{ctx.values_key}.{path}.tag") or ""
        current_version = current_tag.split("@", 1)[0]
        old_app_by_path[path] = current_version or None
        if current_version == ctx.app_version:
            print(f"{ctx.values_key}.{path}: app version already {ctx.app_version} — unchanged")
        else:
            print(f"{ctx.values_key}.{path}: app version {current_version or '(none)'} -> {ctx.app_version}")
            paths_to_update.append(path)
    return paths_to_update, old_app_by_path


def _classify_paths_to_update(ctx: BumpContext, paths_to_update: list[str], split_tag_sha_paths: dict):
    """Split paths_to_update three ways: an explicit split tag/sha pin, a
    path with its own "repository:" (see _write_delegated_tags), or a
    sub-chart-default fallback (see _write_fallback_tags)."""
    split_paths, delegated_paths, fallback_paths = [], [], []
    for path in paths_to_update:
        if (ctx.values_key, path) in split_tag_sha_paths:
            split_paths.append(path)
            continue
        explicit_repo = text_at(ctx.values, f"{ctx.values_key}.{path}.repository")
        (delegated_paths if isinstance(explicit_repo, str) and explicit_repo else fallback_paths).append(path)
    return TagUpdatePlan(split_paths, delegated_paths, fallback_paths)


def _write_split_tag_sha_pins(
    ctx: BumpContext, split_paths: list, split_tag_sha_paths: dict, acc: TagUpdateAccumulator
):
    """Write the split "tag:"/"<sibling_field>:" pin pairs (see the comment
    above _load_split_tag_sha_paths and lib.chart.values_tag_sha_lines)
    for split_paths, updating acc.new_tags_by_path/acc.repos in place."""
    if not split_paths:
        return
    values_lines = VALUES_YAML.read_text(encoding="utf-8").splitlines(keepends=True)
    print()
    print(f"=== Writing split tag/sha pin(s) for {', '.join(f'{ctx.values_key}.{p}' for p in split_paths)} ===")
    for path in split_paths:
        _write_split_tag_sha_pin(ctx, values_lines, path, split_tag_sha_paths[(ctx.values_key, path)], acc)
    VALUES_YAML.write_text("".join(values_lines), encoding="utf-8")


def _write_split_tag_sha_pin(
    ctx: BumpContext, values_lines: list[str], path: str, sibling_field: str, acc: TagUpdateAccumulator
):
    """Write one split pin pair for path into values_lines (see
    _write_split_tag_sha_pins), updating acc in place."""
    repo = text_at(ctx.values, f"{ctx.values_key}.{path}.repository")
    if not isinstance(repo, str) or not repo:
        msg = f"error: no repository found at {ctx.values_key}.{path}.repository in {VALUES_YAML}"
        raise SystemExit(msg)
    acc.repos[path] = repo
    host, repo_path = parse_repo(repo)
    exists, digest = registry_tag_exists(host, repo_path, ctx.app_version)
    if not exists or not digest:
        msg = f"error: {host}/{repo_path}:{ctx.app_version} not found upstream"
        raise SystemExit(msg)
    digest_hex = digest.split("sha256:", 1)[1]
    located = locate_tag_and_sha(values_lines, ctx.values_key, path, sibling_field)
    if located is None:
        msg = f"error: could not find '{ctx.values_key}.{path}.tag' in {VALUES_YAML}"
        raise SystemExit(msg)
    write_tag_and_sha(
        values_lines, located, SiblingWrite(ctx.app_version, digest_hex, sibling_field, f"{ctx.values_key}.{path}")
    )
    acc.new_tags_by_path[path] = f"{ctx.app_version}@sha256:{digest_hex}"
    sibling_idx = located[2]
    print(
        f"  {ctx.values_key}.{path}: {host}/{repo_path}:{ctx.app_version} -> sha256:{digest_hex}"
        f"{f'  (adding {sibling_field}: — no override yet)' if sibling_idx is None else ''}"
    )


def _write_delegated_tags(ctx: BumpContext, delegated_paths: list, acc: TagUpdateAccumulator):
    """Delegate delegated_paths to lib.image.version.update_image_version,
    keyed by each path's own real repository basename (not necessarily
    this component's own name) so a shared image is updated everywhere
    it's pinned. Updates acc.new_tags_by_path/acc.repos in place."""
    if not delegated_paths:
        return
    values_lines = VALUES_YAML.read_text(encoding="utf-8").splitlines()
    for path in delegated_paths:
        located = locate_dotted_key_line(values_lines, f"{ctx.values_key}.{path}.tag")
        if located is None:
            msg = f"error: could not find '{ctx.values_key}.{path}.tag' in {VALUES_YAML}"
            raise SystemExit(msg)
        own_line = located[0] + 1  # 1-indexed, matches lib.image.version's line numbering
        acc.repos[path] = text_at(ctx.values, f"{ctx.values_key}.{path}.repository")
        basename = image_basename(acc.repos[path])
        print()
        print(f"=== Updating '{basename}' image pin(s) for {ctx.values_key}.{path} ===")
        changes = update_image_version(VALUES_YAML, ctx.values_key, basename, ctx.app_version)
        for c in changes:
            print(f"  values.yaml:{c['line']}  ({c['repository']})")
            print(f"    {c['old_version']}@{c['old_digest']}")
            print(f"    {c['new_version']}@{c['new_digest']}")
        own_change = next(c for c in changes if c["line"] == own_line)
        acc.new_tags_by_path[path] = f"{own_change['new_version']}@{own_change['new_digest']}"


def _write_fallback_tags(ctx: BumpContext, fallback_paths: list, upstream_images: dict, acc: TagUpdateAccumulator):
    """For fallback_paths (sub-chart default repository), write the digest
    upstream_images already resolved straight into values.yaml. Updates
    acc.new_tags_by_path/acc.repos in place."""
    if not fallback_paths:
        return
    print()
    print(f"=== Using sub-chart default digests for: {', '.join(fallback_paths)} ===")
    for path in fallback_paths:
        r = upstream_images.get(path)
        if r is None or not r["exists"] or not r["digest"]:
            msg = f"error: no repository found at {path}.repository in {ctx.chart_name}'s own values.yaml"
            raise SystemExit(msg)
        acc.repos[path] = r["repository"]
        acc.new_tags_by_path[path] = f"{ctx.app_version}@{r['digest']}"
        print(f"  {ctx.values_key}.{path}: {r['host']}/{r['repo_path']}:{ctx.app_version} -> {r['digest']}")
    print()
    print(f"=== Writing {VALUES_YAML} ===")
    for dotted, old_v, new_v in update_values_yaml(ctx.values_key, fallback_paths, acc.new_tags_by_path):
        print(f"  {dotted}:")
        print(f"    {old_v}")
        print(f"    {new_v}")


def _update_image_tags(ctx: BumpContext, paths_to_update: list, split_tag_sha_paths: dict, upstream_images: dict):
    """Dispatch paths_to_update to whichever of the three tag-update
    strategies each one needs (see _classify_paths_to_update), writing
    values.yaml as needed. Returns (new_tags_by_path, repos)."""
    acc = TagUpdateAccumulator({}, {})
    if not paths_to_update:
        return acc.new_tags_by_path, acc.repos
    plan = _classify_paths_to_update(ctx, paths_to_update, split_tag_sha_paths)
    _write_split_tag_sha_pins(ctx, plan.split_paths, split_tag_sha_paths, acc)
    _write_delegated_tags(ctx, plan.delegated_paths, acc)
    _write_fallback_tags(ctx, plan.fallback_paths, upstream_images, acc)
    return acc.new_tags_by_path, acc.repos


def _resolve_against_baseline(
    ctx: BumpContext, baseline_deps: list[ChartDependency], baseline_values: YamlMapping | None, friendly: str
):
    """When baseline_deps resolved to a real git ref: whether `friendly` is
    back at its baseline version, and old_app/old_chart resolved against
    it (see resolve_baseline_component_versions). Returns (old_app,
    old_chart, reset_to_baseline)."""
    current_deps = load_chart_dependencies(CHART_YAML)
    current_values = load_yaml_mapping(VALUES_YAML)
    changed_keys = compute_changed_components(current_deps, baseline_deps, current_values, baseline_values)
    reset_to_baseline = friendly not in changed_keys

    baseline_dep = None if ctx.no_chart else dep_for_values_key(baseline_deps, ctx.values_key)
    old_app, old_chart = resolve_baseline_component_versions(
        BaselineComponentQuery(
            baseline_values,
            baseline_dep,
            ctx.values_key,
            ctx.image_paths[0],
            ctx.chart_name,
            ctx.new_chart,
            chart_dir=CHART_DIR,
        )
    )
    if ctx.no_chart:
        old_chart = None  # native_components: never a chart version to show at all
    # old_app still None here: the source is strictly the git-baseline read
    # above, never images-baseline.yaml (only tracks ACR-mirror digests).
    return old_app, old_chart, reset_to_baseline


def _resolve_baseline_comparison(ctx: BumpContext, target: str, old_app_by_path: dict):
    """Compare against the TRUE release upgrade_docs_baseline (git-
    resolved), not "whatever this script last left on disk" — the only
    way a component bumped more than once in one cycle still documents as
    ONE baseline -> final transition. Returns a BaselineComparison."""
    friendly = ctx.values_key
    # Fallback "old" values when upgrade_docs_baseline can't be resolved.
    old_chart = None if ctx.no_chart else str(ctx.dep["version"])
    old_app = old_app_by_path.get(ctx.image_paths[0])

    upgrade_docs_baseline = _read_upgrade_docs_baseline(CHART_DIR)
    upgrade_path, values_deltas_path = baseline_doc_paths(upgrade_docs_baseline, target)

    baseline_deps = baseline_values = None
    if upgrade_docs_baseline is not None:
        baseline_deps, baseline_values = load_baseline_state(upgrade_docs_baseline)
    reset_to_baseline = False
    if baseline_deps is not None:
        old_app, old_chart, reset_to_baseline = _resolve_against_baseline(ctx, baseline_deps, baseline_values, friendly)

    return BaselineComparison(
        old_app,
        old_chart,
        reset_to_baseline,
        DocPaths(upgrade_path, values_deltas_path),
        BaselineSnapshot(upgrade_docs_baseline, baseline_deps, baseline_values),
    )


def _update_upgrade_doc_section(ctx: BumpContext, comparison: BaselineComparison, target: str, paths_to_update: list):
    """Rewrite (or explain skipping) the upgrade-path doc's Component-
    versions table row and Changes section for this component."""
    friendly = ctx.values_key
    if comparison.upgrade_path is None:
        print_missing_upgrade_doc(comparison.upgrade_docs_baseline, target)
        return

    ordering = OrderingContext(ctx.deps, ctx.values)
    if comparison.reset_to_baseline:
        reset_upgrade_doc(comparison.upgrade_path, friendly, ordering, comparison.upgrade_docs_baseline)
        return

    change = VersionChange(comparison.old_app, ctx.app_version, comparison.old_chart, ctx.new_chart)
    identity = ComponentIdentity(friendly, ctx.chart_name, ctx.values_key)
    section = make_changes_section(identity, target, change, paths_to_update)
    rewrite_upgrade_doc(comparison.upgrade_path, friendly, change, section, ordering)


def _update_values_deltas_change(
    ctx: BumpContext, comparison: BaselineComparison, friendly: str, text: str, *, section_removed: bool
):
    """Non-reset branch of _update_values_deltas_section: describes
    added/removed/renamed values.yaml keys for this component since its
    baseline, writing a section if any."""
    current_values_after = load_yaml_mapping(VALUES_YAML)
    current_subtree = current_values_after.get(ctx.values_key, {})
    baseline_values_at_release = (
        comparison.baseline_values
        if comparison.baseline_deps is not None
        else load_baseline_values(comparison.upgrade_docs_baseline)
    )
    key_lines = []
    no_baseline_ref = baseline_values_at_release is None
    if not no_baseline_ref:
        baseline_subtree = (
            baseline_values_at_release.get(ctx.values_key, {}) if isinstance(baseline_values_at_release, dict) else {}
        )
        key_lines = describe_key_changes(ctx.values_key, baseline_subtree, current_subtree)

    # A pure version bump with no values-schema change needs no section at
    # all -- a heading with nothing under it is worse than no heading, and
    # -upgrade.md's own table + Changes section already covers it.
    if key_lines:
        heading_line = values_delta_section_heading(
            friendly, comparison.old_app, ctx.app_version, comparison.old_chart, ctx.new_chart
        )
        write_values_delta_entry(
            comparison.values_deltas_path,
            text,
            ValuesDeltaEntry(friendly, heading_line, key_lines),
            ValuesDeltaOrdering(ctx.deps, ctx.values),
        )
    elif section_removed:
        write_removed_values_delta_section(comparison.values_deltas_path, text, friendly)
    if no_baseline_ref:
        print()
        print(
            f"  note: could not resolve upgrade_docs_baseline {comparison.upgrade_docs_baseline} to a git ref — "
            f"skipping added/removed/renamed key detection for values-deltas.md"
        )


def _update_values_deltas_section(ctx: BumpContext, comparison: BaselineComparison):
    """Rewrite (or explain skipping) the values-deltas doc's section for
    this component."""
    friendly = ctx.values_key
    if comparison.values_deltas_path is None:
        if comparison.upgrade_path is not None:
            print()
            print(
                f"No values-deltas.md found for upgrade_docs_baseline {comparison.upgrade_docs_baseline} — "
                "skipping that update."
            )
        return

    text = comparison.values_deltas_path.read_text(encoding="utf-8")
    text, section_removed = remove_values_delta_section(text, friendly, ctx.deps)
    if not comparison.reset_to_baseline:
        _update_values_deltas_change(ctx, comparison, friendly, text, section_removed=section_removed)
        return
    comparison.values_deltas_path.write_text(text, encoding="utf-8")
    print()
    print(f"=== Updating {comparison.values_deltas_path.name} ===")
    print(
        f"  {friendly} is back at its upgrade_docs_baseline {comparison.upgrade_docs_baseline} version — "
        f"{'removed its section' if section_removed else 'nothing to remove'}"
    )


def _remove_images_manifest_entries(
    comparison: BaselineComparison, manifest_target: ManifestUpdateTarget, path_update: ImagePathUpdate
):
    """images-manifest write when this component is back at its baseline —
    see _update_images_manifest_section's reset_to_baseline branch."""
    changes_action, entry_updates = remove_component_from_images_manifest(manifest_target, path_update)
    print()
    print(f"=== Updating {manifest_target.images_path.name} ===")
    if changes_action:
        print(
            f"  {manifest_target.friendly} is back at its upgrade_docs_baseline "
            f"{comparison.upgrade_docs_baseline} version — removed 'changes:' list entry"
        )
    for name in entry_updates:
        print(f"  updated entry '{name}' (now matches upgrade_docs_baseline — no longer a documented change)")


def _write_images_manifest_updates(
    ctx: BumpContext,
    comparison: BaselineComparison,
    manifest_target: ManifestUpdateTarget,
    path_update: ImagePathUpdate,
):
    """images-manifest write for a genuine version change — see
    _update_images_manifest_section's non-reset branch."""
    change = VersionChange(comparison.old_app, ctx.app_version, comparison.old_chart, ctx.new_chart)
    # A missing entry is added by the fix-doc-consistency run at the end of main().
    changes_action, entry_updates, _missing_entries = update_images_manifest(
        manifest_target, change, path_update, ctx.deps, ctx.values
    )
    print()
    print(f"=== Updating {manifest_target.images_path.name} ===")
    if changes_action:
        print(f"  {changes_action} 'changes:' list entry")
    for name in entry_updates:
        print(f"  updated entry '{name}'")


def _update_images_manifest_section(
    ctx: BumpContext, comparison: BaselineComparison, paths_to_update: list, tags: tuple
):
    """Rewrite (or explain skipping) docs/images/images-<target>.yaml's
    entries and 'changes:' list for this component. `tags` is the
    (new_tags_by_path, repos) pair _update_image_tags returned."""
    if not paths_to_update:
        return
    new_tags_by_path, repos = tags
    target = current_chart_version()
    images_path = images_manifest_path(target)
    if not images_path.is_file():
        print()
        print(f"No images-{target}.yaml found — skipping that update.")
        return

    manifest_target = ManifestUpdateTarget(images_path, ctx.values_key, ctx.values_key)
    path_update = ImagePathUpdate(paths_to_update, repos, new_tags_by_path)
    if comparison.reset_to_baseline:
        _remove_images_manifest_entries(comparison, manifest_target, path_update)
    else:
        _write_images_manifest_updates(ctx, comparison, manifest_target, path_update)


def main():
    """CLI entry point: verifies requested versions exist upstream before
    writing anything, then updates Chart.yaml/values.yaml, refreshes the
    docs, re-vendors the bumped sub-chart and runs fix-doc-consistency.
    See the module docstring for the full argument
    contract."""
    component, app_version, chart_version = _parse_cli_args()
    ensure_vendored_dependencies(CHART_DIR)
    split_tag_sha_paths = _load_split_tag_sha_paths()
    ctx = _resolve_bump_context(component, app_version, chart_version)

    upstream_images, chart_unchanged = _verify_versions(ctx)
    paths_to_update, old_app_by_path = _compute_paths_to_update(ctx)

    if chart_unchanged and not paths_to_update:
        print()
        print("Nothing to update — component is already at the requested versions.")
        sys.exit(0)

    new_tags_by_path, repos = _update_image_tags(ctx, paths_to_update, split_tag_sha_paths, upstream_images)

    if not chart_unchanged:
        print()
        print(f"=== Writing {CHART_YAML} ===")
        old_v, new_v = update_chart_yaml(ctx.chart_name, chart_version)
        print(f"  {old_v}  ->  {new_v}")

    target = current_chart_version()
    comparison = _resolve_baseline_comparison(ctx, target, old_app_by_path)

    _update_upgrade_doc_section(ctx, comparison, target, paths_to_update)
    _update_values_deltas_section(ctx, comparison)
    _update_images_manifest_section(ctx, comparison, paths_to_update, (new_tags_by_path, repos))

    print()
    print("=== Regenerating README.md (fix-helm-doc) ===")
    run_script([sys.executable, str(FIX_HELM_DOC_SCRIPT)])

    # The doc steps above only read a vendored .tgz whose version didn't change.
    print()
    print("=== Re-vendoring changed sub-charts ===")
    ensure_vendored_dependencies(CHART_DIR)

    # Last: fix-doc-consistency completes the docs the steps above wrote
    # (missing images-manifest entries, order, images-baseline.yaml) the
    # same way check_docs_consistency expects them. Its render needs the
    # re-vendored sub-charts.
    complete_docs_and_finish()


if __name__ == "__main__":
    main()
