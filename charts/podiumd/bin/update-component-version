#!/usr/bin/env python3
"""
Bump a component's app image version and Helm chart version.

Checks both versions exist upstream before writing anything; a version
already at the requested value is left as is. Writes Chart.yaml and
values.yaml, updates the docs for the current target version (upgrade
doc, values-deltas, images-<target>.yaml), runs fix-helm-doc, re-vendors
the bumped sub-chart and runs fix-doc-consistency, which also regenerates
images-baseline.yaml.

Usage:
    update-component-version <component> <app-version> <chart-version>

Arguments:
    <component>       component name or alias
    <app-version>     new app image version
    <chart-version>   new Helm chart version, or "native" for a component
                      without a Chart.yaml dependency (e.g. frankgateway)

Examples:
    update-component-version zac 5.4.3 1.0.297
    update-component-version zgw-office-addin v0.9.352 0.0.92
    update-component-version frankgateway 104 native

Re-render the chart (verify-podiumd) before committing.
"""

import re
import sys

from dataclasses import dataclass
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# Not installed as a package -- sys.path must be patched before
