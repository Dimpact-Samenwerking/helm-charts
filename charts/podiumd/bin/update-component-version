FIX_HELM_DOC_SCRIPT = SCRIPT_DIR / "fix-helm-doc"


def find_dependency(name_or_alias: str):
    """Chart.yaml dependency matching name_or_alias (name or alias — see
    lib.chart.values_tree_primitives.find_dependency); exits instead of
    returning None."""
    return require_dependency(CHART_YAML, name_or_alias)


def _check_and_print_image_versions(values_for_check: YamlMapping, image_paths: list[str], app_version: str):
    """check_image_versions, printing a FOUND/MISSING line per path and
    exiting 1 if any don't exist upstream. Returns results keyed by path
    — shared by both verify_component_version branches below."""
    image_results = check_image_versions(values_for_check, image_paths, app_version)
    if not print_image_version_results(image_results, app_version):
        print()
        print("FAIL: one or more app image versions do not exist yet — refusing to change any files")
        sys.exit(1)
    return {r["path"]: r for r in image_results}


def verify_component_version(
    dep: ChartDependency | None,
    image_paths: list[str],
    app_version: str,
    chart_version: str | None,
    component_values: YamlMapping | None = None,
):
    """Resolve chart_version's own values.yaml and check image_paths
    resolve to existing app image versions upstream — the single upfront
    gate before any file is touched. Returns results keyed by path; exits
    1 if the chart version or an image version doesn't exist. `dep is
    None` means native_components — component_values is checked directly
    instead of pulling a chart."""
    if dep is None or chart_version is None:
        print(
            "No Chart.yaml dependency for this component — resolving image repositories "
            "directly from values.yaml (see lib.chart.native_components)"
        )
        print(f"\nChecking app version {app_version!r}:")
        return _check_and_print_image_versions(component_values or {}, image_paths, app_version)

    chart_name = dep["name"]
    print(f"=== Checking chart version {chart_version!r} for {chart_name} ===")
    upstream_values, source, error = resolve_chart_values(CHART_DIR, dep, chart_version)
    status = "FOUND  " if upstream_values is not None else "MISSING"
    suffix = f"  ({source})" if upstream_values is not None else f"  ({error})"
    print(f"  [{status}] {chart_name} {chart_version}{suffix}")
    if upstream_values is None:
        print()
        print("FAIL: chart version does not exist — refusing to change any files")
        sys.exit(1)

    print(f"\nChecking app version {app_version!r} for {values_key_of(dep)}:")
    return _check_and_print_image_versions(upstream_values, image_paths, app_version)


def update_chart_yaml(chart_name: str, new_chart_version: str):
    """Rewrite the "version:" line under Chart.yaml's "- name: chart_name"
    dependency entry. Returns (old_line, new_line), each stripped; raises
    SystemExit if the entry or its version line can't be found."""
    lines = CHART_YAML.read_text(encoding="utf-8").splitlines(keepends=True)
    entry_re = re.compile(r"^(\s*)-\s*name:\s*(\S+)\s*$")
    block = None
    for i, line in enumerate(lines):
        m = entry_re.match(line)
        if m and m.group(2) == chart_name:
            block = (i, len(m.group(1)))
            break
    if block is None:
        msg = f"error: could not find '- name: {chart_name}' in {CHART_YAML}"
        raise SystemExit(msg)
    entry_line, entry_indent = block
    block_end = find_block_end(lines, entry_line, entry_indent)
    version_line = find_child_key_line(lines, "version", entry_indent, entry_line, block_end)
    if version_line is None:
        msg = f"error: could not find 'version:' under '- name: {chart_name}' in {CHART_YAML}"
        raise SystemExit(msg)

    old_line = lines[version_line]
    lines[version_line] = replace_scalar_value(old_line, new_chart_version)
    CHART_YAML.write_text("".join(lines), encoding="utf-8")
    return old_line.strip(), lines[version_line].strip()


def update_values_yaml(values_key: str, image_paths: list[str], new_tags_by_path: dict):
    """Rewrite each "<values_key>.<path>.tag" line to new_tags_by_path[
    path]. Returns (dotted_path, old_line, new_line) tuples, each
    stripped; raises SystemExit if any dotted path can't be found."""
    lines = VALUES_YAML.read_text(encoding="utf-8").splitlines(keepends=True)
    changes = []
    for path in image_paths:
        dotted = f"{values_key}.{path}.tag"
        located = locate_dotted_key_line(lines, dotted)
        if located is None:
            msg = f"error: could not find '{dotted}' in {VALUES_YAML}"
            raise SystemExit(msg)
        line_idx, _ = located
        old_line = lines[line_idx]
        lines[line_idx] = replace_scalar_value(old_line, new_tags_by_path[path])
        changes.append((dotted, old_line.strip(), lines[line_idx].strip()))
    VALUES_YAML.write_text("".join(lines), encoding="utf-8")
    return changes


def current_chart_version():
    """The podiumd chart's own currently-pinned version, read from
    Chart.yaml via lib.chart.release_baseline_basics.chart_version."""
    return _chart_version(CHART_YAML)


