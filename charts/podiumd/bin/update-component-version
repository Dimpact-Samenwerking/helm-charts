@dataclass
class TargetVersions:
    """app_version/chart_version/new_chart, grouped for BumpContext."""

    app_version: str
    chart_version: str
    new_chart: str


@dataclass
class ComponentResolution:
    """no_chart/dep/chart_name/values_key, grouped for BumpContext."""

    no_chart: bool
    dep: ChartDependency | None
    chart_name: str
    values_key: str


def _group_getattr(groups: tuple[object, ...], name: str):
    """First `name` attribute found in `groups`; lets grouped dataclasses keep flat access."""
    for group in groups:
        if hasattr(group, name):
            return getattr(group, name)
    raise AttributeError(name)


@dataclass
class BumpContext:
    """Resolved inputs for every phase; grouped for too-many-instance-attributes."""

    versions: TargetVersions
    resolution: ComponentResolution
    deps: list[ChartDependency]
    values: YamlMapping
    image_paths: list[str]

    def __getattr__(self, name: str):
        return _group_getattr((self.versions, self.resolution), name)


@dataclass
class TagUpdatePlan:
    """paths_to_update split by tag-update strategy."""

    split_paths: list[str]
    delegated_paths: list[str]
    fallback_paths: list[str]


@dataclass
class TagUpdateAccumulator:
    """Filled in place by the _write_*_tags helpers."""

    new_tags_by_path: dict[str, str]
    repos: dict[str, str]


@dataclass
class DocPaths:
    """Upgrade and values-deltas doc paths."""

    upgrade_path: Path | None
    values_deltas_path: Path | None


@dataclass
class BaselineSnapshot:
    """Baseline version and, when resolvable, its Chart.yaml/values.yaml."""

    upgrade_docs_baseline: str | None
    baseline_deps: list[ChartDependency] | None
    baseline_values: YamlMapping | None


@dataclass
class BaselineComparison:
    """Result of _resolve_baseline_comparison."""

    old_app: str | None
    old_chart: str | None
    reset_to_baseline: bool
    doc_paths: DocPaths
    snapshot: BaselineSnapshot

    def __getattr__(self, name: str):
        return _group_getattr((self.doc_paths, self.snapshot), name)


def _parse_cli_args():
    """(component, app_version, chart_version); exits on -h or a wrong argument count."""
    component, app_version, chart_version = positional_args(__doc__, 3)
    return component, app_version, chart_version


# Split "tag:" + sibling ("sha:"/"digest:") pins from settings.yaml
# digest_pinning.exceptions. Classified before the repository split: these
# paths also have a "repository:".
def _load_split_tag_sha_paths() -> dict[tuple[str, str], str]:
    """(values_key, path) -> sibling_field for writable exceptions with a sibling_field.

    Writable entries without one take the ordinary tag-update route.
    """
    return {
        (tuple_path[0], ".".join(tuple_path[1:])): entry["sibling_field"]
        for tuple_path, entry in digest_pinning_exceptions(CHART_DIR).items()
        if entry["writable"] and entry["sibling_field"] is not None
    }


def _resolve_bump_context(component: str, app_version: str, chart_version: str):
    """BumpContext for the arguments; exits if "native" is given for a non-native component."""
    # "-": the Helm chart cell of a chart-less row.
    no_chart = is_native_chart_version(chart_version)
    new_chart = "-" if no_chart else chart_version
    deps = load_chart_dependencies(CHART_YAML)
    values = load_yaml_mapping(VALUES_YAML)

    if no_chart:
        component = resolve_native_component(CHART_DIR, component)
        dep = None
        chart_name = component
        values_key = component
    else:
        dep = find_dependency(component)
        chart_name = dep["name"]
        values_key = values_key_of(dep)
    # Keyed by Chart.yaml name, not alias.
    image_paths = image_paths_for(chart_name, CHART_DIR)
    return BumpContext(
        TargetVersions(app_version, chart_version, new_chart),
        ComponentResolution(no_chart, dep, chart_name, values_key),
        deps,
        values,
        image_paths,
    )


def check_chart_version_lockstep(chart_name: str, app_version: str, chart_version: str, *, no_chart: bool) -> None:
    """Exit 1 before any write when a lockstep component's app and chart versions differ."""
    if no_chart or chart_name not in chart_version_lockstep_components(CHART_DIR):
        return
    if app_version != chart_version:
        print(
            f"FAIL: {chart_name} releases its chart and app image as the same version "
            f"(chart_version_lockstep_components), but app version {app_version} != "
            f"chart version {chart_version} — refusing to change any files"
        )
        sys.exit(1)


def _verify_versions(ctx: BumpContext):
    """Upfront version check. Returns (upstream_images, chart_unchanged)."""
    upstream_images = verify_component_version(
        None if ctx.no_chart else ctx.dep,
        ctx.image_paths,
        ctx.app_version,
        None if ctx.no_chart else ctx.chart_version,
        component_values=mapping_at(ctx.values, ctx.values_key),
    )

    print()
    chart_unchanged = True if ctx.no_chart else str(ctx.dep["version"]) == str(ctx.chart_version)
    if ctx.no_chart:
        print("No Chart.yaml dependency for this component — nothing to bump there")
    elif chart_unchanged:
        print(f"Chart version already {ctx.chart_version} — unchanged")
    else:
        print(f"Chart version: {ctx.dep['version']} -> {ctx.chart_version}")
    return upstream_images, chart_unchanged


def _compute_paths_to_update(ctx: BumpContext) -> tuple[list[str], dict[str, str | None]]:
    """(paths needing a bump, every path's current version); prints a line per path."""
    paths_to_update: list[str] = []
    old_app_by_path: dict[str, str | None] = {}
    for path in ctx.image_paths:
        current_tag = text_at(ctx.values, f"{ctx.values_key}.{path}.tag") or ""
        current_version = current_tag.split("@", 1)[0]
        old_app_by_path[path] = current_version or None
        if current_version == ctx.app_version:
            print(f"{ctx.values_key}.{path}: app version already {ctx.app_version} — unchanged")
        else:
            print(f"{ctx.values_key}.{path}: app version {current_version or '(none)'} -> {ctx.app_version}")
            paths_to_update.append(path)
    return paths_to_update, old_app_by_path


def _classify_paths_to_update(
    ctx: BumpContext, paths_to_update: list[str], split_tag_sha_paths: dict[tuple[str, str], str]
) -> TagUpdatePlan:
    """Classify paths as split tag/sha pins, own "repository:", or sub-chart default."""
    split_paths: list[str] = []
    delegated_paths: list[str] = []
    fallback_paths: list[str] = []
    for path in paths_to_update:
        if (ctx.values_key, path) in split_tag_sha_paths:
            split_paths.append(path)
            continue
        explicit_repo = text_at(ctx.values, f"{ctx.values_key}.{path}.repository")
        (delegated_paths if isinstance(explicit_repo, str) and explicit_repo else fallback_paths).append(path)
    return TagUpdatePlan(split_paths, delegated_paths, fallback_paths)


def _write_split_tag_sha_pins(
    ctx: BumpContext, split_paths: list[str], split_tag_sha_paths: dict[tuple[str, str], str], acc: TagUpdateAccumulator
) -> None:
    """Write the split tag/sibling pin pairs for split_paths."""
    if not split_paths:
        return
    values_lines = VALUES_YAML.read_text(encoding="utf-8").splitlines(keepends=True)
    print_section(f"Writing split tag/sha pin(s) for {', '.join(f'{ctx.values_key}.{p}' for p in split_paths)}")
    for path in split_paths:
        _write_split_tag_sha_pin(ctx, values_lines, path, split_tag_sha_paths[(ctx.values_key, path)], acc)
    VALUES_YAML.write_text("".join(values_lines), encoding="utf-8")


def _write_split_tag_sha_pin(
    ctx: BumpContext, values_lines: list[str], path: str, sibling_field: str, acc: TagUpdateAccumulator
):
    """Write one split pin pair into values_lines."""
    repo = text_at(ctx.values, f"{ctx.values_key}.{path}.repository")
    if not isinstance(repo, str) or not repo:
        msg = f"error: no repository found at {ctx.values_key}.{path}.repository in {VALUES_YAML}"
        raise SystemExit(msg)
    acc.repos[path] = repo
    host, repo_path = parse_repo(repo)
    exists, digest = registry_tag_exists(host, repo_path, ctx.app_version)
    if not exists or not digest:
        msg = f"error: {host}/{repo_path}:{ctx.app_version} not found upstream"
        raise SystemExit(msg)
    digest_hex = digest.split("sha256:", 1)[1]
    located = locate_tag_and_sha(values_lines, ctx.values_key, path, sibling_field)
    if located is None:
        msg = f"error: could not find '{ctx.values_key}.{path}.tag' in {VALUES_YAML}"
        raise SystemExit(msg)
    tag_written = write_tag_and_sha(
        values_lines, located, SiblingWrite(ctx.app_version, digest_hex, sibling_field, f"{ctx.values_key}.{path}")
    )
    if tag_written:
        acc.new_tags_by_path[path] = f"{ctx.app_version}@sha256:{digest_hex}"
    sibling_idx = located[2]
    print(
        f"  {ctx.values_key}.{path}: {host}/{repo_path}:{ctx.app_version} -> sha256:{digest_hex}"
        f"{f'  (adding {sibling_field}: — no override yet)' if sibling_idx is None else ''}"
    )


@dataclass
class DelegatedUpdate:
    """The resolved, not yet written, pin updates of one basename's delegated paths."""

    basename: str
    paths: list[str]
    changes: list[PinUpdate]


def _delegated_paths_by_basename(
    ctx: BumpContext, delegated_paths: list[str], acc: TagUpdateAccumulator
) -> dict[str, list[str]]:
    """Delegated paths grouped by their repository's basename; records each repository in `acc`."""
    by_basename: dict[str, list[str]] = {}
    for path in delegated_paths:
        repo = text_at(ctx.values, f"{ctx.values_key}.{path}.repository")
        if repo is None:
            msg = f"error: no repository found at {ctx.values_key}.{path}.repository in {VALUES_YAML}"
            raise SystemExit(msg)
        acc.repos[path] = repo
        by_basename.setdefault(image_basename(repo), []).append(path)
    return by_basename


def _change_for_tag_path(
    tag_path: str, change_by_path: dict[str, PinUpdate], groups: dict[str, tuple[str, ...]]
) -> PinUpdate:
    """The change written at `tag_path` or at a path sharing its value; SystemExit if none."""
    for candidate in (tag_path, *groups.get(tag_path, ())):
        if candidate in change_by_path:
            return change_by_path[candidate]
    msg = (
        f"error: no pin to update for {tag_path}; is it already at the target "
        "version, or does another path share this basename?"
    )
    raise SystemExit(msg)


def _plan_delegated_tags(
    ctx: BumpContext, delegated_paths: list[str], acc: TagUpdateAccumulator
) -> list[DelegatedUpdate]:
    """Resolve every delegated path's pins and digests, one call per basename, writing nothing.

    update_image_version bumps every pin of a basename under the key at once,
    so a second path with that basename, or a path whose tag is a YAML alias,
    has no change of its own: it is written through the path sharing its value.
    """
    values_lines = VALUES_YAML.read_text(encoding="utf-8").splitlines()
    groups = alias_groups(VALUES_YAML)
    updates: list[DelegatedUpdate] = []
    for basename, paths in _delegated_paths_by_basename(ctx, delegated_paths, acc).items():
        changes = plan_image_version_update(VALUES_YAML, ctx.values_key, basename, ctx.app_version)
        change_by_path = {dotted_key_path(values_lines, c["line"] - 1): c for c in changes}
        for path in paths:
            change = _change_for_tag_path(f"{ctx.values_key}.{path}.tag", change_by_path, groups)
            acc.new_tags_by_path[path] = f"{change['new_version']}@{change['new_digest']}"
        updates.append(DelegatedUpdate(basename, paths, changes))
    return updates


def _write_delegated_tags(ctx: BumpContext, updates: list[DelegatedUpdate]) -> None:
    """Write the pin updates _plan_delegated_tags resolved."""
    for update in updates:
        print_section(
            f"Updating '{update.basename}' image pin(s) for {', '.join(f'{ctx.values_key}.{p}' for p in update.paths)}"
        )
        for c in update.changes:
            print(f"  values.yaml:{c['line']}  ({c['repository']})")
            print(f"    {c['old_version']}@{c['old_digest']}")
            print(f"    {c['new_version']}@{c['new_digest']}")
        write_pin_updates(VALUES_YAML, update.changes)


def _write_fallback_tags(
    ctx: BumpContext,
    fallback_paths: list[str],
    upstream_images: dict[str, ImagePathTagCheck],
    acc: TagUpdateAccumulator,
) -> None:
    """Write the already-resolved sub-chart-default digests for fallback_paths."""
    if not fallback_paths:
        return
    print_section(f"Using sub-chart default digests for: {', '.join(fallback_paths)}")
    for path in fallback_paths:
        r = upstream_images.get(path)
        if r is None or not r["exists"] or not r["digest"]:
            msg = f"error: no repository found at {path}.repository in {ctx.chart_name}'s own values.yaml"
            raise SystemExit(msg)
        acc.repos[path] = r["repository"]
        acc.new_tags_by_path[path] = f"{ctx.app_version}@{r['digest']}"
        print(f"  {ctx.values_key}.{path}: {r['host']}/{r['repo_path']}:{ctx.app_version} -> {r['digest']}")
    print_section(f"Writing {VALUES_YAML}")
    for dotted, old_v, new_v in update_values_yaml(ctx.values_key, fallback_paths, acc.new_tags_by_path):
        print(f"  {dotted}:")
        print(f"    {old_v}")
        print(f"    {new_v}")


def _update_image_tags(
    ctx: BumpContext,
    paths_to_update: list[str],
    split_tag_sha_paths: dict[tuple[str, str], str],
    upstream_images: dict[str, ImagePathTagCheck],
) -> tuple[dict[str, str], dict[str, str]]:
    """Write every path's new tag. Returns (new_tags_by_path, repos)."""
    acc = TagUpdateAccumulator({}, {})
    if not paths_to_update:
        return acc.new_tags_by_path, acc.repos
    plan = _classify_paths_to_update(ctx, paths_to_update, split_tag_sha_paths)
    # Resolve the delegated pins before writing anything, so an error leaves values.yaml untouched.
    delegated = _plan_delegated_tags(ctx, plan.delegated_paths, acc)
    _write_split_tag_sha_pins(ctx, plan.split_paths, split_tag_sha_paths, acc)
    _write_delegated_tags(ctx, delegated)
    _write_fallback_tags(ctx, plan.fallback_paths, upstream_images, acc)
    return acc.new_tags_by_path, acc.repos


def _resolve_against_baseline(
    ctx: BumpContext,
    baseline_deps: list[ChartDependency],
    baseline_values: YamlMapping | None,
    friendly: str,
    upgrade_docs_baseline: str | None,
):
    """(old_app, old_chart, reset_to_baseline) against the resolved baseline, as the table row resolves them."""
    current = ComponentState(load_chart_dependencies(CHART_YAML), load_yaml_mapping(VALUES_YAML))
    resolution = ResolutionContext(
        CHART_DIR, current, BaselineState(baseline_deps, baseline_values), upgrade_docs_baseline
    )
    old_app, old_chart, reset_to_baseline = compare_component_to_baseline(resolution, friendly)
    if ctx.no_chart:
        old_chart = None
    # Never fall back to images-baseline.yaml: it only tracks ACR-mirror digests.
    return old_app, old_chart, reset_to_baseline


def _resolve_baseline_comparison(
    ctx: BumpContext, target: str, old_app_by_path: dict[str, str | None], paths_to_update: list[str]
):
    """Compare against the git-resolved upgrade_docs_baseline, not the on-disk state.

    Repeated bumps in one cycle then document as one baseline -> final change.
    """
    friendly = ctx.values_key
    # Fallback "old" values when upgrade_docs_baseline can't be resolved.
    old_chart = None if ctx.no_chart else str(ctx.dep["version"])
    # First changed path, so a bump of a later image path is not missed.
    image_path = paths_to_update[0] if paths_to_update else ctx.image_paths[0]
    old_app = old_app_by_path.get(image_path)

    upgrade_docs_baseline = _read_upgrade_docs_baseline(CHART_DIR)
    upgrade_path, values_deltas_path = baseline_doc_paths(upgrade_docs_baseline, target)

    baseline_deps = baseline_values = None
    if upgrade_docs_baseline is not None:
        baseline_deps, baseline_values = load_baseline_state(upgrade_docs_baseline)
    reset_to_baseline = False
    if baseline_deps is not None:
        old_app, old_chart, reset_to_baseline = _resolve_against_baseline(
            ctx, baseline_deps, baseline_values, friendly, upgrade_docs_baseline
        )

    return BaselineComparison(
        old_app,
        old_chart,
        reset_to_baseline,
        DocPaths(upgrade_path, values_deltas_path),
        BaselineSnapshot(upgrade_docs_baseline, baseline_deps, baseline_values),
    )


def _documented_paths(ctx: BumpContext, comparison: BaselineComparison, paths_to_update: list[str]) -> list[str]:
    """The image paths the Changes section lists: those whose baseline version differs from the target.

    Not only the paths this run wrote, so a rerun after a half-finished run
    documents the same paths. A blank baseline tag counts as the component's
    resolved baseline app version. Without a resolvable baseline, the paths
    this run changes.
    """
    if comparison.baseline_values is None:
        return paths_to_update
    documented: list[str] = []
    for path in ctx.image_paths:
        tag = text_at(comparison.baseline_values, f"{ctx.values_key}.{path}.tag")
        baseline_version = tag.split("@", 1)[0] if isinstance(tag, str) and tag else comparison.old_app
        if normalize_version(baseline_version) != normalize_version(ctx.app_version):
            documented.append(path)
    return documented


def _update_upgrade_doc_section(
    ctx: BumpContext, comparison: BaselineComparison, target: str, paths_to_update: list[str]
):
    """Update the upgrade doc's table row and Changes section."""
    friendly = ctx.values_key
    if comparison.upgrade_path is None:
        print_missing_upgrade_doc(comparison.upgrade_docs_baseline, target)
        return

    ordering = OrderingContext(ctx.deps, ctx.values)
    if comparison.reset_to_baseline:
        reset_upgrade_doc(comparison.upgrade_path, friendly, ordering, comparison.upgrade_docs_baseline)
        return

    change = VersionChange(comparison.old_app, ctx.app_version, comparison.old_chart, ctx.new_chart)
    identity = ComponentIdentity(friendly, ctx.chart_name, ctx.values_key)
    section = make_changes_section(identity, target, change, _documented_paths(ctx, comparison, paths_to_update))
    rewrite_upgrade_doc(comparison.upgrade_path, friendly, change, section, ordering)


def _update_values_deltas_change(ctx: BumpContext, comparison: BaselineComparison, friendly: str, text: str):
    """Write the values-deltas section for key changes since the baseline, if any."""
    current_values_after = load_yaml_mapping(VALUES_YAML)
    current_subtree = current_values_after.get(ctx.values_key, {})
    baseline_values_at_release: YamlMapping | None = (
        comparison.baseline_values
        if comparison.baseline_deps is not None
        else load_baseline_values(comparison.upgrade_docs_baseline)
    )
    key_lines: list[str] = []
    no_baseline_ref = baseline_values_at_release is None
    if baseline_values_at_release is not None:
        baseline_subtree = baseline_values_at_release.get(ctx.values_key, {})
        key_lines = describe_key_changes(ctx.values_key, baseline_subtree, current_subtree)

    # A version-only bump needs no section: the upgrade doc covers it.
    if key_lines:
        heading_line = values_delta_section_heading(
            friendly, comparison.old_app, ctx.app_version, comparison.old_chart, ctx.new_chart
        )
        write_values_delta_entry(
            comparison.values_deltas_path,
            text,
            ValuesDeltaEntry(friendly, heading_line, key_lines),
            OrderingContext(ctx.deps, ctx.values),
        )
    else:
        text, section_removed, kept_user_text = remove_values_delta_section(text, friendly, ctx.deps)
        if section_removed:
            write_removed_values_delta_section(
                comparison.values_deltas_path, text, friendly, kept_user_text=kept_user_text
            )
    if no_baseline_ref:
        print()
        print(
            f"  note: could not resolve upgrade_docs_baseline {comparison.upgrade_docs_baseline} to a git ref — "
            f"skipping added/removed/renamed key detection for values-deltas.md"
        )


def _update_values_deltas_section(ctx: BumpContext, comparison: BaselineComparison):
    """Update the values-deltas section."""
    friendly = ctx.values_key
    if comparison.values_deltas_path is None:
        if comparison.upgrade_path is not None:
            print()
            print(
                f"No values-deltas.md found for upgrade_docs_baseline {comparison.upgrade_docs_baseline} — "
                "skipping that update."
            )
        return

    text = comparison.values_deltas_path.read_text(encoding="utf-8")
    if not comparison.reset_to_baseline:
        _update_values_deltas_change(ctx, comparison, friendly, text)
        return
    text, section_removed, kept_user_text = remove_values_delta_section(text, friendly, ctx.deps)
    comparison.values_deltas_path.write_text(text, encoding="utf-8")
    outcome = (
        "kept its hand-written text, removed the generated parts; review it"
        if kept_user_text
        else ("removed its section" if section_removed else "nothing to remove")
    )
    print_section(f"Updating {comparison.values_deltas_path.name}")
    print(f"  {friendly} is back at its upgrade_docs_baseline {comparison.upgrade_docs_baseline} version — {outcome}")


def _remove_images_manifest_entries(
    comparison: BaselineComparison, manifest_target: ManifestUpdateTarget, path_update: ImagePathUpdate
):
    """Remove the component's manifest entries when it is back at its baseline."""
    changes_action, entry_removals = remove_component_from_images_manifest(manifest_target, path_update)
    print_section(f"Updating {manifest_target.images_path.name}")
    if changes_action:
        print(
            f"  {manifest_target.friendly} is back at its upgrade_docs_baseline "
            f"{comparison.upgrade_docs_baseline} version — removed 'changes:' list entry"
        )
    for name in entry_removals:
        print(f"  removed entry '{name}' (back at its upgrade_docs_baseline version)")


def _write_images_manifest_updates(
    ctx: BumpContext,
    comparison: BaselineComparison,
    manifest_target: ManifestUpdateTarget,
    path_update: ImagePathUpdate,
):
    """Update manifest entries for a version change."""
    change = VersionChange(comparison.old_app, ctx.app_version, comparison.old_chart, ctx.new_chart)
    # A missing entry is added by the fix-doc-consistency run at the end of main().
    changes_action, entry_updates, _missing_entries = update_images_manifest(
        manifest_target, change, path_update, ctx.deps, ctx.values
    )
    print_section(f"Updating {manifest_target.images_path.name}")
    if changes_action:
        print(f"  {changes_action} 'changes:' list entry")
    for name in entry_updates:
        print(f"  updated entry '{name}'")


def _update_images_manifest_section(
    ctx: BumpContext,
    comparison: BaselineComparison,
    paths_to_update: list[str],
    tags: tuple[dict[str, str], dict[str, str]],
):
    """Update images-<target>.yaml; `tags` is (new_tags_by_path, repos)."""
    if not paths_to_update:
        return
    new_tags_by_path, repos = tags
    target = current_chart_version()
    images_path = images_manifest_path(target)
    if not images_path.is_file():
        print()
        print(f"No images-{target}.yaml found — skipping that update.")
        return

    manifest_target = ManifestUpdateTarget(images_path, ctx.values_key, ctx.values_key)
    path_update = ImagePathUpdate(paths_to_update, repos, new_tags_by_path)
    if comparison.reset_to_baseline:
        _remove_images_manifest_entries(comparison, manifest_target, path_update)
    else:
        _write_images_manifest_updates(ctx, comparison, manifest_target, path_update)


def _run_fix_helm_doc() -> None:
    """Run fix-helm-doc; SystemExit on failure."""
    print_section("Regenerating README.md (fix-helm-doc)")
    result = run_script([sys.executable, str(FIX_HELM_DOC_SCRIPT)])
    if result.returncode != 0:
        msg = f"error: fix-helm-doc failed (exit {result.returncode}); README.md was not regenerated"
        raise SystemExit(msg)


def main():
    """CLI entry point."""
    component, app_version, chart_version = _parse_cli_args()
    ensure_vendored_dependencies(CHART_DIR)
    split_tag_sha_paths = _load_split_tag_sha_paths()
    ctx = _resolve_bump_context(component, app_version, chart_version)
    check_chart_version_lockstep(ctx.chart_name, app_version, chart_version, no_chart=ctx.no_chart)

    upstream_images, chart_unchanged = _verify_versions(ctx)
    paths_to_update, old_app_by_path = _compute_paths_to_update(ctx)

    if chart_unchanged and not paths_to_update:
        # An earlier run may have written values.yaml/Chart.yaml and stopped before its docs.
        print()
        print("Component is already at the requested versions; completing docs.")

    new_tags_by_path, repos = _update_image_tags(ctx, paths_to_update, split_tag_sha_paths, upstream_images)

    if not chart_unchanged:
        print_section(f"Writing {CHART_YAML}")
        old_v, new_v = update_chart_yaml(ctx.chart_name, chart_version)
        print(f"  {old_v}  ->  {new_v}")

    target = current_chart_version()
    comparison = _resolve_baseline_comparison(ctx, target, old_app_by_path, paths_to_update)

    _update_upgrade_doc_section(ctx, comparison, target, paths_to_update)
    _update_values_deltas_section(ctx, comparison)
    _update_images_manifest_section(ctx, comparison, paths_to_update, (new_tags_by_path, repos))

    _run_fix_helm_doc()

    # The doc steps above only read a vendored .tgz whose version didn't change.
    print_section("Re-vendoring changed sub-charts")
    ensure_vendored_dependencies(CHART_DIR)

    # Last: its render needs the re-vendored sub-charts.
    complete_docs_and_finish()


if __name__ == "__main__":
    with network_errors("container registry"):
        main()
