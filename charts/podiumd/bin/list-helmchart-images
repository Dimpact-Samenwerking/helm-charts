#!/usr/bin/env python3
"""
List the images and sub-chart dependencies of one podiumd dependency
chart at a given version.

Pulls the chart (a file:// dependency is read from its source directory).
Each image prints as "<key> <image-basename> <image-version>", the
argument order update-image-version and verify-image-version take,
followed by indented "<repo>:<tag>" and "(path: <values path>)" lines.

Usage:
    list-helmchart-images <dependency> <dependency-chart-version>

Arguments:
    <dependency>                Chart.yaml dependency name or alias; not a
                                native component, which has no chart
    <dependency-chart-version>  Helm chart version; for a file:// dependency
                                only checked against its source

Examples:
    list-helmchart-images zac 1.0.297
    list-helmchart-images zgw-office-addin 0.0.92
    list-helmchart-images mi-data 1.0.0

Requires: helm on PATH, with the podiumd Helm repositories added.
"""

import shutil
import sys
import tempfile

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.chart_yaml import chart_dependencies
from lib.chart.chart_yaml import load_chart_dependencies
from lib.chart.chart_yaml import load_chart_yaml
from lib.chart.paths import CHART_DIR
from lib.chart.paths import CHART_YAML
from lib.chart.pull_and_subchart_resolution import chart_ref
from lib.chart.pull_and_subchart_resolution import local_chart_dir
from lib.chart.pull_and_subchart_resolution import pull_chart
from lib.chart.pull_and_subchart_resolution import pulled_chart_dir
from lib.chart.pull_and_subchart_resolution import require_local_chart_dir
from lib.chart.values_tree_primitives import find_dependency as _find_dependency
from lib.chart.values_tree_primitives import find_images
from lib.chart.values_tree_primitives import values_key_of
from lib.chart.values_tree_primitives import version_of
from lib.cli import positional_args
from lib.image.version import image_basename
from lib.yaml_types import YamlMapping
from lib.yaml_types import load_yaml_mapping


def find_dependency(name_or_alias: str):
    """Chart.yaml dependency by name or alias; SystemExit if none."""
    deps = load_chart_dependencies(CHART_YAML)
    dep = _find_dependency(deps, name_or_alias)
    if dep is None:
        msg = f"error: no dependency named or aliased '{name_or_alias}' found in {CHART_YAML}"
        raise SystemExit(msg)
    return dep


def _print_image_references(values_yaml: YamlMapping, key: str):
    """Print each image as the module docstring describes, column-aligned."""
    images = find_images(values_yaml)
    if not images:
        print("\nNo image references found in values.yaml")
        return

    print("\nImage references:")
    entries = [(key, image_basename(repo), version_of(tag), repo, tag, path) for path, repo, tag in images]
    entries.sort(key=lambda e: e[5])
    bwidth = max(len(e[1]) for e in entries)
    for key_, basename, version, repo, tag, path in entries:
        print(f"  {key_}  {basename.ljust(bwidth)}  {version}")
        print(f"      {repo}:{tag}")
        print(f"      (path: {path})")


def report_chart(chart_dir: Path, requested_version: str, key: str):
    """Print chart name/versions, sub-chart dependencies and images; notes a version mismatch on stderr."""
    chart_yaml = load_chart_yaml(chart_dir / "Chart.yaml")
    values_yaml = load_yaml_mapping(chart_dir / "values.yaml")

    actual_version = chart_yaml["version"]
    if actual_version != requested_version:
        print(
            f"note: {chart_dir} is actually version {actual_version!r}, not the requested {requested_version!r}",
            file=sys.stderr,
        )

    print(f"\nChart: {chart_yaml['name']} {actual_version} (appVersion: {chart_yaml.get('appVersion', 'n/a')})")

    sub_deps = chart_dependencies(chart_yaml)
    if sub_deps:
        print("\nSub-chart dependencies:")
        for d in sub_deps:
            print(f"  - {d['name']}: {d['version']}")

    _print_image_references(values_yaml, key)


def main():
    """CLI entry point."""
    name_or_alias, version = positional_args(__doc__, 2)
    dep = find_dependency(name_or_alias)
    key = values_key_of(dep)

    local_dir = local_chart_dir(CHART_DIR, dep)
    if local_dir is not None:
        require_local_chart_dir(local_dir, dep)
        print(f"Reading local chart source: {local_dir}")
        report_chart(local_dir, version, key)
        return

    tmpdir = Path(tempfile.mkdtemp(prefix="list-helmchart-images-"))
    try:
        ref, _ = chart_ref(dep)
        print(f"Pulling {ref} @ {version} ...")
        ok, stderr = pull_chart(dep, version, tmpdir)
        if not ok:
            msg = f"error: helm pull failed for {ref}@{version}\n{stderr}"
            raise SystemExit(msg)
        report_chart(pulled_chart_dir(tmpdir), version, key)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


if __name__ == "__main__":
    main()
