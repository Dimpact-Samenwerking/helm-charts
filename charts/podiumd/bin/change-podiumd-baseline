#!/usr/bin/env python3
"""
Change the upgrade_docs baseline of the current release.

Writes <new-baseline> as upgrade_docs in charts/podiumd/etc/release-
baseline.yaml, then runs fix-doc-consistency to rebase the upgrade docs
onto it and fix-helm-doc to regenerate README.md. release_table is never
changed. Fails if <new-baseline> has no podiumd-<version> tag or
feature/podiumd-<version> branch (local or origin).

Usage:
    change-podiumd-baseline <new-baseline>

Arguments:
    <new-baseline>   released podiumd version, e.g. 4.8.5

Example:
    change-podiumd-baseline 4.8.5
"""

import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# Not installed as a package -- sys.path must be patched before
# lib.* can be imported, so these imports can't move to the top.
# pylint: disable=wrong-import-position
from lib.chart.historical_baselines import SEMVER_RE as BASELINE_VERSION_RE
from lib.chart.paths import CHART_DIR
from lib.chart.release_baseline_basics import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.chart.release_baseline_basics import write_release_baselines
from lib.cli import positional_args
from lib.gitutil import find_repo_root
from lib.gitutil import resolve_baseline_ref
from lib.procutil import run_script

FIX_DOC_CONSISTENCY_SCRIPT = SCRIPT_DIR / "fix-doc-consistency"
FIX_HELM_DOC_SCRIPT = SCRIPT_DIR / "fix-helm-doc"


def main():
    """CLI entry point: validates <new-baseline> resolves to a real release
    (tag or branch), writes it as release-baseline.yaml's upgrade_docs key,
    then rebases the docs onto it (fix-doc-consistency) and regenerates
    README.md (fix-helm-doc) — exits with whichever of those two sub-runs
    fails first, if any."""
    (new_baseline,) = positional_args(__doc__, 1)

    # A baseline is always a released MAJOR.MINOR.PATCH — never an arbitrary
    # ref. Without this, gitutil.baseline_ref_candidates' unanchored match
    # lets "main" / "HEAD~2" / "4.9.1-rc.2" resolve as an explicit ref and
    # get persisted into release-baseline.yaml, where every downstream
    # consumer assumes semver. Same guard create-doc-version already has.
    if not BASELINE_VERSION_RE.match(new_baseline):
        print(f"error: '{new_baseline}' is not a valid MAJOR.MINOR.PATCH version")
        sys.exit(1)

    repo_root = find_repo_root(CHART_DIR)
    if repo_root is None:
        print("error: not inside a git repository")
        sys.exit(1)

    ref, error = resolve_baseline_ref(repo_root, new_baseline)
    if error:
        print(f"error: {error}")
        sys.exit(1)

    old_baseline = read_upgrade_docs_baseline(CHART_DIR)
    write_release_baselines(CHART_DIR, upgrade_docs=new_baseline)

    if old_baseline == new_baseline:
        print(f"release-baseline.yaml: upgrade_docs already {new_baseline} (resolved to {ref}) — nothing changed")
    else:
        print(f"release-baseline.yaml: upgrade_docs {old_baseline or '(none)'} -> {new_baseline} (resolved to {ref})")

    print()
    print(f"=== Running fix-doc-consistency (upgrade_docs baseline {new_baseline}) ===")
    result = run_script([sys.executable, str(FIX_DOC_CONSISTENCY_SCRIPT)])
    if result.returncode != 0:
        sys.exit(result.returncode)

    print()
    print("=== Regenerating README.md (fix-helm-doc) ===")
    result = run_script([sys.executable, str(FIX_HELM_DOC_SCRIPT)])
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
