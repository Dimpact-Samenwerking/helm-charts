#!/usr/bin/env python3
"""
Change the upgrade_docs baseline recorded in charts/podiumd/release-
baseline.yaml (written by create-podiumd-version at the start of a
release cycle) — for correcting a mistake, or rebasing the release onto
a different baseline mid-cycle. Also rebases the docs onto the new
baseline (runs fix-doc-consistency — see that script for exactly what
gets renamed/rewritten vs. just reported for manual review) and, as a
safety net for any values.yaml drift README.md hadn't already picked
up, regenerates it too (runs fix-helm-doc).

Only ever touches upgrade_docs — never release_table, which only ever
changes via create-podiumd-version's own minor-bump rule. There is no
equivalent "change" tool for release_table.

<new-baseline> must resolve to an actual release: the podiumd-<version>
git tag, falling back to the feature/podiumd-<version> / origin/feature/
podiumd-<version> branch if the tag doesn't exist yet (same resolution as
show-component-baseline-version) — refuses to record a baseline that
doesn't exist.

Usage:
    change-podiumd-baseline <new-baseline>

Example:
    change-podiumd-baseline 4.8.5
"""
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from lib.chart import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.chart import write_release_baselines
from lib.gitutil import find_repo_root, resolve_baseline_ref
from lib.procutil import run_script

CHART_DIR = SCRIPT_DIR.parent
FIX_DOC_CONSISTENCY_SCRIPT = SCRIPT_DIR / "fix-doc-consistency"
FIX_HELM_DOC_SCRIPT = SCRIPT_DIR / "fix-helm-doc"


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    if len(sys.argv) != 2:
        print(__doc__)
        sys.exit(1)
    new_baseline = sys.argv[1]

    repo_root = find_repo_root(CHART_DIR)
    if repo_root is None:
        print("error: not inside a git repository")
        sys.exit(1)

    ref, error = resolve_baseline_ref(repo_root, new_baseline)
    if error:
        print(f"error: {error}")
        sys.exit(1)

    old_baseline = read_upgrade_docs_baseline(CHART_DIR)
    write_release_baselines(CHART_DIR, upgrade_docs=new_baseline)

    if old_baseline == new_baseline:
        print(f"release-baseline.yaml: upgrade_docs already {new_baseline} "
              f"(resolved to {ref}) — nothing changed")
    else:
        print(f"release-baseline.yaml: upgrade_docs {old_baseline or '(none)'} -> {new_baseline} "
              f"(resolved to {ref})")

    print()
    print(f"=== Running fix-doc-consistency {new_baseline} ===")
    result = run_script([sys.executable, str(FIX_DOC_CONSISTENCY_SCRIPT), new_baseline])
    if result.returncode != 0:
        sys.exit(result.returncode)

    print()
    print("=== Regenerating README.md (fix-helm-doc) ===")
    result = run_script([sys.executable, str(FIX_HELM_DOC_SCRIPT)])
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
