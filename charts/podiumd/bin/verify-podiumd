#!/usr/bin/env python3
"""
Verify the podiumd chart in charts/podiumd next to this script.

Runs every step, cheapest first (filesystem, then network, then Docker),
and prints a PASS/FAIL/SKIP summary. A failing step does not stop the run;
steps whose prerequisite (STEP_PREREQUISITES) failed are skipped. Writes
nothing to the chart; the fix-* scripts repair what it reports.

Steps, in run order:
  utf8-format          values.yaml has no UTF-8 BOM
  dupe-check           values.yaml has no duplicate keys
  dry-check            near-duplicate templates (report only)
  image-references     own templates' `image:` fields use podiumd.image
  node-selector        own workloads have a nodeSelector
  oidc-url-coverage    Keycloak redirectUris paths have an $oidcClients entry
  digest-pinning       values.yaml image tags are digest-pinned
  vendored-tgz         no extracted charts/<name>/ next to its .tgz; must run
                       before dependencies, whose rebuild removes the evidence
  release-baseline     release-baseline.yaml's upgrade_docs and release_table
                       both resolve to a tag or branch
  lockstep-versions    registered lockstep components agree on one version
  helm-doc             README.md matches `helm-docs --dry-run`
  markdown             pymarkdown on the chart's own *.md (report only)
  repo-access          dependency repos and image registries are reachable
  dependencies         `helm dependency update` resolves and vendors
  doc-consistency      upgrade docs and images manifest match Chart.yaml and
                       values.yaml, against the upgrade_docs baseline
  subchart-images      sub-chart default images are visible; fails on a
                       floating tag in a rendered sub-chart
  shared-image-usage   global.images.* entries have 2+ rendered consumers
  image-repository     every image tag block resolves to a repository
  image-digests        digest pins match the registry (sliding tags pass)
  helm-lint            `helm lint` with ci/lint-values.yaml
  full-render          `helm template` with ci/lint-values.yaml
  yamllint             structural problems in own templates
  kubeconform          schema violations in own templates
  shellcheck           embedded shell scripts in own templates
  kube-score           container resource requests/limits (report only)
  release-secret-size  Helm release Secret stays under 90% of 1 MiB
  image-upgrades       newer same-variant tags published (report only)
  cve-scan             fixable CVEs via docker + trivy (report only; skipped
                       without docker)
  cve-diff             CVEs closed/introduced by upgrade candidates (report
                       only)

Vendored sub-chart findings of yamllint, kubeconform, shellcheck and
kube-score never fail; partner vendors (lib.render_scope) get per-item
detail, others a count.

The slow dead-values scan is a separate script: verify-podiumd-dead-values.

Usage:
    verify-podiumd [--skip=STEP,...|--include=STEP,...]
                   [--detail-cve-check] [--detail-cve-diff]

Examples:
    verify-podiumd
    verify-podiumd --skip=cve-scan,cve-diff
    verify-podiumd --include=kube-score,shellcheck

Exit code: 1 when any step fails.
"""

import argparse
import re
import shutil
import sys

from collections.abc import Callable
from dataclasses import dataclass
from dataclasses import field
from pathlib import Path
from typing import ParamSpec

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.release_baseline_basics import RELEASE_BASELINES_FILE_NAME
from lib.chart.release_baseline_basics import release_table_baseline as read_release_table_baseline
from lib.chart.release_baseline_basics import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.chart.values_tree_primitives import UTF8_BOM
from lib.checks.cve import check_cves
from lib.checks.cve_diff import check_cve_diff
from lib.checks.digest_pinning import check_digest_pinning
from lib.checks.digest_pinning import check_shared_image_usage
from lib.checks.digest_pinning import check_subchart_image_visibility
from lib.checks.dry import check_dry
from lib.checks.duplicate_keys import check_duplicate_keys
from lib.checks.helm_docs import check_helm_docs
from lib.checks.kube_score import check_kube_score
from lib.checks.kubeconform import check_kubeconform
from lib.checks.lockstep import check_lockstep_versions
from lib.checks.markdown import check_markdown
from lib.checks.node_selector import check_node_selector
from lib.checks.oidc_url_coverage import check_oidc_url_coverage
from lib.checks.shellcheck import check_shellcheck
from lib.checks.vendored_tgz import check_vendored_tgz_extraction
from lib.checks.yamllint import check_yamllint
from lib.dependencies import check_dependencies
from lib.dependencies import ensure_repos_configured
from lib.dependencies import ensure_vendored_dependencies
from lib.docs_consistency import check_docs_consistency
from lib.gitutil import find_repo_root
from lib.gitutil import resolve_baseline_ref
from lib.image.digests import check_image_digests
from lib.image.references_check import check_image_references
from lib.image.repository_check import check_image_repository
from lib.image.upgrade_check import check_image_upgrades
from lib.procutil import run
from lib.release_secret_size import check_release_secret_size
from lib.render_scope import lint_args_for
from lib.render_scope import render_chart
from lib.render_scope import report_errors_by_subchart
from lib.render_scope import report_largest_templates
from lib.repo_access import check_repo_access
from lib.settings import render_report_top_n_largest_templates_shown

# Only what main() calls; tests import checks from their lib modules directly.


DEFAULT_CHART_DIR = SCRIPT_DIR.parent


def log(title: str):
    """Print a "=== title ===" section header."""
    print(f"\n=== {title} ===")


def die(message: str):
    """Exit 1 on a setup failure before any step runs."""
    print(f"FAIL: {message}", file=sys.stderr)
    sys.exit(1)


def require_helm():
    """Exit if `helm` is not on PATH; nearly every step needs it."""
    if shutil.which("helm") is None:
        die("helm is not installed")


def resolve_chart_dir():
    """Absolute DEFAULT_CHART_DIR; exits if it has no Chart.yaml."""
    chart_dir = DEFAULT_CHART_DIR.resolve()
    if not (chart_dir / "Chart.yaml").is_file():
        die(f"{chart_dir} does not contain a Chart.yaml")
    return chart_dir


def check_utf8_format(chart_dir: Path):
    """(ok, detail): fails when values.yaml starts with a UTF-8 BOM."""
    values_path = chart_dir / "values.yaml"
    data = values_path.read_bytes()
    if data[: len(UTF8_BOM)] == UTF8_BOM:
        return False, "BOM found — run fix-utf8-bom to fix (this script never writes to values.yaml)"
    print(f"OK: no BOM in {values_path.name}")
    return True, "no BOM"


def check_release_baseline(chart_dir: Path):
    """(ok, detail): both release-baseline.yaml keys resolve to a real release.

    A missing file or key fails too.
    """
    baselines_file = chart_dir / RELEASE_BASELINES_FILE_NAME
    repo_root = find_repo_root(chart_dir)
    if repo_root is None:
        return False, f"{baselines_file.name}: not inside a git repository"

    failures: list[str] = []
    resolved: list[str] = []
    for key, baseline in (
        ("upgrade_docs", read_upgrade_docs_baseline(chart_dir)),
        ("release_table", read_release_table_baseline(chart_dir)),
    ):
        if baseline is None:
            failures.append(f"{key}: missing from {baselines_file.name}")
            continue
        ref, error = resolve_baseline_ref(repo_root, baseline)
        if error:
            failures.append(f"{key} '{baseline}': {error}")
            continue
        print(f"OK: {baselines_file.name} {key} '{baseline}' resolves to {ref}")
        resolved.append(f"{key} -> {ref}")

    if failures:
        for failure in failures:
            print(f"FAIL: {failure}")
        return False, "; ".join(failures)
    return True, ", ".join(resolved)


def check_lint(chart_dir: Path, extra_args: list[str]):
    """(ok, detail) for `helm lint`; also fails on an [ERROR] line with exit 0."""
    result = run(["helm", "lint", str(chart_dir), *extra_args], capture_output=True, text=True)
    output = result.stdout + result.stderr
    print(output, end="" if output.endswith("\n") else "\n")

    error_count = len(re.findall(r"^\[ERROR\]", output, re.MULTILINE))
    warning_count = len(re.findall(r"^\[WARNING\]", output, re.MULTILINE))
    detail = f"{error_count} error(s), {warning_count} warning(s)"

    if result.returncode != 0 or error_count > 0:
        return False, detail
    return True, detail


def check_render(chart_dir: Path, extra_args: list[str]):
    """(ok, detail) for a full render; fails on a render error or zero manifests."""
    result = render_chart(chart_dir, extra_args)

    if result.returncode != 0:
        print(result.stderr, end="" if result.stderr.endswith("\n") else "\n")
        report_errors_by_subchart(result.stderr)
        return False, "helm template failed to render"

    doc_count = sum(1 for line in result.stdout.splitlines() if line.startswith("---"))
    if doc_count <= 0:
        return False, "rendered 0 manifests"

    report_largest_templates(result.stdout, render_report_top_n_largest_templates_shown(chart_dir))
    detail = f"{doc_count} manifests"
    print(f"OK: rendered {detail}")
    return True, detail


# One step's summary row: (name, ok or None when skipped, detail).
StepResult = tuple[str, bool | None, str | None]


def print_summary(results: list[StepResult], *, overall_ok: bool):
    """Print the PASS/FAIL/SKIP table (ok None is SKIP) and a closing line."""
    log("VERIFY SUMMARY")
    width = max(len(name) for name, _, _ in results)
    for name, ok, detail in results:
        status = "SKIP" if ok is None else ("PASS" if ok else "FAIL")
        print(f"  {name.ljust(width)} : {status} ({detail})")
    print()
    if overall_ok:
        print("All checks passed.")
    else:
        print("One or more checks failed — see details above.")


# (step name for --skip=/--include=, step name) for every skippable step,
# in the order they run. Order here also drives --help's listing.
SKIPPABLE_STEPS = [
    ("utf8-format", "UTF-8 format"),
    ("dupe-check", "Dupe check"),
    ("dry-check", "DRY check"),
    ("image-references", "Image references"),
    ("node-selector", "Node selector"),
    ("oidc-url-coverage", "OIDC URL coverage"),
    ("digest-pinning", "Digest pinning"),
    ("vendored-tgz", "Vendored tgz"),
    ("release-baseline", "Release baseline"),
    ("lockstep-versions", "Lockstep versions"),
    ("helm-doc", "Helm doc"),
    ("markdown", "Markdown lint"),
    ("repo-access", "Repo access"),
    ("dependencies", "Dependencies"),
    ("doc-consistency", "Doc consistency"),
    ("subchart-images", "Subchart image visibility"),
    ("shared-image-usage", "Shared image usage"),
    ("image-repository", "Image repository"),
    ("image-digests", "Image digests"),
    ("helm-lint", "Helm lint"),
    ("full-render", "Full render"),
    ("yamllint", "yamllint"),
    ("kubeconform", "kubeconform"),
    ("shellcheck", "shellcheck"),
    ("kube-score", "kube-score"),
    ("release-secret-size", "Release secret size"),
    ("image-upgrades", "Image upgrades"),
    ("cve-scan", "CVE scan"),
    ("cve-diff", "CVE diff"),
]

# step name -> steps that must run first (also pulled in by --include=).
# "Dependencies" vendors charts/*.tgz (gitignored), which every render and
# every sub-chart-default lookup needs. "Image upgrades" writes the cache
# the CVE steps read. "CVE diff" needs "Image digests" for sliding pins.
# "Dependencies" needs "Repo access" only for its fast failure.
STEP_PREREQUISITES = {
    "Dependencies": ("Repo access",),
    "Doc consistency": ("Dependencies",),
    "Subchart image visibility": ("Dependencies",),
    "Shared image usage": ("Dependencies",),
    "Image repository": ("Dependencies",),
    "Image digests": ("Dependencies",),
    "Helm lint": ("Dependencies",),
    "Full render": ("Dependencies",),
    "yamllint": ("Dependencies",),
    "kubeconform": ("Dependencies",),
    "shellcheck": ("Dependencies",),
    "kube-score": ("Dependencies",),
    "Release secret size": ("Dependencies",),
    "Image upgrades": ("Dependencies",),
    "CVE scan": ("Dependencies", "Image upgrades"),
    "CVE diff": ("Dependencies", "Image upgrades", "Image digests"),
}


def prerequisites_for(step_name: str) -> set[str]:
    """Transitive closure of STEP_PREREQUISITES for step_name."""
    resolved: set[str] = set()
    stack = list(STEP_PREREQUISITES.get(step_name, ()))
    while stack:
        step = stack.pop()
        if step not in resolved:
            resolved.add(step)
            stack.extend(STEP_PREREQUISITES.get(step, ()))
    return resolved


# --help epilog, built from SKIPPABLE_STEPS so it cannot drift.
STEPS_HELP = (
    "\nSteps usable with --skip=/--include= (in run order):\n"
    + "\n".join(
        f"  {flag:<{max(len(f) for f, _ in SKIPPABLE_STEPS) + 2}}{step_name}" for flag, step_name in SKIPPABLE_STEPS
    )
    + "\n"
)

REQUIRED_TOOLS_HELP = """
Requires: the tools listed in README-release-process.md#setup. A step whose
tool is missing fails; skip it with --skip. Without docker the CVE scan is
reported as skipped.
"""


StepParams = ParamSpec("StepParams")


@dataclass
class StepRunner:
    """Skip/include configuration and results collected across steps."""

    skipped_steps: set[str] = field(default_factory=set)
    skip_flags: list[str] = field(default_factory=list)
    include_flags: list[str] = field(default_factory=list)
    results: list[StepResult] = field(default_factory=list)
    failed_or_blocked: set[str] = field(default_factory=set)

    def run(
        self,
        name: str,
        title: str,
        func: Callable[StepParams, tuple[bool, str | None]],
        *fargs: StepParams.args,
        **fkwargs: StepParams.kwargs,
    ):
        """Run one step unless skipped or blocked by a failed prerequisite; record its result."""
        log(title)
        if name in self.skipped_steps:
            if self.include_flags:
                print(f"SKIPPED (not included via --include={','.join(self.include_flags)})")
            else:
                print(f"SKIPPED (--skip={','.join(self.skip_flags)})")
            self.results.append((name, None, "skipped"))
            return

        blocking = sorted(prerequisites_for(name) & self.failed_or_blocked)
        if blocking:
            reason = f'prerequisite "{blocking[0]}" failed'
            print(f"SKIPPED ({reason} — nothing real to check here either)")
            self.results.append((name, None, reason))
            self.failed_or_blocked.add(name)
            return

        ok, detail = func(*fargs, **fkwargs)
        self.results.append((name, ok, detail))
        if not ok:
            self.failed_or_blocked.add(name)


def _parse_cli_args():
    """(args, skipped_steps, skip_flags, include_flags) from argv."""
    parser = argparse.ArgumentParser(
        description="Verify the podiumd chart: run every check step and print a summary.\nExits 1 when a step fails.",
        epilog=STEPS_HELP + REQUIRED_TOOLS_HELP,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--detail-cve-check",
        action="store_true",
        help="CVE scan: list CRITICAL/HIGH findings per package for every image, not only totals",
    )
    parser.add_argument(
        "--detail-cve-diff",
        action="store_true",
        help="CVE diff: list the CRITICAL/HIGH findings each upgrade candidate closes or adds, not only counts",
    )
    parser.add_argument(
        "--skip",
        default=None,
        metavar="STEP1,STEP2,...",
        help="comma-separated steps to skip; shown as SKIP, not as a failure. Not with --include",
    )
    parser.add_argument(
        "--include",
        default=None,
        metavar="STEP1,STEP2,...",
        help="comma-separated steps to run, plus their prerequisites; the rest show as SKIP. Not with --skip",
    )
    args = parser.parse_args()

    valid_flags = {flag for flag, _ in SKIPPABLE_STEPS}

    def parse_step_list(raw: str | None, option_name: str) -> list[str]:
        if not raw:
            return []
        flags = [f for f in raw.split(",") if f]
        unknown = [f for f in flags if f not in valid_flags]
        if unknown:
            parser.error(
                f"{option_name}: unknown step(s): {', '.join(unknown)} — valid steps: "
                f"{', '.join(flag for flag, _ in SKIPPABLE_STEPS)}"
            )
        return flags

    skip_flags = parse_step_list(args.skip, "--skip")
    include_flags = parse_step_list(args.include, "--include")

    if include_flags and skip_flags:
        parser.error("--include cannot be combined with --skip")

    if include_flags:
        target_steps = {dict(SKIPPABLE_STEPS)[flag] for flag in include_flags}
        runnable = set(target_steps)
        for step in target_steps:
            runnable |= prerequisites_for(step)
        skipped_steps = {step_name for _, step_name in SKIPPABLE_STEPS if step_name not in runnable}
    else:
        skipped_steps = {dict(SKIPPABLE_STEPS)[flag] for flag in skip_flags}

    return args, skipped_steps, skip_flags, include_flags


def _run_all_steps(runner: StepRunner, chart_dir: Path, args: argparse.Namespace):
    """Run every step in SKIPPABLE_STEPS order.

    An explicit skip never marks a step failed_or_blocked, so it never blocks
    an included step.
    """
    runner.run("UTF-8 format", "UTF-8 format check", check_utf8_format, chart_dir)
    runner.run("Dupe check", "Duplicate key scan", check_duplicate_keys, chart_dir)
    runner.run("DRY check", "Template duplication scan", check_dry, chart_dir)
    runner.run(
        "Image references", "Checking image: fields use the podiumd.image helper", check_image_references, chart_dir
    )
    runner.run("Node selector", "Checking workloads expose a nodeSelector field", check_node_selector, chart_dir)
    runner.run(
        "OIDC URL coverage",
        "Checking Keycloak client redirectUris values have an $oidcClients entry",
        check_oidc_url_coverage,
        chart_dir,
    )
    runner.run("Digest pinning", "Checking every image tag is digest-pinned", check_digest_pinning, chart_dir)
    runner.run(
        "Vendored tgz", "Checking for extracted dirs shadowing a pinned .tgz", check_vendored_tgz_extraction, chart_dir
    )
    runner.run(
        "Release baseline", "Checking release-baseline resolves to a real release", check_release_baseline, chart_dir
    )
    runner.run(
        "Lockstep versions",
        "Checking registered lockstep image/version groups agree",
        check_lockstep_versions,
        chart_dir,
    )

    runner.run("Helm doc", "Checking README.md against values.yaml (helm-docs)", check_helm_docs, chart_dir)
    runner.run("Markdown lint", "Checking markdown docs with pymarkdown", check_markdown, chart_dir)

    runner.run(
        "Repo access",
        "Checking access to Chart.yaml's dependency repos and values.yaml's image registries",
        check_repo_access,
        chart_dir,
    )

    log("Ensuring dependency repos are configured")
    ok, msg = ensure_repos_configured(chart_dir)
    if not ok:
        die(msg)

    runner.run("Dependencies", "Resolving dependencies (re-vendoring what changed)", check_dependencies, chart_dir)

    upgrade_docs_baseline = read_upgrade_docs_baseline(chart_dir)
    runner.run(
        "Doc consistency",
        "Checking versions against upgrade docs",
        check_docs_consistency,
        chart_dir,
        upgrade_docs_baseline,
    )

    extra_args = lint_args_for(chart_dir)
    runner.run(
        "Subchart image visibility",
        "Checking for images defined only in a vendored sub-chart's own default values.yaml",
        check_subchart_image_visibility,
        chart_dir,
        extra_args,
    )

    runner.run(
        "Shared image usage",
        "Checking global.images.* shared-anchor usage against the real render",
        check_shared_image_usage,
        chart_dir,
        extra_args,
    )

    runner.run(
        "Image repository", "Checking every image tag block resolves to a repository", check_image_repository, chart_dir
    )

    runner.run("Image digests", "Checking image digests against upstream registries", check_image_digests, chart_dir)

    runner.run("Helm lint", "helm lint", check_lint, chart_dir, extra_args)
    runner.run("Full render", "Full render", check_render, chart_dir, extra_args)
    runner.run("yamllint", "yamllint (rendered output)", check_yamllint, chart_dir, extra_args)
    runner.run("kubeconform", "kubeconform (rendered output)", check_kubeconform, chart_dir, extra_args)
    runner.run("shellcheck", "shellcheck (embedded shell scripts)", check_shellcheck, chart_dir, extra_args)
    runner.run("kube-score", "kube-score (resource requests/limits)", check_kube_score, chart_dir, extra_args)
    runner.run(
        "Release secret size",
        "Estimating the Helm release Secret size",
        check_release_secret_size,
        chart_dir,
        extra_args,
    )
    runner.run("Image upgrades", "Checking for newer published tags", check_image_upgrades, chart_dir, extra_args)
    runner.run(
        "CVE scan",
        "Scanning pinned images for known CVEs (trivy)",
        check_cves,
        chart_dir,
        extra_args,
        detail=args.detail_cve_check,
    )
    runner.run(
        "CVE diff",
        "Diffing CVEs for upgrade/slide candidates (current vs proposed, trivy)",
        check_cve_diff,
        chart_dir,
        extra_args,
        detail=args.detail_cve_diff,
    )


def _ensure_vendored_dependencies_if_skipped(chart_dir: Path, skipped_steps: set[str]):
    """With "Dependencies" skipped, re-vendor a stale state when a step that needs it still runs."""
    if "Dependencies" not in skipped_steps:
        return
    if any(
        "Dependencies" in prerequisites_for(step_name)
        for _, step_name in SKIPPABLE_STEPS
        if step_name not in skipped_steps
    ):
        ensure_vendored_dependencies(chart_dir)


def main():
    """CLI entry point."""
    args, skipped_steps, skip_flags, include_flags = _parse_cli_args()

    require_helm()

    log("Resolving chart source")
    chart_dir = resolve_chart_dir()
    print(f"Using local chart source: {chart_dir}")
    _ensure_vendored_dependencies_if_skipped(chart_dir, skipped_steps)

    runner = StepRunner(skipped_steps=skipped_steps, skip_flags=skip_flags, include_flags=include_flags)
    _run_all_steps(runner, chart_dir, args)

    overall_ok = not runner.failed_or_blocked
    print_summary(runner.results, overall_ok=overall_ok)
    if not overall_ok:
        sys.exit(1)


if __name__ == "__main__":
    main()
