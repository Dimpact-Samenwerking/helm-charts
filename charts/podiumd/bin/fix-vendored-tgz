#!/usr/bin/env python3
"""
Delete extracted sub-chart directories that shadow a vendored .tgz.

Removes every charts/podiumd/charts/<name>/ directory next to a pinned
<name>-<version>.tgz: Helm uses the directory instead of the pinned
.tgz. Fixes what verify-podiumd's "Vendored tgz" step reports.

Usage:
    fix-vendored-tgz [--dry-run]

Options:
    --dry-run   report what would change, write nothing
"""

import shutil
import sys

from pathlib import Path
from typing import NoReturn

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.paths import CHART_DIR
from lib.checks.vendored_tgz import find_extracted_vendored_dirs
from lib.cli import flag_args
from lib.cli import noun_for


def extracted_directories(count: int) -> str:
    """The count with its noun, for the dry-run and the deletion message."""
    return f"{count} extracted {noun_for(count, 'directory', 'directories')}"


def exit_with_dry_run_listing(extracted: list[str]) -> NoReturn:
    """List the directories that would be deleted and exit 1."""
    print(f"Found {extracted_directories(len(extracted))} shadowing a pinned .tgz (dry-run, not deleting):")
    for name in extracted:
        print(f"  charts/{name}/")
    sys.exit(1)


def main():
    """CLI entry point; --dry-run exits 1 when directories are found."""
    dry_run = "--dry-run" in flag_args(__doc__, "--dry-run")

    extracted = find_extracted_vendored_dirs(CHART_DIR)
    if not extracted:
        print("OK: no vendored sub-chart has both a pinned .tgz and an extracted directory")
        sys.exit(0)

    if dry_run:
        exit_with_dry_run_listing(extracted)

    charts_subdir = CHART_DIR / "charts"
    for name in extracted:
        shutil.rmtree(charts_subdir / name)
        print(f"Deleted charts/{name}/ (was shadowing a pinned {name}-<version>.tgz)")

    print(f"Removed {extracted_directories(len(extracted))} — re-run verify-podiumd to confirm")
    sys.exit(0)


if __name__ == "__main__":
    main()
