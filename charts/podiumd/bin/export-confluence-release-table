#!/usr/bin/env python3
"""
Export the release component tables of a Confluence page to a CSV file.

Writes charts/podiumd/etc/release-table.csv, one row per component, with
its component name and alias resolved against Chart.yaml and values.yaml.

Authentication: your Atlassian email plus a classic API token (a scoped
token does not work). Create one under profile icon > Account settings >
Security > API tokens. The token is read from --token, --token-file,
CONFLUENCE_API_TOKEN or a prompt.

Examples:
    export-confluence-release-table --url <page-url> --user <email> \\
        --token-file ~/.confluence-token
    export-confluence-release-table --recompute-image-basenames
"""

import argparse
import csv
import getpass
import os
import sys

from dataclasses import dataclass
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.paths import CHART_DIR
from lib.chart.release_baseline_basics import chart_version as read_chart_version
from lib.cli import check_output_path
from lib.cli import read_user_file
from lib.confluence_tables import ReleaseColumns
from lib.confluence_tables import TableCell
from lib.confluence_tables import effective_header_row_count
from lib.confluence_tables import expand_grid
from lib.confluence_tables import extract_tables
from lib.confluence_tables import fetch_page_html
from lib.confluence_tables import find_versie_groups
from lib.confluence_tables import header_paths
from lib.confluence_tables import is_semver_compatible
from lib.confluence_tables import major_minor
from lib.confluence_tables import missing_required_release_columns
from lib.confluence_tables import select_release_columns
from lib.confluence_tables import tables_under_headings
from lib.release_table.component_resolution import DependencyNames
from lib.release_table.component_resolution import chart_dependencies
from lib.release_table.component_resolution import component_and_alias
from lib.release_table.component_resolution import global_image_names
from lib.release_table.component_resolution import native_component_keys
from lib.release_table.component_resolution import orphan_values_yaml_keys
from lib.release_table.csv_rows import CSV_HEADER
from lib.release_table.csv_rows import release_table_records
from lib.release_table.image_basenames import resolve_image_basenames

DEFAULT_OUTPUT = CHART_DIR / "etc" / "release-table.csv"

# Overridable with --heading.
DEFAULT_HEADINGS = [
    "Product component versies",
    "Common Ground component versies",
    "Overige component versies",
    "Technische component versies",
]


# Stripped from a heading for the CSV "section" column; logs keep the full heading.
SECTION_SUFFIX = " component versies"

# Extra header rows to probe beyond effective_header_row_count(): Confluence
# sometimes tags a sub-header row ("App"/"Helm") as <td> instead of <th>.
MAX_HEADER_ROW_PROBE = 2


def resolve_header_row_count(rows: list[list[TableCell]], grid: list[list[str]]) -> int:
    """effective_header_row_count, extended by up to MAX_HEADER_ROW_PROBE rows
    until every required column resolves; the base count if none does.

    Among valid depths, a deeper one wins only if it gains an optional column
    (vendor/used_by/*_helm): a table with one column per "Versie" group
    satisfies the required columns before reaching the "Used by" row."""
    base = effective_header_row_count(rows, grid)
    best_count, best_columns = None, None
    for extra in range(MAX_HEADER_ROW_PROBE + 1):
        count = base + extra
        if count > len(grid):
            break
        columns = select_release_columns(header_paths(grid, count))
        if missing_required_release_columns(columns):
            continue
        if best_columns is None:
            best_count, best_columns = count, columns
            continue
        if any(
            columns[key] is not None and best_columns[key] is None
            for key in ("vendor", "used_by", "source_helm", "target_helm")
        ):
            best_count, best_columns = count, columns
    return best_count if best_count is not None else base


def parse_args():
    """Parse CLI args; --url and --user are required unless --recompute-image-basenames."""
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--url", help="Confluence page URL (required unless --recompute-image-basenames)")
    parser.add_argument("--user", help="Atlassian account email (required unless --recompute-image-basenames)")
    parser.add_argument("--token", help="API token (prefer --token-file or CONFLUENCE_API_TOKEN instead)")
    parser.add_argument("--token-file", help="path to a file containing just the API token")
    parser.add_argument(
        "--output", default=str(DEFAULT_OUTPUT), help="CSV output path (default: charts/podiumd/etc/release-table.csv)"
    )
    parser.add_argument(
        "--heading",
        action="append",
        help=f"only use the table(s) under this heading; repeatable (default: {', '.join(DEFAULT_HEADINGS)})",
    )
    parser.add_argument(
        "--recompute-image-basenames",
        action="store_true",
        help="only recompute the image_basename column of the existing --output CSV "
        "from the current values.yaml; no Confluence access needed",
    )
    args = parser.parse_args()
    if not args.recompute_image_basenames and not (args.url and args.user):
        parser.error("--url and --user are required unless --recompute-image-basenames is set")
    return args


def normalize_version(value: str):
    """`value` if empty or semver-compatible, else "UNKNOWN"."""
    if not value or is_semver_compatible(value):
        return value
    return "UNKNOWN"


def section_name(heading: str):
    """`heading` without SECTION_SUFFIX: "Product component versies" -> "Product"."""
    return heading.removesuffix(SECTION_SUFFIX)


def check_target_matches_chart_version(target_labels: list[str], chart_dir: Path) -> None:
    """Warn on stderr for each target label whose MAJOR.MINOR differs from Chart.yaml's version.

    Never raises. Silent only when chart_dir has no Chart.yaml (tests); an
    unparseable chart version or no target labels at all warns instead.
    """
    chart_yaml_path = chart_dir / "Chart.yaml"
    if not chart_yaml_path.is_file():
        return
    chart_version = read_chart_version(chart_yaml_path)
    chart_major_minor = major_minor(chart_version)
    if chart_major_minor is None:
        print(
            f"WARNING: could not verify Confluence target version against Chart.yaml — "
            f'its own "version: {chart_version}" isn\'t a valid MAJOR.MINOR(.PATCH)'
        )
        return
    if not target_labels:
        print(
            "WARNING: could not verify Confluence target version against Chart.yaml — "
            'no table\'s "Versie ..." heading yielded a resolvable target-version group'
        )
        return

    mismatched = sorted({label for label in target_labels if major_minor(label) != chart_major_minor})
    if not mismatched:
        return

    border = "!" * 72
    print(border, file=sys.stderr)
    print("!! WARNING: Confluence target version does NOT match Chart.yaml !!", file=sys.stderr)
    print(f"!!   Chart.yaml version:        {chart_version}  (major.minor {chart_major_minor})", file=sys.stderr)
    for label in mismatched:
        print(f"!!   Confluence target heading: {label!r}  (major.minor {major_minor(label)})", file=sys.stderr)
    print(border, file=sys.stderr)


def recompute_image_basenames(csv_path: Path, chart_dir: Path) -> list[tuple[str, str, str, str]]:
    """Recompute only the image_basename column of `csv_path` in place from current values.yaml.

    No Confluence access. Returns [(name, component, old, new), ...] for changed
    rows in file order. Raises SystemExit if csv_path is missing or its header
    is not CSV_HEADER.
    """
    rows = _read_csv_rows(csv_path)

    # resolve_image_basenames expects rows without image_basename (it inserts it by position).
    basename_idx = CSV_HEADER.index("image_basename")
    stripped = [row[:basename_idx] + row[basename_idx + 1 :] for row in rows]
    new_basenames = resolve_image_basenames(stripped, chart_dir)

    name_idx, component_idx = CSV_HEADER.index("name"), CSV_HEADER.index("component")
    changes = _apply_new_basenames(rows, new_basenames, basename_idx, name_idx, component_idx)

    _write_csv_rows(csv_path, rows)
    return changes


def _read_csv_rows(csv_path: Path) -> list[list[str]]:
    """Data rows of `csv_path`; SystemExit if missing or its header is not CSV_HEADER."""
    if not csv_path.is_file():
        msg = f"error: {csv_path} does not exist — nothing to recompute"
        raise SystemExit(msg)
    return [values for _line_num, values in release_table_records(csv_path)]


def _write_csv_rows(csv_path: Path, rows: list[list[str]]):
    """Writes CSV_HEADER + `rows` to `csv_path`, LF-terminated."""
    with csv_path.open("w", newline="", encoding="utf-8") as f:
        # csv defaults to CRLF; LF so re-exports produce no spurious diffs.
        writer = csv.writer(f, lineterminator="\n")
        writer.writerow(CSV_HEADER)
        writer.writerows(rows)


def _apply_new_basenames(
    rows: list[list[str]], new_basenames: list[str], basename_idx: int, name_idx: int, component_idx: int
) -> list[tuple[str, str, str, str]]:
    """Set image_basename (at basename_idx) from `new_basenames`; return [(name, component, old, new), ...] changes."""
    changes: list[tuple[str, str, str, str]] = []
    for row, new_basename in zip(rows, new_basenames, strict=False):
        old_basename = row[basename_idx]
        if new_basename != old_basename:
            changes.append((row[name_idx], row[component_idx], old_basename, new_basename))
            row[basename_idx] = new_basename
    return changes


def apply_native_helm_marker(rows: list[list[str]]) -> None:
    """Set both helm columns to "NATIVE" on primary rows of a single resolved component with no helm versions.

    Distinguishes a component without its own Helm chart (e.g. frankgateway)
    from a table without a Helm column; both would otherwise be blank.
    """
    for row in rows:
        used_by, component = row[CSV_HEADER.index("used_by")], row[CSV_HEADER.index("component")]
        if used_by or component in ("MULTIPLE", "UNKNOWN", ""):
            continue
        source_idx, target_idx = CSV_HEADER.index("source_version_helm"), CSV_HEADER.index("target_version_helm")
        if not row[source_idx] and not row[target_idx]:
            row[source_idx] = "NATIVE"
            row[target_idx] = "NATIVE"


def resolve_token(args: argparse.Namespace):
    """Token from --token-file, --token, CONFLUENCE_API_TOKEN, or a prompt, in that order.

    Raises SystemExit when --token-file is unreadable or empty, or the prompt is aborted.
    """
    if args.token_file:
        token = read_user_file(Path(args.token_file).expanduser(), "--token-file").strip()
        if not token:
            msg = f"error: --token-file {args.token_file} is empty"
            raise SystemExit(msg)
        return token
    if args.token:
        return args.token
    env_token = os.environ.get("CONFLUENCE_API_TOKEN")
    if env_token:
        return env_token
    try:
        return getpass.getpass("Confluence API token: ")
    except (KeyboardInterrupt, EOFError) as e:
        msg = "error: no Confluence API token given"
        raise SystemExit(msg) from e


@dataclass
class ComponentResolutionContext:
    """component_and_alias inputs, resolved once and shared by every row."""

    dependencies: list[DependencyNames]
    orphan_keys: list[DependencyNames]
    global_keys: list[str]
    native_keys: list[DependencyNames]


def extract_release_rows(
    html: str, headings: list[str] | None = None, chart_dir: Path | None = None
) -> list[list[str]]:
    """CSV data rows from every table under one of `headings` that has the required App columns.

    Tables without a Helm column export blank helm cells (see
    apply_native_helm_marker for "NATIVE"). Prints a report per table, warns
    when a target heading mismatches Chart.yaml, and warns per row on UNKNOWN
    components/versions, unresolved MULTIPLE basenames and duplicate
    (component, image_basename) pairs.
    """
    headings = headings or DEFAULT_HEADINGS
    chart_dir = chart_dir or CHART_DIR
    dependencies = chart_dependencies(chart_dir)
    context = ComponentResolutionContext(
        dependencies,
        orphan_values_yaml_keys(chart_dir, dependencies),
        global_image_names(chart_dir),
        native_component_keys(chart_dir),
    )
    all_tables = extract_tables(html)
    if not all_tables:
        msg = "error: no <table> found on that page"
        raise SystemExit(msg)

    matching = tables_under_headings(all_tables, headings)
    print(f"Found {len(all_tables)} table(s) on the page, {len(matching)} under a matching heading")
    if not matching:
        msg = f"error: no table found directly under any of: {', '.join(headings)}"
        raise SystemExit(msg)

    rows_out, unknown_count, target_labels = _rows_for_tables(matching, context)

    check_target_matches_chart_version(target_labels, chart_dir)

    if not rows_out:
        msg = (
            "error: every matching-heading table was missing a required column "
            "(source/target Versie ... App) — see the skip reason(s) above"
        )
        raise SystemExit(msg)
    if unknown_count:
        print(f"{unknown_count} version value(s) were not semver-compatible — replaced with UNKNOWN")

    _insert_resolved_basenames(rows_out, chart_dir)
    apply_native_helm_marker(rows_out)
    _warn_duplicate_component_basename_pairs(rows_out)

    return rows_out


def _rows_for_tables(
    matching: list[tuple[str, list[list[TableCell]]]], context: ComponentResolutionContext
) -> tuple[list[list[str]], int, list[str]]:
    """(all data rows, non-semver cell count, target labels) over every matched table."""
    rows_out: list[list[str]] = []
    unknown_count = 0
    target_labels: list[str] = []
    for heading, rows in matching:
        table_rows, table_unknown_count, target_label = _rows_for_table(heading, rows, context)
        rows_out.extend(table_rows)
        unknown_count += table_unknown_count
        if target_label is not None:
            target_labels.append(target_label)
    return rows_out, unknown_count, target_labels


def _rows_for_table(
    heading: str, rows: list[list[TableCell]], context: ComponentResolutionContext
) -> tuple[list[list[str]], int, str | None]:
    """(rows without image_basename, non-semver cell count, target label) for one table.

    ([], 0, label) when a required column is missing. Prints a one-line report.
    """
    grid = expand_grid(rows)
    header_row_count = resolve_header_row_count(rows, grid)
    paths = header_paths(grid, header_row_count)
    groups = find_versie_groups(paths)
    target_label = groups[1][0] if len(groups) == 2 else None
    columns = select_release_columns(paths)
    missing = missing_required_release_columns(columns)
    if missing:
        print(f'"{heading}": skipped (missing required column(s): {", ".join(missing)})')
        return [], 0, target_label

    rows_out: list[list[str]] = []
    unknown_count = 0
    for data_row in grid[header_row_count:]:
        if not any(cell.strip() for cell in data_row):
            continue
        row, row_unknown_count = _release_row_from_data_row(data_row, heading, columns, context)
        rows_out.append(row)
        unknown_count += row_unknown_count
    print(f'"{heading}": {len(rows_out)} row(s) matched')
    return rows_out, unknown_count, target_label


def _column_text(data_row: list[str], index: int | None) -> str:
    """Cell at `index`, "" when the table lacks the column (None)."""
    return data_row[index] if index is not None else ""


def _release_row_from_data_row(
    data_row: list[str], heading: str, columns: ReleaseColumns, context: ComponentResolutionContext
) -> tuple[list[str], int]:
    """(CSV row without image_basename, non-semver cell count); warns on UNKNOWN values."""
    vendor = _column_text(data_row, columns["vendor"])
    used_by = _column_text(data_row, columns["used_by"])
    name = _column_text(data_row, columns["first"])
    # used_by is often a literal Chart.yaml alias; a Technische row's name ("Solr") rarely matches.
    component, alias = component_and_alias(
        used_by or name, context.dependencies, context.orphan_keys, context.global_keys, context.native_keys
    )
    if component == "UNKNOWN":
        used_by_suffix = f' (used_by "{used_by}")' if used_by else ""
        print(
            f'WARNING: "{name}"{used_by_suffix} did not resolve to any Chart.yaml '
            f"dependency, orphan values.yaml key, or global image key"
        )
    version_columns = ("source_version_app", "source_version_helm", "target_version_app", "target_version_helm")
    versions = [
        normalize_version(_column_text(data_row, columns[key]))
        for key in ("source_app", "source_helm", "target_app", "target_helm")
    ]
    for column_name, value in zip(version_columns, versions, strict=False):
        if value == "UNKNOWN":
            print(f'WARNING: "{name}": {column_name} is not semver-compatible — replaced with UNKNOWN')
    unknown_count = sum(1 for v in versions if v == "UNKNOWN")
    return [section_name(heading), vendor, used_by, name, component, alias, *versions], unknown_count


def _insert_resolved_basenames(rows_out: list[list[str]], chart_dir: Path) -> None:
    """Insert each row's image_basename.

    Warns for MULTIPLE rows without one: nothing downstream would catch the
    untracked image, and fixing it needs a Confluence edit, so not an error.
    """
    basenames = resolve_image_basenames(rows_out, chart_dir)
    for row, basename in zip(rows_out, basenames, strict=False):
        if row[4] == "MULTIPLE" and not basename:
            print(
                f'WARNING: "{row[3]}" resolved to MULTIPLE but no image_basename could be '
                f"resolved — its image will be untracked in {DEFAULT_OUTPUT.name}"
            )
        row.insert(6, basename)


def _warn_duplicate_component_basename_pairs(rows_out: list[list[str]]) -> None:
    """Warn for each (component, basename) pair shared by several rows; blank values are skipped."""
    by_pair: dict[tuple[str, str], list[str]] = {}
    for row in rows_out:
        component, basename = row[4], row[6]
        if component and basename:
            by_pair.setdefault((component, basename), []).append(row[3])
    for (component, basename), names in sorted(by_pair.items()):
        if len(names) > 1:
            print(
                f'WARNING: {len(names)} rows all resolve to the same component "{component}" + '
                f'image "{basename}": {", ".join(names)}'
            )


def warn_unknown_lines(rows: list[list[str]], csv_path: Path | str) -> None:
    """Warn on stderr for each row (by file line number) that has UNKNOWN in any column."""
    unknown = [
        (line, row[3], [column for column, value in zip(CSV_HEADER, row, strict=False) if value == "UNKNOWN"])
        for line, row in enumerate(rows, start=2)
        if "UNKNOWN" in row
    ]
    if not unknown:
        return
    print(f"WARNING: {len(unknown)} line(s) in {csv_path} contain UNKNOWN:", file=sys.stderr)
    for line, name, columns in unknown:
        print(f'  line {line}: "{name}" ({", ".join(columns)})', file=sys.stderr)


def main():
    """CLI entry point."""
    args = parse_args()

    if args.recompute_image_basenames:
        changes = recompute_image_basenames(Path(args.output), CHART_DIR)
        if changes:
            print(f"Recomputed image_basename for {len(changes)} row(s) in {args.output}:")
            for name, component, old, new in changes:
                print(f'  {component} ("{name}"): {old!r} -> {new!r}')
        else:
            print(f"No image_basename values changed in {args.output}.")
        warn_unknown_lines(_read_csv_rows(Path(args.output)), args.output)
        return

    output_path = Path(args.output)
    check_output_path(output_path, "--output")
    token = resolve_token(args)

    html = fetch_page_html(args.url, args.user, token)
    rows = extract_release_rows(html, args.heading)

    _write_csv_rows(output_path, rows)

    print(f"Wrote {len(rows)} row(s) to {output_path}")
    warn_unknown_lines(rows, output_path)


if __name__ == "__main__":
    main()
