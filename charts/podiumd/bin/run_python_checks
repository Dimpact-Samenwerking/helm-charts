#!/usr/bin/env bash
#
# Runs every check from README-coding.md's own "Before committing" section,
# stopping at the first failure. Ordered fastest-first (measured, not
# guessed): ruff check (~0.03s) -> ruff format --check (~0.05s) ->
# pymarkdown (~0.5s) -> vulture (~0.5s) -> bandit (~1.7s) -> pylint (~6s) -> basedpyright (~8.6s) ->
# pytest (the full suite, ~2-3 minutes) -- so a real problem in the cheap
# checks fails in well under a second instead of waiting on the full test
# run first. See README-coding.md for what each one covers and why.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: run_python_checks [-h|--help]

Runs ruff check, ruff format --check, pymarkdown, vulture, bandit, pylint,
basedpyright, and pytest against this charts/podiumd/bin/ toolset, fastest first, stopping
at the first failure. Must be run from charts/podiumd/bin/ itself (or
invoked as ./run_python_checks from there) -- see README-coding.md.
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

cd "$(dirname "${BASH_SOURCE[0]}")"

# Read into arrays so every file name stays one argument (SC2046).
mapfile -t python_scripts < <(find . -maxdepth 1 -type f -perm -u+x -exec grep -l '^#!.*python' {} +)
mapfile -t test_files < <(find tests -name '*.py')

# ruff only auto-discovers *.py files -- the extensionless top-level
# scripts need to be passed explicitly too, same as vulture/pylint below.
echo "=== ruff check ==="
ruff check . "${python_scripts[@]}"

echo "=== ruff format --check ==="
ruff format --check . "${python_scripts[@]}"

# Same rules and plugin settings as verify-podiumd's markdown check, read
# from lib so the two can't drift. That check skips bin/, so bin/'s own
# docs are linted here.
echo "=== pymarkdown (bin/*.md) ==="
mapfile -t pymarkdown_args < <(python3 -c '
from lib.chart.paths import CHART_DIR
from lib.checks.markdown import MARKDOWN_PLUGIN_SETTINGS
from lib.settings import quality_gates_markdown_disabled_rules
print("-d", ",".join(quality_gates_markdown_disabled_rules(CHART_DIR)), *MARKDOWN_PLUGIN_SETTINGS, sep="\n")')
pymarkdown "${pymarkdown_args[@]}" scan ./*.md

# vulture never connects a TypedDict key read only by string key
# (row["app"]) to its declaration, so every field of every TypedDict class
# in lib/ and the scripts goes into a generated whitelist -- exactly those
# names, derived from the code, so it can't drift.
typeddict_whitelist=$(mktemp --suffix=.py)
trap 'rm -f "$typeddict_whitelist"' EXIT
python3 - lib "${python_scripts[@]}" > "$typeddict_whitelist" <<'PY'
import ast
import pathlib
import sys

classes = []
for arg in sys.argv[1:]:
    path = pathlib.Path(arg)
    for f in [path] if path.is_file() else sorted(path.rglob("*.py")):
        classes += [n for n in ast.walk(ast.parse(f.read_text(encoding="utf-8"))) if isinstance(n, ast.ClassDef)]
typeddicts = {"TypedDict"}
while True:
    found = {c.name for c in classes if any(isinstance(b, ast.Name) and b.id in typeddicts for b in c.bases)}
    if found <= typeddicts:
        break
    typeddicts |= found
for c in classes:
    if c.name in typeddicts:
        for st in c.body:
            if isinstance(st, ast.AnnAssign) and isinstance(st.target, ast.Name):
                print(st.target.id)
PY

echo "=== vulture (dead code) ==="
vulture lib "${python_scripts[@]}" "$typeddict_whitelist"

# tests/ excluded, same as vulture above -- every `assert` statement would
# otherwise flag B101 (assert_used), dominating any real signal.
echo "=== bandit (security) ==="
bandit -c pyproject.toml -r lib "${python_scripts[@]}" -q

# Two invocations: lib/ and the top-level scripts get the full default
# pylint rule set; tests/ runs with TESTS_PYLINT_DISABLE on top. See
# pyproject.toml's own [tool.pylint."messages control"] comment for why this
# can't be scoped in the config file itself.
#
# False positives under tests/ (pytest fixture signatures, sys.path-hack
# conftest imports, shared assertion boilerplate):
TESTS_PYLINT_DISABLE=missing-function-docstring,wrong-import-position,unused-argument,protected-access
TESTS_PYLINT_DISABLE=$TESTS_PYLINT_DISABLE,unused-variable,redefined-outer-name,duplicate-code
# Style and structure rules not enforced for test code (pytest and ruff
# still cover tests/):
TESTS_PYLINT_DISABLE=$TESTS_PYLINT_DISABLE,import-outside-toplevel,consider-using-from-import
TESTS_PYLINT_DISABLE=$TESTS_PYLINT_DISABLE,use-implicit-booleaness-not-comparison,too-many-positional-arguments
TESTS_PYLINT_DISABLE=$TESTS_PYLINT_DISABLE,too-many-arguments,too-many-locals,import-error,superfluous-parens
TESTS_PYLINT_DISABLE=$TESTS_PYLINT_DISABLE,too-many-lines,subprocess-run-check,missing-class-docstring
TESTS_PYLINT_DISABLE=$TESTS_PYLINT_DISABLE,useless-return,unnecessary-lambda,too-few-public-methods
TESTS_PYLINT_DISABLE=$TESTS_PYLINT_DISABLE,line-too-long,comparison-of-constants
echo "=== pylint (lib + scripts) ==="
pylint lib "${python_scripts[@]}"

echo "=== pylint (tests) ==="
# lib isn't a target here, so its imports need PYTHONPATH (not an analyzed
# target list) to resolve -- otherwise pylint can't see lib.* at all and
# every cross-package import raises a false import-error.
PYTHONPATH=. pylint --disable="$TESTS_PYLINT_DISABLE" "${test_files[@]}"

echo "=== basedpyright (type checking) ==="
basedpyright lib "${python_scripts[@]}" tests

echo "=== pytest ==="
python3 -m pytest -q

echo "=== all checks passed ==="
