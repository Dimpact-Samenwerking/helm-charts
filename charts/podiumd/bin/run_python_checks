#!/usr/bin/env bash
#
# Runs README-coding.md's "Before committing" checks, fastest first
# (measured), stopping at the first failure. Tool settings live in
# pyproject.toml and .jscpd.json.
set -euo pipefail

usage() {
    cat <<'HELP'
Usage: run_python_checks [-h|--help]

Upgrades pip and the tools in requirements.txt, then runs ruff check,
shellcheck, ruff format --check, flake8 (wemake-python-styleguide), deptry, jscpd,
pymarkdown, vulture, bandit, basedpyright, pylint and pytest with coverage
on charts/podiumd/bin/, fastest first. Stops at the first failure. Then
pip-audit on the installed packages, as a warning only. Run from
charts/podiumd/bin/.
HELP
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

cd "$(dirname "${BASH_SOURCE[0]}")"

# Prints the step's name, runs it and prints its time, to keep the
# fastest-first order honest; set -e stops at a failure.
step() {
    local name=$1 start=${EPOCHREALTIME//[!0-9]/}
    shift
    echo "=== $name ==="
    "$@"
    local hundredths=$(((${EPOCHREALTIME//[!0-9]/} - start) / 10000))
    printf '    (%d.%02d s)\n' $((hundredths / 100)) $((hundredths % 100))
}

# requirements.txt is unpinned: local runs and CI check with the same,
# newest tool versions.
step "pip install --upgrade" python3 -m pip install --quiet --disable-pip-version-check --upgrade pip -r requirements.txt

# Arrays keep each file name one argument (SC2046). set -e misses failures
# inside <(...), so `wait "$!"` checks each one (SC2312).
# Extensionless Python scripts must be passed to every tool explicitly.
mapfile -t python_scripts < <(find . -maxdepth 1 -type f -perm -u+x -exec grep -l '^#!.*python' {} +)
wait "$!"
mapfile -t test_files < <(find tests -name '*.py')
wait "$!"
# Shell scripts: sh/bash/dash/ksh shebang, or *.sh.
mapfile -t shell_scripts < <(
    find . -path ./.venv -prune -o -path '*/__pycache__' -prune -o -type f -print0 |
        xargs -0 awk 'FNR == 1 && (/^#!.*[\/ ](ba|da|k)?sh([ \t]|$)/ || FILENAME ~ /\.sh$/) {print FILENAME} {nextfile}' |
        sort
)
wait "$!"
code=(lib "${python_scripts[@]}")

# Same rules as verify-podiumd's markdown check, which skips bin/.
mapfile -t pymarkdown_args < <(python3 -c '
from lib.chart.paths import CHART_DIR
from lib.checks.markdown import pymarkdown_rule_args
print(*pymarkdown_rule_args(CHART_DIR), sep="\n")')
wait "$!"

# vulture doesn't link TypedDict fields to string-key reads (row["app"]).
typeddict_whitelist=$(mktemp --suffix=.py)
trap 'rm -f "$typeddict_whitelist"' EXIT
python3 -c '
import sys
from pathlib import Path
from lib.python_checks import typeddict_field_names
print(*typeddict_field_names([Path(p) for p in sys.argv[1:]]), sep="\n")' "${code[@]}" >"$typeddict_whitelist"

tests_pylint_disable=$(python3 -c '
from pathlib import Path
from lib.python_checks import pylint_disable_for_tests
print(pylint_disable_for_tests(Path("pyproject.toml")))')

step "ruff check" ruff check . "${python_scripts[@]}"
if ((${#shell_scripts[@]})); then
    step "shellcheck (${#shell_scripts[@]} shell script(s))" shellcheck "${shell_scripts[@]}"
fi
step "ruff format --check" ruff format --check . "${python_scripts[@]}"
# Settings in pyproject.toml [tool.flake8] (flake8-pyproject).
step "flake8 (wemake-python-styleguide and plugins)" flake8 lib tests "${python_scripts[@]}"
step "deptry (dependencies in requirements.txt)" deptry . --requirements-files requirements.txt
step "jscpd (duplicate code)" jscpd "${code[@]}"
step "pymarkdown (bin/*.md)" pymarkdown "${pymarkdown_args[@]}" scan ./*.md
step "vulture (dead code)" vulture "${code[@]}" "$typeddict_whitelist"
# tests/ excluded: every assert would flag B101.
step "bandit (security)" bandit -c pyproject.toml -r "${code[@]}" -q
step "basedpyright (type checking)" basedpyright "${code[@]}" tests
step "pylint (lib + scripts)" pylint "${code[@]}"
# PYTHONPATH lets pylint resolve lib.* imports without analyzing lib.
step "pylint (tests)" env PYTHONPATH=. pylint --disable="$tests_pylint_disable" "${test_files[@]}"
# The threshold is [tool.coverage.report] fail_under in pyproject.toml.
step "pytest (with coverage)" python3 -m pytest -q --cov --cov-report=term-missing:skip-covered

# A warning only: a new advisory fails it without a code change, and that must
# not block commits or PRs. The podiumd-pip-audit workflow reports it. Own
# cache: pip-audit cannot read the cache entries of a newer pip.
echo "=== pip-audit (installed packages, warning only) ==="
if python3 -c 'import socket; socket.create_connection(("pypi.org", 443), 5).close()' 2>/dev/null; then
    pip-audit --progress-spinner off --cache-dir ../.cache/pip-audit ||
        echo "WARNING: pip-audit found known vulnerabilities: upgrade the package named above"
else
    echo "WARNING: pypi.org not reachable, pip-audit skipped"
fi

echo "=== all checks passed ==="
