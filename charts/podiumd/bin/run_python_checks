#!/usr/bin/env bash
#
# Runs README-coding.md's "Before committing" checks, all at the same time,
# and lists every failed step. Tool settings live in pyproject.toml and
# .jscpd.json.
set -euo pipefail

usage() {
    cat <<'HELP'
Usage: run_python_checks [-h|--help]

Upgrades pip and the tools in requirements.txt, then runs ruff check,
shellcheck, ruff format --check, flake8 (wemake-python-styleguide), deptry,
jscpd, pymarkdown, vulture, bandit, basedpyright, pylint, pytest with
coverage and pip-audit (only warns) on charts/podiumd/bin/, all at the same
time; prints each step's log in that order and lists every failed step.
HELP
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

cd "$(dirname "${BASH_SOURCE[0]}")"

# requirements.txt is unpinned: local runs and CI check with the same,
# newest tool versions.
echo "=== pip install --upgrade ==="
python3 -m pip install --quiet --disable-pip-version-check --upgrade pip -r requirements.txt

# Arrays keep each file name one argument (SC2046). set -e misses failures
# inside <(...), so `wait "$!"` checks each one (SC2312).
# Extensionless Python scripts must be passed to every tool explicitly.
mapfile -t python_scripts < <(find . -maxdepth 1 -type f -perm -u+x -exec grep -l '^#!.*python' {} +)
wait "$!"
mapfile -t test_files < <(find tests -name '*.py')
wait "$!"
# Shell scripts: sh/bash/dash/ksh shebang, or *.sh.
mapfile -t shell_scripts < <(
    find . -path ./.venv -prune -o -path '*/__pycache__' -prune -o -type f -print0 |
        xargs -0 awk 'FNR == 1 && (/^#!.*[\/ ](ba|da|k)?sh([ \t]|$)/ || FILENAME ~ /\.sh$/) {print FILENAME} {nextfile}' |
        sort
)
wait "$!"
code=(lib "${python_scripts[@]}")

# Same rules as verify-podiumd's markdown check, which skips bin/.
mapfile -t pymarkdown_args < <(python3 -c '
from lib.chart.paths import CHART_DIR
from lib.checks.markdown import pymarkdown_rule_args
print(*pymarkdown_rule_args(CHART_DIR), sep="\n")')
wait "$!"

# Each check is a step function. Its output goes to its own log; the logs are
# printed in order once every step has ended.
logs=$(mktemp -d)
trap 'rm -rf "$logs"' EXIT

# vulture doesn't link TypedDict fields to string-key reads (row["app"]).
typeddict_whitelist="$logs/typeddict_whitelist.py"
python3 -c '
import sys
from pathlib import Path
from lib.python_checks import typeddict_field_names
print(*typeddict_field_names([Path(p) for p in sys.argv[1:]]), sep="\n")' "${code[@]}" >"$typeddict_whitelist"

tests_pylint_disable=$(python3 -c '
from pathlib import Path
from lib.python_checks import pylint_disable_for_tests
print(pylint_disable_for_tests(Path("pyproject.toml")))')

step_ruff_check() { ruff check . "${python_scripts[@]}"; }

step_shellcheck() {
    if ((${#shell_scripts[@]})); then
        shellcheck "${shell_scripts[@]}"
    fi
}

step_ruff_format() { ruff format --check . "${python_scripts[@]}"; }

# Settings in pyproject.toml [tool.flake8] (flake8-pyproject).
step_flake8() { flake8 lib tests "${python_scripts[@]}"; }

step_deptry() { deptry . --requirements-files requirements.txt; }

step_jscpd() { jscpd "${code[@]}"; }

step_pymarkdown() { pymarkdown "${pymarkdown_args[@]}" scan ./*.md; }

step_vulture() { vulture "${code[@]}" "$typeddict_whitelist"; }

# tests/ excluded: every assert would flag B101.
step_bandit() { bandit -c pyproject.toml -r "${code[@]}" -q; }

step_basedpyright() { basedpyright "${code[@]}" tests; }

# -j 0: one process per CPU.
step_pylint() { pylint -j 0 "${code[@]}"; }

# PYTHONPATH lets pylint resolve lib.* imports without analyzing lib.
step_pylint_tests() { env PYTHONPATH=. pylint -j 0 --disable="$tests_pylint_disable" "${test_files[@]}"; }

# The threshold is [tool.coverage.report] fail_under in pyproject.toml. More
# than 8 workers start slower than they gain.
step_pytest() { python3 -m pytest -q -n auto --maxprocesses 8 --cov --cov-report=term-missing:skip-covered; }

# A warning only: a new advisory fails it without a code change, and that must
# not block commits or PRs. The podiumd-pip-audit workflow reports it. Own
# cache: pip-audit cannot read the cache entries of a newer pip.
step_pip_audit() {
    if python3 -c 'import socket; socket.create_connection(("pypi.org", 443), 5).close()' 2>/dev/null; then
        pip-audit --progress-spinner off --cache-dir ../.cache/pip-audit ||
            echo "WARNING: pip-audit found known vulnerabilities: upgrade the package named above"
    else
        echo "WARNING: pypi.org not reachable, pip-audit skipped"
    fi
}

# Runs one step, its output in its own log; records "<seconds> ok|FAILED".
run_step() {
    local start=$SECONDS
    if "step_$1" >"$logs/$1.log" 2>&1; then
        echo "$((SECONDS - start)) ok" >"$logs/$1.status"
    else
        echo "$((SECONDS - start)) FAILED" >"$logs/$1.status"
        return 1
    fi
}

# All steps start at the same time (every step is short, so fail-fast groups
# take longer), and the run lists every failed step. pip-audit mostly waits on
# PyPI and never fails.
steps=(
    ruff_check shellcheck ruff_format flake8 deptry jscpd pymarkdown vulture bandit
    basedpyright pylint pylint_tests pytest pip_audit
)
pids=()
for name in "${steps[@]}"; do
    run_step "$name" &
    pids+=("$!")
done
for pid in "${pids[@]}"; do
    wait "$pid" || true
done
failed=()
for name in "${steps[@]}"; do
    read -r seconds status <"$logs/$name.status"
    echo "=== $name (${seconds}s, $status) ==="
    cat "$logs/$name.log"
    [[ $status == ok ]] || failed+=("$name")
done
if ((${#failed[@]})); then
    echo "=== FAILED: ${failed[*]} ==="
    exit 1
fi
echo "=== all checks passed ==="
