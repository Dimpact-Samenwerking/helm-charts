#!/usr/bin/env python3
"""
Fix markdown lint findings in charts/podiumd/ with `pymarkdown fix`.

Runs on the same *.md files verify-podiumd's "Markdown lint" step checks
(vendored sub-chart docs and the generated README.md excluded). Only
fixes what pymarkdown can fix safely; MD031 is never fixed. Findings
that need a human (e.g. MD024, MD040) stay for verify-podiumd to report.

Usage:
    fix-markdown [--dry-run]

Options:
    --dry-run   report what would change, write nothing
"""

import shutil
import sys
import tempfile

from pathlib import Path
from typing import NoReturn

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.paths import CHART_DIR
from lib.checks.markdown import MARKDOWN_PLUGIN_SETTINGS
from lib.checks.markdown import find_markdown_files
from lib.checks.markdown import find_pymarkdown
from lib.cli import flag_args
from lib.procutil import run
from lib.settings import gate_markdown_disabled


def run_fix(pymarkdown: str, files: list[Path], disabled_rules: str):
    """Run `pymarkdown fix` in place; return the paths it reported as "Fixed: <path>".

    `disabled_rules` must include md031: its fix action crashes on
    docs/_UPGRADE_PATHS/4.6.6-to-4.7.3-upgrade.md (BadPluginError).
    Detection stays on in verify-podiumd.
    """
    result = run(
        [pymarkdown, "-d", disabled_rules, *MARKDOWN_PLUGIN_SETTINGS, "fix", *[str(md_file) for md_file in files]],
        capture_output=True,
        text=True,
    )
    output = result.stdout + result.stderr
    fixed_lines = [line for line in output.splitlines() if line.startswith("Fixed: ")]
    return [Path(line.removeprefix("Fixed: ").strip()) for line in fixed_lines]


def dry_run_fix(pymarkdown: str, files: list[Path], chart_dir: Path, disabled_rules: str) -> list[Path]:
    """Relative paths of files the fix would change, by fixing copies in a tmpdir."""
    with tempfile.TemporaryDirectory() as tmp:
        tmp_dir = Path(tmp)
        tmp_files: list[Path] = []
        for md_file in files:
            rel = md_file.relative_to(chart_dir)
            tmp_path = tmp_dir / rel
            tmp_path.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(md_file, tmp_path)
            tmp_files.append(tmp_path)

        run_fix(pymarkdown, tmp_files, disabled_rules)

        changed: list[Path] = []
        for md_file in files:
            rel = md_file.relative_to(chart_dir)
            if md_file.read_bytes() != (tmp_dir / rel).read_bytes():
                changed.append(rel)
        return changed


def exit_with_dry_run_result(pymarkdown: str, files: list[Path], disabled_rules: str) -> NoReturn:
    """List the files the fix would change; exit 1 when there are any."""
    changed = dry_run_fix(pymarkdown, files, CHART_DIR, disabled_rules)
    if not changed:
        print("OK: nothing pymarkdown fix could resolve (dry-run)")
        sys.exit(0)
    print(f"{len(changed)} file(s) would be fixed (dry-run, not writing):")
    for rel in sorted(changed):
        print(f"  {rel}")
    sys.exit(1)


def exit_with_fix_result(pymarkdown: str, files: list[Path], disabled_rules: str) -> NoReturn:
    """Fix `files` in place and list the fixed ones."""
    fixed = run_fix(pymarkdown, files, disabled_rules)
    if not fixed:
        print("OK: nothing pymarkdown fix could resolve")
        sys.exit(0)

    print(f"Fixed {len(fixed)} file(s):")
    for path in sorted(fixed):
        try:
            rel = path.relative_to(CHART_DIR)
        except ValueError:
            rel = path
        print(f"  {rel}")
    print(
        "\nSome findings (MD024, MD031, MD032, MD033, MD036, MD040, MD041, MD025, "
        "...) need human judgment and are left for verify-podiumd's markdown check "
        "to keep reporting."
    )
    sys.exit(0)


def main():
    """CLI entry point."""
    dry_run = "--dry-run" in flag_args(__doc__, "--dry-run")

    pymarkdown = find_pymarkdown(CHART_DIR)
    if pymarkdown is None:
        print("pymarkdown is not installed (see README-release-process.md#setup)")
        sys.exit(1)

    files = find_markdown_files(CHART_DIR)
    if not files:
        print("OK: no markdown files found")
        sys.exit(0)

    # md031's FIX action crashes on a real doc here — see run_fix.
    disabled_rules = ",".join([*gate_markdown_disabled(CHART_DIR), "md031"])

    if dry_run:
        exit_with_dry_run_result(pymarkdown, files, disabled_rules)
    exit_with_fix_result(pymarkdown, files, disabled_rules)


if __name__ == "__main__":
    main()
