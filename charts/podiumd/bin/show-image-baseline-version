#!/usr/bin/env python3
"""
Show the image version(s) pinned for <key> <basename> at BOTH recorded
release-baseline.yaml baselines (upgrade_docs and release_table — see
lib.chart for what each means) — useful for finding out what a release
actually shipped before writing an upgrade doc's "source" column, without
checking out that release or digging through git history by hand.

<key> is either a Chart.yaml dependency's own top-level values.yaml key
(a component, e.g. "openklant", "zac") or the literal "MULTIPLE" — the
same convention release-table.csv itself uses (see export-confluence-
release-table's component_and_alias) for a base image shared across
several unrelated components via values.yaml's global.images anchor
block. <key> <basename> together must resolve to exactly one real image
pin under that scope, at whichever baseline is being shown — the same
resolution update-image-version/verify-image-version's own <key>
<basename> use (lib.image_version.resolve_scoped_matches), just applied
to values.yaml text as it was at each baseline's ref (via `git show`)
instead of the current file. Same narrower scope (one image, not a whole
component) as update-image-version/verify-image-version have relative to
update-component-version/verify-component-version — see
show-component-baseline-version instead for a component's Helm chart
version plus every image path it declares.

Usage:
    show-image-baseline-version <key> <basename>

Examples:
    show-image-baseline-version zac zaakafhandelcomponent
    show-image-baseline-version keycloak-operator python
    show-image-baseline-version MULTIPLE curl

Each baseline is a bare version (e.g. "4.8.5"), resolved to the
podiumd-4.8.5 git tag, falling back to the feature/podiumd-4.8.5 /
origin/feature/podiumd-4.8.5 branch if the tag doesn't exist yet. A
baseline missing from release-baseline.yaml is skipped (noted, not an
error); a baseline where <key> <basename> doesn't resolve uniquely (not
pinned there yet, or removed since) is also just noted, not fatal — this
only fails outright if NEITHER baseline could show anything at all.
Reads charts/podiumd/values.yaml as it was at each ref via `git show` —
no checkout needed.
"""
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from lib.baseline_report import show_baseline_section
from lib.chart import release_table_baseline as read_release_table_baseline
from lib.chart import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.gitutil import find_repo_root as _find_repo_root
from lib.image_version import resolve_scoped_matches
from lib.release_baseline import resolve_baseline_values

RELATIVE_CHART_DIR = "charts/podiumd"


def find_repo_root():
    repo_root = _find_repo_root(Path(__file__).resolve().parent)
    if repo_root is None:
        raise SystemExit("error: not inside a git repository")
    return repo_root


def show_at_baseline(chart_dir, label, baseline, key, basename):
    """Prints <key> <basename>'s resolved pin(s) at `baseline` (labeled
    `label`, "upgrade_docs" or "release_table") — see lib.baseline_
    report.show_baseline_section for the shared "skip if None / print
    the error / blank line" wrapper this only needs to supply its own
    resolve-and-print body for: values.yaml's own text at that baseline
    comes from lib.release_baseline.resolve_baseline_values (the
    values.yaml-only sibling of the same shared ref-resolution + git-
    show primitive show-component-baseline-version's own component_
    state_at_baseline builds on — this script never needs Chart.yaml at
    all) — never a separate git_show_text call of its own. Returns True
    if the image's state was actually shown."""
    def resolve(baseline_value):
        ref, _baseline_values, baseline_lines, error = resolve_baseline_values(
            chart_dir, baseline_value)
        if error:
            return f"error: {error}"

        try:
            matches = resolve_scoped_matches(baseline_lines, key, basename)
        except SystemExit as e:
            return str(e)  # already "error: ..." — resolve_scoped_matches' own prefix, not added twice

        print(f"  Baseline: {baseline_value} (resolved to {ref})")
        for m in matches:
            print(f"    {m['repository']}: {m['version']}  (sha256:{m['digest']})")
        return None

    return show_baseline_section(label, baseline, resolve)


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    if len(sys.argv) != 3:
        print(__doc__)
        sys.exit(1)
    key, basename = sys.argv[1], sys.argv[2]

    repo_root = find_repo_root()
    chart_dir = repo_root / RELATIVE_CHART_DIR

    upgrade_docs = read_upgrade_docs_baseline(chart_dir)
    release_table = read_release_table_baseline(chart_dir)

    shown_upgrade_docs = show_at_baseline(chart_dir, "upgrade_docs", upgrade_docs, key, basename)
    shown_release_table = show_at_baseline(chart_dir, "release_table", release_table, key, basename)

    if not shown_upgrade_docs and not shown_release_table:
        sys.exit(1)


if __name__ == "__main__":
    main()
