from lib.upgradedoc.version_cells_and_key_changes import describe_key_changes

CHART_DIR = SCRIPT_DIR.parents[0]
CHART_YAML = CHART_DIR / "Chart.yaml"
VALUES_YAML = CHART_DIR / "values.yaml"
DOC_DIR = CHART_DIR / "docs" / "_UPGRADE_PATHS"
IMAGES_DIR = CHART_DIR / "docs" / "images"
FIX_HELM_DOC_SCRIPT = SCRIPT_DIR / "fix-helm-doc"


def group_changes_by_component(changes, values_lines_before_write):
    """{values_key: {"paths": [dotted image path, ...], "old_app_by_path",
    "repos", "new_tags_by_path"}} for every distinct top-level component a
    basename bump's changes touch, plus [(full dotted "...tag" path,
    old_version), ...] for every change, in file order — the shape both
    the single-component and shared-image doc-update paths need, derived
    once here so each `changes` entry's values-tree location is only
    resolved a single time."""
    groups = {}
    full_paths = []
    for c in changes:
        path_parts = dotted_key_path(values_lines_before_write, c["line"] - 1).split(".")
        values_key, image_path = path_parts[0], ".".join(path_parts[1:-1])
        full_paths.append((".".join(path_parts), c["old_version"]))
        g = groups.setdefault(values_key, {"paths": [], "old_app_by_path": {}, "repos": {}, "new_tags_by_path": {}})
        if image_path not in g["paths"]:
            g["paths"].append(image_path)
        g["old_app_by_path"][image_path] = c["old_version"]
        g["repos"][image_path] = c["repository"]
        g["new_tags_by_path"][image_path] = f"{c['new_version']}@{c['new_digest']}"
    return groups, full_paths


@dataclass
class ComponentBump:
    """dep/values_key/group -- one basename bump's own single-component
    match (see group_changes_by_component's own docstring for `group`'s
    shape: paths/old_app_by_path/repos/new_tags_by_path), bundled since
    every doc-update phase of update_docs_single_component below needs
    some subset of all three."""

    dep: dict
    values_key: str
    group: dict


@dataclass
class _BaselineResolution:
    """upgrade_docs_baseline/old_app/old_chart_str/reset_to_baseline/
    baseline_deps/baseline_values -- update_docs_single_component's own
    baseline-comparison phase output, threaded into every doc-update
    phase below so each only computes it once (see resolve_baseline_
    component_versions' own docstring for why a blank baseline app
    version can't just be re-derived independently per phase)."""

    upgrade_docs_baseline: str
    old_app: str
    old_chart_str: str
    reset_to_baseline: bool
    baseline_deps: list = None
    baseline_values: dict = None


@dataclass
class _SingleComponentDocContext:
    """friendly/chart_name/target/change/ordering/baseline -- everything
    every doc-update phase of update_docs_single_component needs except
    the bump's own paths/repos/tags (see ComponentBump), computed once up
    front and threaded through unchanged."""

    friendly: str
    chart_name: str
    target: str
    change: VersionChange
    ordering: OrderingContext
    baseline: _BaselineResolution


def _single_component_baseline_resolution(bump, chart_name, chart_version_str):
    """Compare against the TRUE release upgrade_docs_baseline
    (git-resolved), not "whatever this script itself last left on disk"
    -- see update-component-version's own main() for why (a component
    bumped more than once in one release cycle collapses to a single
    upgrade_docs_baseline -> final entry instead of accumulating each
    intermediate hop; a bump that nets out to no change vs
    upgrade_docs_baseline has nothing left to document at all)."""
    upgrade_docs_baseline = read_upgrade_docs_baseline(CHART_DIR)
    image_paths = bump.group["paths"]
    old_app = bump.group["old_app_by_path"][image_paths[0]]
    old_chart_str = chart_version_str
    baseline_deps = baseline_values = None
    reset_to_baseline = False
    if upgrade_docs_baseline is not None:
        baseline_deps, baseline_values = load_baseline_state(CHART_YAML, VALUES_YAML, upgrade_docs_baseline)
    if baseline_deps is not None:
        current_deps = load_yaml(CHART_YAML).get("dependencies", [])
        current_values = load_yaml(VALUES_YAML) or {}
        changed_keys = compute_changed_components(current_deps, baseline_deps, current_values, baseline_values)
        # compute_changed_components only ever returns top-level values.yaml
        # keys (see its own docstring) — never `friendly`'s own possibly-
        # disambiguated "<values_key> - <basename>" form, which wouldn't be
        # a member of that set even when this specific image DID change.
        reset_to_baseline = bump.values_key not in changed_keys
        # resolve_baseline_component_versions (lib.upgradedoc) is the
        # single shared source of truth for this resolution — see its own
        # docstring for exactly why a blank baseline app-version tag isn't
        # the same as "resolution failed, fall back to whatever old_app
        # already held" (real bug, confirmed live: mi's own bump showed a
        # stale "2.71.0 -> 2.90.0" transition instead of "2.90.0 (new)"),
        # and why old_chart is gated by that same signal rather than
        # always trusting baseline_dep's own raw Chart.yaml version.
        # update-component-version's own main() calls the exact same
        # helper, so the two scripts can never drift on this again.
        baseline_dep = dep_for_values_key(baseline_deps, bump.values_key)
        old_app, old_chart_str = resolve_baseline_component_versions(
            BaselineComponentQuery(
                baseline_values,
                baseline_dep,
                bump.values_key,
                image_paths[0],
                chart_name,
                chart_version_str,
                chart_dir=CHART_DIR,
            )
        )
    return _BaselineResolution(
        upgrade_docs_baseline, old_app, old_chart_str, reset_to_baseline, baseline_deps, baseline_values
    )


def _update_single_component_upgrade_doc(upgrade_path, context, bump):
    if upgrade_path is None:
        print()
        if context.baseline.upgrade_docs_baseline is None:
            print(
                "No release-baseline.yaml upgrade_docs key found — run create-podiumd-version/"
                "change-podiumd-baseline first; skipping doc updates."
            )
        else:
            print(
                f"No upgrade doc found for target {context.target} — run create-doc-version first "
                f"to scaffold it; skipping doc updates."
            )
        return

    if context.baseline.reset_to_baseline:
        text = upgrade_path.read_text(encoding="utf-8")
        new_text, row_removed = remove_component_row(text, context.friendly)
        new_text, section_removed = remove_changes_section(new_text, context.friendly)
        if row_removed or section_removed:
            upgrade_path.write_text(new_text, encoding="utf-8")
        print()
        print(f"=== Updating {upgrade_path.name} ===")
        print(
            f"  {context.friendly} is back at its upgrade_docs_baseline {context.baseline.upgrade_docs_baseline}"
            " version — nothing left to document"
        )
        if row_removed:
            print("  removed table row")
        if section_removed:
            print(f"  removed '### {context.friendly} ...' Changes section")
        return

    text = upgrade_path.read_text(encoding="utf-8")
    new_text, table_action = update_component_table(text, context.friendly, context.change, context.ordering)
    if table_action is None:
        return
    new_text, _ = remove_changes_section(new_text, context.friendly)
    identity = ComponentIdentity(context.friendly, context.chart_name, bump.values_key)
    section = make_changes_section(identity, context.target, context.change, bump.group["paths"])
    new_text = insert_changes_section(new_text, section, context.friendly, context.ordering)
    upgrade_path.write_text(new_text, encoding="utf-8")
    print()
    print(f"=== Updating {upgrade_path.name} ===")
    print(f"  {table_action} table row")
    print(f"  (re)wrote '### {context.friendly} ...' Changes section")


def _update_single_component_values_deltas(values_deltas_path, context, bump, upgrade_path_exists):
    if values_deltas_path is None:
        if upgrade_path_exists:
            print()
            print(
                f"No values-deltas.md found for upgrade_docs_baseline {context.baseline.upgrade_docs_baseline}"
                " — skipping that update."
            )
        return

    text = values_deltas_path.read_text(encoding="utf-8")
    text, section_removed = remove_values_delta_section(
        text, context.friendly, context.ordering.deps, context.ordering.canonical_names
    )
    if context.baseline.reset_to_baseline:
        values_deltas_path.write_text(text, encoding="utf-8")
        print()
        print(f"=== Updating {values_deltas_path.name} ===")
        print(
            f"  {context.friendly} is back at its upgrade_docs_baseline {context.baseline.upgrade_docs_baseline}"
            f" version — {'removed its section' if section_removed else 'nothing to remove'}"
        )
        return

    baseline_values_at_release = (
        context.baseline.baseline_values
        if context.baseline.baseline_deps is not None
        else load_baseline_values(VALUES_YAML, context.baseline.upgrade_docs_baseline)
    )
    key_lines = []
    no_baseline_ref = baseline_values_at_release is None
    if not no_baseline_ref:
        baseline_subtree = (
            baseline_values_at_release.get(bump.values_key, {}) if isinstance(baseline_values_at_release, dict) else {}
        )
        current_subtree = (
            context.ordering.values.get(bump.values_key, {}) if isinstance(context.ordering.values, dict) else {}
        )
        key_lines = describe_key_changes(bump.values_key, baseline_subtree, current_subtree)

    # A pure image-tag bump with no values-schema change needs no
    # section here at all — see sync_values_delta_sections' own
    # docstring for why a heading with nothing under it is worse
    # than no heading.
    if key_lines:
        no_changes_claimed = bool(NO_CHANGES_CLAIMED_RE.search(text))
        heading_line = values_delta_section_heading(
            context.friendly,
            context.change.old_app,
            context.change.new_app,
            context.change.new_chart,
            context.change.new_chart,
        )
        text = insert_values_delta_section(
            text,
            context.friendly,
            heading_line,
            key_lines,
            ValuesDeltaOrdering(context.ordering.deps, context.ordering.values, context.ordering.canonical_names),
        )
        values_deltas_path.write_text(text, encoding="utf-8")
        print()
        print(f"=== Updating {values_deltas_path.name} ===")
        print(f"  '{heading_line.rstrip()}'")
        for line in key_lines:
            print(f"  {line.rstrip()}")
        if no_changes_claimed:
            print(
                "  note: doc claims 'no gemeente podiumd.yml changes are required' — that's about "
                "gemeente ACTION, not about whether anything changed, so it may still hold; "
                "double-check it's still true now that this bullet's been added"
            )
    elif section_removed:
        values_deltas_path.write_text(text, encoding="utf-8")
        print()
        print(f"=== Updating {values_deltas_path.name} ===")
        print(f"  removed stale section for {context.friendly} — no values-schema change to document for this bump")
    if no_baseline_ref:
        print()
        print(
            f"  note: could not resolve upgrade_docs_baseline {context.baseline.upgrade_docs_baseline} to a git ref"
            " — skipping added/removed/renamed key detection for values-deltas.md"
        )


def _print_missing_manifest_entries(missing_entries, context, bump):
    print(
        "  No existing entry for the following — add manually (see "
        "docs/images/acr-mirror-naming.md for the correct 'name:' ACR mirror slug):"
    )
    for path, repo, new_tag in missing_entries:
        new_app_version, digest = new_tag.split("@", 1)
        # repo (group["repos"], the raw values.yaml/text-scan
        # "repository:" string) may have no registry host embedded
        # at all (Docker Hub's own convention, e.g. "curlimages/
        # curl") — never printed as-is for "url:", which needs the
        # real, fully host-qualified value (see lib.chart.
        # full_repository_for_path's own docstring for why
        # reconstructing one from a stripped/bare string can't be
        # done correctly without this resolution).
        full_repo = (
            full_repository_for_path(
                CHART_DIR,
                context.ordering.deps,
                context.ordering.values,
                (bump.values_key, *tuple(path.split("."))),
            )
            or repo
        )
        print(f"    # {context.friendly} — {bump.group['old_app_by_path'].get(path) or '(none)'} -> {new_app_version}")
        print("    - name: <ACR-mirror-name>")
        print(f"      url: {full_repo}")
        print(f'      version: "{new_app_version}"')
        print(f'      digest: "{digest}"')


def _update_single_component_images_manifest(context, bump):
    images_path = images_manifest_path(IMAGES_DIR, context.target)
    if not images_path.is_file():
        print()
        print(f"No images-{context.target}.yaml found — skipping that update.")
        return

    manifest_target = ManifestUpdateTarget(images_path, context.friendly, bump.values_key)
    path_update = ImagePathUpdate(bump.group["paths"], bump.group["repos"], bump.group["new_tags_by_path"])

    if context.baseline.reset_to_baseline:
        changes_action, entry_updates = remove_component_from_images_manifest(manifest_target, path_update)
        print()
        print(f"=== Updating {images_path.name} ===")
        if changes_action:
            print(
                f"  {context.friendly} is back at its upgrade_docs_baseline {context.baseline.upgrade_docs_baseline}"
                " version — removed 'changes:' list entry"
            )
        for name in entry_updates:
            print(f"  updated entry '{name}' (now matches upgrade_docs_baseline — no longer a documented change)")
        return

    changes_action, entry_updates, missing_entries = update_images_manifest(
        manifest_target, context.change, path_update, context.ordering.deps, context.ordering.values
    )
    print()
    print(f"=== Updating {images_path.name} ===")
    if changes_action:
        print(f"  {changes_action} 'changes:' list entry")
    for name in entry_updates:
        print(f"  updated entry '{name}'")
    if missing_entries:
        _print_missing_manifest_entries(missing_entries, context, bump)


def update_docs_single_component(new_version, basename, bump, ordering, target):
    """The exact update-component-version doc-update flow (see that
    script's own main() for the version this was factored out of),
    applied to a basename bump that happens to affect only this one
    component — old_chart/new_chart are the SAME (Chart.yaml's own
    version), since a basename bump never touches Chart.yaml.

    The doc row/Changes-section/values-delta bullet is named
    `bump.values_key` alone when the bumped image is this dependency's
    own registered primary image (image_paths_for) — the usual,
    unambiguous case, same display name as ever. For any OTHER image
    under this dependency's own subtree (a sidecar — e.g. redis-ha's
    own redis image or its redis-exporter sidecar, both nested under
    "redis-operator") `bump.values_key` alone would collide with — and
    silently corrupt — the row already representing the dependency's
    own primary image (or another sidecar's own row): find_component_row
    matches by word-containment against a SINGLE name, so two different
    images sharing that same `values_key` name are indistinguishable to
    it. Disambiguated as "<values_key> - <basename>" instead — both are
    already-resolved, exact inputs (resolve_scoped_matches guarantees
    <values_key> <basename> identifies exactly one distinct repository),
    not a guess."""
    chart_name = bump.dep["name"]
    is_primary_image = set(bump.group["paths"]) <= set(image_paths_for(bump.dep["name"], CHART_DIR))
    friendly = bump.values_key if is_primary_image else f"{bump.values_key} - {basename}"
    chart_version_str = str(bump.dep["version"])

    baseline = _single_component_baseline_resolution(bump, chart_name, chart_version_str)
    change = VersionChange(baseline.old_app, new_version, baseline.old_chart_str, chart_version_str)
    context = _SingleComponentDocContext(friendly, chart_name, target, change, ordering, baseline)

    upgrade_path, values_deltas_path = baseline_doc_paths(DOC_DIR, baseline.upgrade_docs_baseline, target)
    _update_single_component_upgrade_doc(upgrade_path, context, bump)
    _update_single_component_values_deltas(values_deltas_path, context, bump, upgrade_path is not None)
    _update_single_component_images_manifest(context, bump)


@dataclass
class SharedImageBump:
    """basename/changes/pinned -- one basename bump's own shared-image
    match (more than one Chart.yaml component pins it -- see update_
    docs_shared_image's own docstring): `changes` is update_image_
    version's raw per-pin change list, `pinned` is [(path, old_version),
    ...] for every place it's pinned, both threaded through every
    doc-update phase below."""

    basename: str
    changes: list
    pinned: list


@dataclass
class _SharedImageBaselineResolution:
    """upgrade_docs_baseline/old_version/reset_to_baseline/pinned --
    update_docs_shared_image's own baseline-comparison phase output (see
    resolve_basename_baseline_version's own docstring for why old_version
    has two different fallback sources depending on whether
    baseline_values itself resolved at all). `pinned` here may already be
    the baseline-normalized rewrite of the bump's own raw pinned list."""

    upgrade_docs_baseline: str
    old_version: str
    reset_to_baseline: bool
    pinned: list


@dataclass
class _SharedImageDocContext:
    """target/change/ordering/baseline -- everything every doc-update
    phase of update_docs_shared_image needs except the bump's own
    basename/changes (see SharedImageBump), computed once up front and
    threaded through unchanged. `change` here is a VersionChange with
    `new_chart="-"` (see make_changes_section's own docstring for what
    that renders as -- a shared image bump never has its own Helm chart
    version)."""

    target: str
    change: VersionChange
    ordering: OrderingContext
    baseline: _SharedImageBaselineResolution


def _shared_image_baseline_resolution(new_version, bump):
    """Compare against the TRUE release upgrade_docs_baseline
    (git-resolved) rather than "whatever's on disk right before this run"
    -- same reasoning as update_docs_single_component/update-component-
    version's main(). A basename bump always targets every matching pin
    uniformly, so resolve_basename_baseline_version only has an opinion
    when every touched pin actually started at the same
    upgrade_docs_baseline version.

    old_version is None for two DIFFERENT reasons this used to conflate:
    resolve_basename_baseline_version's own "didn't all agree, or any of
    them isn't found there at all" (see its own docstring) is
    authoritative once baseline_values itself resolved at all — the exact
    same #1/#5-class gap already fixed in update_docs_single_component/
    update-component-version's own baseline resolution (see lib.
    upgradedoc.resolve_baseline_component_versions): falling back to
    changes[0]["old_version"] unconditionally meant "genuinely never
    uniformly pinned at the true baseline" got conflated with "whatever
    this basename happened to be pinned at immediately BEFORE this
    specific run" -- wrong once ANY earlier bump this same cycle already
    moved it (e.g. a component bumped 8.20.0 -> 8.21.0 earlier in the
    cycle, then 8.21.0 -> 8.22.0 this run, would wrongly show "8.21.0 ->
    8.22.0" instead of the TRUE cumulative "8.20.0 -> 8.22.0"). Only fall
    back to the pre-run value when baseline_values itself is None -- the
    git ref genuinely couldn't be resolved at all, not "resolved but this
    basename has no opinion there"."""
    upgrade_docs_baseline = read_upgrade_docs_baseline(CHART_DIR)
    baseline_values = (
        load_baseline_values(VALUES_YAML, upgrade_docs_baseline) if upgrade_docs_baseline is not None else None
    )
    baseline_version = (
        resolve_basename_baseline_version(baseline_values, bump.pinned) if baseline_values is not None else None
    )
    old_version = baseline_version if baseline_values is not None else bump.changes[0]["old_version"]
    reset_to_baseline = baseline_version is not None and normalize_version(new_version) == normalize_version(
        baseline_version
    )
    pinned = bump.pinned
    if baseline_values is not None:
        # Keep each path's own per-path old version (used by
        # make_image_changes_section's per-pin listing) consistent with
        # the single collapsed old_version above -- otherwise a second
        # bump in the same cycle would show the FIRST bump's target
        # (e.g. "8.21.0") as each pin's "old" value instead of the true
        # upgrade_docs_baseline (e.g. "8.20.0"), or (baseline_version is
        # None) a real per-path transition below a "(new)" heading that
        # contradicts it.
        pinned = [(path, baseline_version) for path, _old_version in pinned]
    return _SharedImageBaselineResolution(upgrade_docs_baseline, old_version, reset_to_baseline, pinned)


def _update_shared_image_upgrade_doc(upgrade_path, context, bump):
    if upgrade_path is None:
        print()
        if context.baseline.upgrade_docs_baseline is None:
            print(
                "No release-baseline.yaml upgrade_docs key found — run create-podiumd-version/"
                "change-podiumd-baseline first; skipping doc updates."
            )
        else:
            print(
                f"No upgrade doc found for target {context.target} — run create-doc-version first "
                f"to scaffold it; skipping doc updates."
            )
        return

    if context.baseline.reset_to_baseline:
        text = upgrade_path.read_text(encoding="utf-8")
        new_text, row_removed = remove_component_row(text, bump.basename)
        new_text, section_removed = remove_changes_section(new_text, bump.basename)
        if row_removed or section_removed:
            upgrade_path.write_text(new_text, encoding="utf-8")
        print()
        print(f"=== Updating {upgrade_path.name} ===")
        print(
            f"  {bump.basename} is back at its upgrade_docs_baseline {context.baseline.upgrade_docs_baseline}"
            " version — nothing left to document"
        )
        if row_removed:
            print("  removed table row")
        if section_removed:
            print(f"  removed '### {bump.basename} ...' Changes section")
        return

    text = upgrade_path.read_text(encoding="utf-8")
    new_text, table_action = update_component_table(text, bump.basename, context.change, context.ordering)
    if table_action is None:
        return
    new_text, _ = remove_changes_section(new_text, bump.basename)
    section = make_image_changes_section(
        bump.basename, context.target, context.change.old_app, context.change.new_app, context.baseline.pinned
    )
    new_text = insert_changes_section(new_text, section, bump.basename, context.ordering)
    upgrade_path.write_text(new_text, encoding="utf-8")
    print()
    print(f"=== Updating {upgrade_path.name} ===")
    print(f"  {table_action} table row")
    print(f"  (re)wrote '### {bump.basename} ...' Changes section")


def _update_shared_image_values_deltas(values_deltas_path, context, bump, upgrade_path_exists):
    # A shared image's own basename bump never touches any values.yaml
    # SCHEMA — there's no per-component subtree to diff, unlike a real
    # dependency's own key (see lib.component_docs.sync_values_delta_
    # sections' own docstring for why a version-only change needs no
    # values-deltas.md section at all) — so this only ever removes a
    # stale section left over from an earlier bump within this same
    # release cycle, never creates a new one.
    if values_deltas_path is None:
        if upgrade_path_exists:
            print()
            print(
                f"No values-deltas.md found for upgrade_docs_baseline {context.baseline.upgrade_docs_baseline}"
                " — skipping that update."
            )
        return

    text = values_deltas_path.read_text(encoding="utf-8")
    text, section_removed = remove_values_delta_section(
        text, bump.basename, context.ordering.deps, context.ordering.canonical_names
    )
    if context.baseline.reset_to_baseline:
        values_deltas_path.write_text(text, encoding="utf-8")
        print()
        print(f"=== Updating {values_deltas_path.name} ===")
        print(
            f"  {bump.basename} is back at its upgrade_docs_baseline {context.baseline.upgrade_docs_baseline}"
            f" version — {'removed its section' if section_removed else 'nothing to remove'}"
        )
    elif section_removed:
        values_deltas_path.write_text(text, encoding="utf-8")
        print()
        print(f"=== Updating {values_deltas_path.name} ===")
        print(f"  removed stale section for {bump.basename} — no values-schema change to document for this bump")


def _update_shared_image_manifest_entry(images_path, repository, c, context, bump):
    host, repo_path = parse_repo(repository)
    if context.baseline.reset_to_baseline:
        changes_action, entry_updated = remove_image_manifest_entry(
            images_path, bump.basename, repo_path, c["new_version"], c["new_digest"]
        )
        if changes_action:
            print("  removed 'changes:' list entry")
        if entry_updated:
            print(
                f"  updated entry for {repo_path} (now matches upgrade_docs_baseline — no longer a documented change)"
            )
        return

    changes_action, entry_updated = update_image_manifest(
        images_path,
        ImageBump(bump.basename, repo_path, context.baseline.old_version, c["new_version"], c["new_digest"]),
        context.ordering,
    )
    if changes_action:
        print(f"  {changes_action} 'changes:' list entry")
    if entry_updated:
        print(f"  updated entry for {repo_path}")
        return
    print(
        f"  No existing entry for {repo_path} — add manually (see "
        f"docs/images/acr-mirror-naming.md for the correct 'name:' ACR mirror slug):"
    )
    print(f"    # {bump.basename} — {context.baseline.old_version} -> {c['new_version']}")
    print("    - name: <ACR-mirror-name>")
    print(f"      url: {host}/{repo_path}")
    print(f'      version: "{c["new_version"]}"')
    print(f'      digest: "{c["new_digest"]}"')


def _update_shared_image_images_manifest(context, bump):
    images_path = images_manifest_path(IMAGES_DIR, context.target)
    if not images_path.is_file():
        print()
        print(f"No images-{context.target}.yaml found — skipping that update.")
        return

    by_repository = {}
    for c in bump.changes:
        by_repository.setdefault(c["repository"], c)
    print()
    print(f"=== Updating {images_path.name} ===")
    for repository, c in sorted(by_repository.items()):
        _update_shared_image_manifest_entry(images_path, repository, c, context, bump)


def update_docs_shared_image(new_version, target, bump, ordering):
    """The 4.8.1-to-4.8.2-upgrade.md convention for a genuinely shared
    image (more than one Chart.yaml component pins it): a table row keyed
    by the basename itself (Helm chart column "-" — see
    lib.upgradedoc.component_order_key's "unmatched sorts last" rule for
    why it naturally lands after every real component), a "### <basename>
    ..." Changes block listing every place it's pinned, a values-deltas
    bullet, and one images-manifest entry per distinct repository (rare
    for the SAME basename to span more than one, but not impossible)."""
    baseline = _shared_image_baseline_resolution(new_version, bump)
    change = VersionChange(baseline.old_version, new_version, None, "-")
    context = _SharedImageDocContext(target, change, ordering, baseline)

    upgrade_path, values_deltas_path = baseline_doc_paths(DOC_DIR, baseline.upgrade_docs_baseline, target)
    _update_shared_image_upgrade_doc(upgrade_path, context, bump)
    _update_shared_image_values_deltas(values_deltas_path, context, bump, upgrade_path is not None)
    _update_shared_image_images_manifest(context, bump)


def update_docs(basename, new_version, changes, values_lines_before_write):
    """Updates the current target's upgrade docs for this run's `changes`
    (all under one values.yaml key/scope — see the module docstring for
    why). Dispatches to update_docs_single_component when the scope is a
    real Chart.yaml dependency, or to update_docs_shared_image for the
    MULTIPLE-key case (a base image shared via global.images with no
    matching dependency named "global")."""
    chart_yaml = load_yaml(CHART_YAML) or {}
    deps = chart_yaml.get("dependencies", [])
    target = str(chart_yaml.get("version"))
    values = load_yaml(VALUES_YAML) or {}

    # <key> <basename> already resolved to a single scope (see
    # lib.image.version.resolve_scoped_matches) before any pin was
    # touched, so `changes` can only ever belong to ONE top-level
    # values.yaml key here — either a real Chart.yaml dependency (the
    # common case) or "global" (the MULTIPLE_KEY case, which never has
    # one, since no dependency is literally named "global").
    groups, full_paths = group_changes_by_component(changes, values_lines_before_write)
    values_key, group = next(iter(groups.items()))

    all_paths = [p for p, _tag in find_all_image_and_version_paths(values, deps)] + [
        p for p, _tag in global_image_paths(values)
    ]
    canonical_names = canonical_sidecar_row_names(CHART_DIR, deps, values, all_paths)

    dep = find_dependency(deps, values_key)
    if dep is not None:
        update_docs_single_component(
            new_version,
            basename,
            ComponentBump(dep, values_key, group),
            OrderingContext(deps, values, canonical_names),
            target,
        )
        return

    update_docs_shared_image(
        new_version,
        target,
        SharedImageBump(basename, changes, full_paths),
        OrderingContext(deps, values, canonical_names),
    )


def main():
    """CLI entry point: resolves <key> <basename> to a single image pin
    scope, bumps every matching values.yaml tag pin to <new-version>
    (re-resolving digests against the registry), updates the matching
    upgrade docs for the current target if they exist, and regenerates
    README.md (fix-helm-doc) and images-baseline.yaml. A no-op (already
    at that version everywhere) prints a message and returns without
    touching anything."""
    if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    if len(sys.argv) != 4:
        print(__doc__)
        sys.exit(1)
    key, basename, new_version = sys.argv[1], sys.argv[2], sys.argv[3]
    ensure_vendored_dependencies(CHART_DIR)

    deps = load_yaml(CHART_YAML).get("dependencies", [])
    key = resolve_key_scope(key, deps)

    values_lines = VALUES_YAML.read_text(encoding="utf-8").splitlines()

    changes = update_image_version(VALUES_YAML, key, basename, new_version)
    if not changes:
        print(f"'{basename}' under '{key}' is already at {new_version} everywhere it's pinned — nothing to do.")
        return

    print(f"=== Writing {VALUES_YAML} ===")
    for c in changes:
        print(f"  values.yaml:{c['line']}  ({c['repository']})")
        print(f"    {c['old_version']}@{c['old_digest']}")
        print(f"    {c['new_version']}@{c['new_digest']}")
    print()
    print(f"Updated {len(changes)} pin(s).")

    update_docs(basename, new_version, changes, values_lines)

    print()
    print("=== Regenerating README.md (fix-helm-doc) ===")
    run_script([sys.executable, str(FIX_HELM_DOC_SCRIPT)])

    refresh_images_baseline(CHART_DIR, deps, load_yaml(VALUES_YAML) or {}, IMAGES_DIR / "images-baseline.yaml")

    print()
    print("Done. Re-render the chart to confirm (verify-podiumd or /helm-render-all) before committing.")


if __name__ == "__main__":
    main()
