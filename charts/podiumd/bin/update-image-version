#!/usr/bin/env python3
"""
Bump every values.yaml image tag pin sharing an image basename, scoped to
<key>, to a new version.

Checks the version exists upstream and resolves its digest before writing
anything. Then updates the docs for the current target version, if they
exist (upgrade doc, values-deltas, images-<target>.yaml), runs
fix-helm-doc and then fix-doc-consistency, which also regenerates
images-baseline.yaml. Fails when <key>
<basename> does not match exactly one repository.

Usage:
    update-image-version <key> <basename> <new-version>

Arguments:
    <key>           Chart.yaml dependency name or alias, or MULTIPLE for
                    an image shared via global.images
    <basename>      last path segment of the image repository
    <new-version>   new image tag

Examples:
    update-image-version zac zaakafhandelcomponent 5.4.4
    update-image-version keycloak-operator python 3.15.7-slim
    update-image-version MULTIPLE curl 8.22.0

To bump a component's app and chart version together, use
update-component-version. Re-render the chart (verify-podiumd) before
committing.
"""

import sys

from dataclasses import dataclass
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# Not installed as a package -- sys.path must be patched before
# lib.* can be imported, so these imports can't move to the top.
# pylint: disable=wrong-import-position
