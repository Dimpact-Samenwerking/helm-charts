#!/usr/bin/env python3
"""
Bump every values.yaml image tag pin sharing an image basename, scoped to
<key>, to a new version.

Checks the version exists upstream and resolves its digest before writing
anything. Then updates the docs for the current target version, if they
exist (upgrade doc, values-deltas, images-<target>.yaml), runs
fix-helm-doc and regenerates images-baseline.yaml. Fails when <key>
<basename> does not match exactly one repository.

Usage:
    update-image-version <key> <basename> <new-version>

Arguments:
    <key>           Chart.yaml dependency name or alias, or MULTIPLE for
                    an image shared via global.images
    <basename>      last path segment of the image repository
    <new-version>   new image tag

Examples:
    update-image-version zac zaakafhandelcomponent 5.4.4
    update-image-version keycloak-operator python 3.15.7-slim
    update-image-version MULTIPLE curl 8.22.0

To bump a component's app and chart version together, use
update-component-version. Re-render the chart (verify-podiumd) before
committing.
"""

import sys

from dataclasses import dataclass
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# Not installed as a package -- sys.path must be patched before
# lib.* can be imported, so these imports can't move to the top.
# pylint: disable=wrong-import-position
from lib.chart.pull_and_subchart_resolution import global_image_paths
from lib.chart.registered_paths import image_paths_for
from lib.chart.release_baseline_basics import load_yaml
from lib.chart.release_baseline_basics import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.chart.repo_and_path_resolution import canonical_sidecar_row_names
from lib.chart.repo_and_path_resolution import full_repository_for_path
from lib.chart.values_tree_primitives import dotted_key_path
from lib.chart.values_tree_primitives import find_dependency
from lib.component_docs import NO_CHANGES_CLAIMED_RE
from lib.component_docs.baseline_doc_stubs import baseline_doc_paths
from lib.component_docs.baseline_doc_stubs import images_manifest_path
from lib.component_docs.baseline_doc_stubs import load_baseline_state
from lib.component_docs.baseline_doc_stubs import load_baseline_values
from lib.component_docs.changes_section import ComponentIdentity
from lib.component_docs.changes_section import OrderingContext
from lib.component_docs.changes_section import VersionChange
from lib.component_docs.changes_section import dep_for_values_key
from lib.component_docs.changes_section import insert_changes_section
from lib.component_docs.changes_section import make_changes_section
from lib.component_docs.changes_section import remove_changes_section
from lib.component_docs.changes_section import remove_component_row
from lib.component_docs.changes_section import update_component_table
from lib.component_docs.images_manifest_entries import ImagePathUpdate
from lib.component_docs.images_manifest_entries import ManifestUpdateTarget
from lib.component_docs.images_manifest_entries import remove_component_from_images_manifest
from lib.component_docs.images_manifest_entries import update_images_manifest
from lib.component_docs.values_delta_sections import ValuesDeltaOrdering
from lib.component_docs.values_delta_sections import insert_values_delta_section
from lib.component_docs.values_delta_sections import remove_values_delta_section
from lib.component_docs.values_delta_sections import values_delta_section_heading
from lib.dependencies import ensure_vendored_dependencies
