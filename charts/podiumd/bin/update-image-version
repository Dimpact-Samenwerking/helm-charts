#!/usr/bin/env python3
"""
Bump every values.yaml image tag pin sharing an image basename, scoped to
<key>, to a new version.

Checks the version exists upstream and resolves its digest before
writing. Then updates the target version's docs if they exist (upgrade
doc, values-deltas, images-<target>.yaml) and runs fix-helm-doc and
fix-doc-consistency (which also regenerates images-baseline.yaml).
Fails when <key> <image-basename> does not match exactly one repository.

Usage:
    update-image-version <key> <image-basename> <image-version>

Arguments:
    <key>             top-level values.yaml key: a Chart.yaml dependency
                      name or alias, a native component (defined in
                      podiumd itself, e.g. frankgateway) or MULTIPLE for
                      global.images
    <image-basename>  last path segment of the image repository
    <image-version>   image tag

Examples:
    update-image-version zac zaakafhandelcomponent 5.4.4
    update-image-version keycloak-operator python 3.15.7-slim
    update-image-version MULTIPLE curl 8.22.0

To bump a component's app and chart version together, use
update-component-version. Re-render the chart (verify-podiumd) before
committing.
"""

import sys

from dataclasses import dataclass
from pathlib import Path
from typing import TypedDict

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.chart_yaml import ChartDependency
from lib.chart.chart_yaml import load_chart_dependencies
from lib.chart.paths import CHART_DIR
from lib.chart.paths import CHART_YAML
