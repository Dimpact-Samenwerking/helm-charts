#!/usr/bin/env python3
"""
Bump every values.yaml image tag pin sharing a given image's basename (the
last "/"-separated segment of its "repository:" value), scoped to <key>,
to a new version, re-resolving each pin's digest against the registry.

<key> is either a Chart.yaml dependency's own top-level values.yaml key
(a component, e.g. "openklant", "zac") or the literal "MULTIPLE" — the
same convention release-table.csv itself uses (see export-confluence-
release-table's component_and_alias) for a base image shared across
several unrelated components via values.yaml's global.images anchor
block (e.g. curlimages/curl or redis, pinned once there and aliased
everywhere else — updating it here updates every alias at once, since
they're all the same YAML node). <key> <basename> together must resolve
to exactly one real image pin under that scope — this fails loudly
rather than guessing if the basename isn't pinned there at all, or (rare)
resolves to more than one distinct repository (see
lib.image_version.resolve_scoped_matches). No release-table.csv involved
either way — this reads straight from Chart.yaml/values.yaml.

Also updates the docs for the current podiumd target version, if they
exist (run create-doc-version first if not) — the same four docs
update-component-version keeps in sync (upgrade doc table + Changes
section, values-deltas, images-<target>.yaml):
  - <key> is a real Chart.yaml dependency (the common case): full-
    fidelity treatment identical to update-component-version's own
    (lib.component_docs) — real Helm chart version shown (unchanged,
    since this never touches Chart.yaml), values-deltas schema-change
    detection, per-path images-manifest entries.
  - <key> is "MULTIPLE" (no Chart.yaml dependency named "global"):
    treated as its own pseudo-component keyed by the basename itself
    (lib.image_docs) — a "Component versions" table row with Helm chart
    column "-", a "### <basename> ..." Changes block listing every place
    it's pinned, a values-deltas bullet, and one images-manifest entry
    per distinct repository. Convention confirmed against docs/
    _UPGRADE_PATHS/4.8.1-to-4.8.2-upgrade.md (curl/nginx-unprivileged/
    busybox each got exactly this treatment).
Finally runs fix-helm-doc so README.md's values-reference
table doesn't go stale in the same commit.

Refuses to touch values.yaml unless the new version verifiably exists
upstream for the matched repository first — a bad version name fails
loudly with nothing written, never a half-updated file.

Usage:
    update-image-version <key> <basename> <new-version>

Examples:
    update-image-version zac zaakafhandelcomponent 5.4.4
    update-image-version keycloak-operator python 3.15.7-slim
        # keycloak-operator's own ensurePodiumdAdminUser init image
    update-image-version MULTIPLE curl 8.22.0
        # curlimages/curl lives under global.images -- shared by several
        # unrelated components, all updated together via the one anchor

A component's app version is not always its image's basename (e.g.
zgw-office-addin bumps two distinctly-named images, frontend + backend) —
see update-component-version, which resolves each of a component's
image path(s) to its own actual basename and calls this same logic
(lib.image_version.update_image_version) per path, scoped to that
component.

After writing, re-render the chart (verify-podiumd or /helm-render-all)
to confirm before committing.
"""
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from lib.chart import dotted_key_path, find_dependency, get_path, image_paths_for, load_yaml
from lib.chart import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.component_docs import (
    NO_CHANGES_CLAIMED_RE, baseline_doc_paths, images_manifest_path, insert_changes_section,
    load_baseline_state, load_baseline_values, make_changes_section, remove_changes_section,
    remove_component_from_images_manifest, remove_component_row, remove_component_values_delta,
    update_component_table, update_images_manifest, values_delta_bullet,
)
from lib.image_docs import (
    image_delta_bullet, make_image_changes_section, remove_image_manifest_entry,
    resolve_basename_baseline_version, update_image_manifest,
)
from lib.image_version import update_image_version
from lib.procutil import run_script
from lib.registry import parse_repo
from lib.upgradedoc import append_to_doc, compute_changed_components, describe_key_changes, normalize_version

CHART_DIR = SCRIPT_DIR.parents[0]
CHART_YAML = CHART_DIR / "Chart.yaml"
VALUES_YAML = CHART_DIR / "values.yaml"
DOC_DIR = CHART_DIR / "docs" / "_UPGRADE_PATHS"
IMAGES_DIR = CHART_DIR / "docs" / "images"
FIX_HELM_DOC_SCRIPT = SCRIPT_DIR / "fix-helm-doc"


def group_changes_by_component(changes, values_lines_before_write):
    """{values_key: {"paths": [dotted image path, ...], "old_app_by_path",
    "repos", "new_tags_by_path"}} for every distinct top-level component a
    basename bump's changes touch, plus [(full dotted "...tag" path,
    old_version), ...] for every change, in file order — the shape both
    the single-component and shared-image doc-update paths need, derived
    once here so each `changes` entry's values-tree location is only
    resolved a single time."""
    groups = {}
    full_paths = []
    for c in changes:
        path_parts = dotted_key_path(values_lines_before_write, c["line"] - 1).split(".")
        values_key, image_path = path_parts[0], ".".join(path_parts[1:-1])
        full_paths.append((".".join(path_parts), c["old_version"]))
        g = groups.setdefault(values_key, {"paths": [], "old_app_by_path": {}, "repos": {}, "new_tags_by_path": {}})
        if image_path not in g["paths"]:
            g["paths"].append(image_path)
        g["old_app_by_path"][image_path] = c["old_version"]
        g["repos"][image_path] = c["repository"]
        g["new_tags_by_path"][image_path] = f"{c['new_version']}@{c['new_digest']}"
    return groups, full_paths


def update_docs_single_component(new_version, target, deps, values, dep, values_key, group, basename):
    """The exact update-component-version doc-update flow (see that
    script's own main() for the version this was factored out of),
    applied to a basename bump that happens to affect only this one
    component — old_chart/new_chart are the SAME (Chart.yaml's own
    version), since a basename bump never touches Chart.yaml.

    The doc row/Changes-section/values-delta bullet is named
    `values_key` alone when the bumped image is this dependency's own
    registered primary image (image_paths_for) — the usual,
    unambiguous case, same display name as ever. For any OTHER image
    under this dependency's own subtree (a sidecar — e.g. redis-ha's
    own redis image or its redis-exporter sidecar, both nested under
    "redis-operator") `values_key` alone would collide with — and
    silently corrupt — the row already representing the dependency's
    own primary image (or another sidecar's own row): find_component_row
    matches by word-containment against a SINGLE name, so two different
    images sharing that same `values_key` name are indistinguishable to
    it. Disambiguated as "<values_key> - <basename>" instead — both are
    already-resolved, exact inputs (resolve_scoped_matches guarantees
    <values_key> <basename> identifies exactly one distinct repository),
    not a guess."""
    chart_name = dep["name"]
    is_primary_image = set(group["paths"]) <= set(image_paths_for(dep["name"]))
    friendly = values_key if is_primary_image else f"{values_key} - {basename}"
    chart_version_str = str(dep["version"])
    image_paths = group["paths"]
    repos = group["repos"]
    new_tags_by_path = group["new_tags_by_path"]

    upgrade_docs_baseline = read_upgrade_docs_baseline(CHART_DIR)
    upgrade_path, values_deltas_path = baseline_doc_paths(DOC_DIR, upgrade_docs_baseline, target)

    # Compare against the TRUE release upgrade_docs_baseline (git-resolved), not
    # "whatever this script itself last left on disk" -- see
    # update-component-version's own main() for why (a component
    # bumped more than once in one release cycle collapses to a single
    # upgrade_docs_baseline -> final entry instead of accumulating each intermediate
    # hop; a bump that nets out to no change vs upgrade_docs_baseline has nothing left
    # to document at all).
    old_app = group["old_app_by_path"][image_paths[0]]
    baseline_deps = baseline_values = None
    reset_to_baseline = False
    if upgrade_docs_baseline is not None:
        baseline_deps, baseline_values = load_baseline_state(CHART_YAML, VALUES_YAML, upgrade_docs_baseline)
    if baseline_deps is not None:
        current_deps = load_yaml(CHART_YAML).get("dependencies", [])
        current_values = load_yaml(VALUES_YAML) or {}
        changed_keys = compute_changed_components(current_deps, baseline_deps, current_values, baseline_values)
        # compute_changed_components only ever returns top-level values.yaml
        # keys (see its own docstring) — never `friendly`'s own possibly-
        # disambiguated "<values_key> - <basename>" form, which wouldn't be
        # a member of that set even when this specific image DID change.
        reset_to_baseline = values_key not in changed_keys
        baseline_tag = get_path(baseline_values, f"{values_key}.{image_paths[0]}.tag") or ""
        old_app = baseline_tag.split("@", 1)[0] or old_app

    if upgrade_path is None:
        print()
        if upgrade_docs_baseline is None:
            print("No release-baseline.yaml upgrade_docs key found — run create-podiumd-version/"
                  "change-podiumd-baseline first; skipping doc updates.")
        else:
            print(f"No upgrade doc found for target {target} — run create-doc-version first "
                  f"to scaffold it; skipping doc updates.")
    elif reset_to_baseline:
        text = upgrade_path.read_text(encoding="utf-8")
        new_text, row_removed = remove_component_row(text, friendly)
        new_text, section_removed = remove_changes_section(new_text, friendly)
        if row_removed or section_removed:
            upgrade_path.write_text(new_text, encoding="utf-8")
        print()
        print(f"=== Updating {upgrade_path.name} ===")
        print(f"  {friendly} is back at its upgrade_docs_baseline {upgrade_docs_baseline} version — nothing left to document")
        if row_removed:
            print("  removed table row")
        if section_removed:
            print(f"  removed '### {friendly} ...' Changes section")
    else:
        text = upgrade_path.read_text(encoding="utf-8")
        new_text, table_action = update_component_table(
            text, friendly, old_app, new_version, chart_version_str, chart_version_str, deps, values)
        if table_action is not None:
            new_text, _ = remove_changes_section(new_text, friendly)
            section = make_changes_section(friendly, target, chart_name, values_key, old_app, new_version,
                                            chart_version_str, chart_version_str, image_paths)
            new_text = insert_changes_section(new_text, section, friendly, deps, values)
            upgrade_path.write_text(new_text, encoding="utf-8")
            print()
            print(f"=== Updating {upgrade_path.name} ===")
            print(f"  {table_action} table row")
            print(f"  (re)wrote '### {friendly} ...' Changes section")

    if values_deltas_path is not None:
        text = values_deltas_path.read_text(encoding="utf-8")
        text, bullet_removed = remove_component_values_delta(text, friendly)
        if reset_to_baseline:
            values_deltas_path.write_text(text, encoding="utf-8")
            print()
            print(f"=== Updating {values_deltas_path.name} ===")
            print(f"  {friendly} is back at its upgrade_docs_baseline {upgrade_docs_baseline} version — "
                  f"{'removed its bullet' if bullet_removed else 'nothing to remove'}")
        else:
            new_lines = [values_delta_bullet(friendly, old_app, new_version, chart_version_str, chart_version_str)]
            baseline_values_at_release = baseline_values if baseline_deps is not None else load_baseline_values(
                VALUES_YAML, upgrade_docs_baseline)
            if baseline_values_at_release is None:
                print()
                print(f"  note: could not resolve upgrade_docs_baseline {upgrade_docs_baseline} to a git ref — skipping "
                      f"added/removed/renamed key detection for values-deltas.md")
            else:
                baseline_subtree = (baseline_values_at_release.get(values_key, {})
                                     if isinstance(baseline_values_at_release, dict) else {})
                current_subtree = values.get(values_key, {}) if isinstance(values, dict) else {}
                new_lines.extend(describe_key_changes(values_key, baseline_subtree, current_subtree))
            no_changes_claimed = bool(NO_CHANGES_CLAIMED_RE.search(text))
            values_deltas_path.write_text(append_to_doc(text, new_lines), encoding="utf-8")
            print()
            print(f"=== Updating {values_deltas_path.name} ===")
            for line in new_lines:
                print(f"  {line.rstrip()}")
            if no_changes_claimed:
                print("  note: doc claims 'no gemeente podiumd.yml changes are required' — that's about "
                      "gemeente ACTION, not about whether anything changed, so it may still hold; "
                      "double-check it's still true now that this bullet's been added")
    elif upgrade_path is not None:
        print()
        print(f"No values-deltas.md found for upgrade_docs_baseline {upgrade_docs_baseline} — skipping that update.")

    images_path = images_manifest_path(IMAGES_DIR, target)
    if not images_path.is_file():
        print()
        print(f"No images-{target}.yaml found — skipping that update.")
        return

    if reset_to_baseline:
        changes_action, entry_updates = remove_component_from_images_manifest(
            images_path, friendly, values_key, image_paths, repos, new_tags_by_path)
        print()
        print(f"=== Updating {images_path.name} ===")
        if changes_action:
            print(f"  {friendly} is back at its upgrade_docs_baseline {upgrade_docs_baseline} version — removed 'changes:' list entry")
        for name in entry_updates:
            print(f"  updated entry '{name}' (now matches upgrade_docs_baseline — no longer a documented change)")
        return

    changes_action, entry_updates, missing_entries = update_images_manifest(
        images_path, friendly, values_key, old_app, new_version, chart_version_str, chart_version_str,
        image_paths, repos, new_tags_by_path,
    )
    print()
    print(f"=== Updating {images_path.name} ===")
    if changes_action:
        print(f"  {changes_action} 'changes:' list entry")
    for name in entry_updates:
        print(f"  updated entry '{name}'")
    if missing_entries:
        print("  No existing entry for the following — add manually (see "
              "docs/images/acr-mirror-naming.md for the correct 'name:' ACR mirror slug):")
        for path, repo, new_tag in missing_entries:
            new_app_version, digest = new_tag.split("@", 1)
            print(f"    # {friendly} — {group['old_app_by_path'].get(path) or '(none)'} -> {new_app_version}")
            print("    - name: <ACR-mirror-name>")
            print(f"      url: {repo}")
            print(f'      version: "{new_app_version}"')
            print(f'      digest: "{digest}"')


def update_docs_shared_image(basename, new_version, changes, pinned, target, deps, values):
    """The 4.8.1-to-4.8.2-upgrade.md convention for a genuinely shared
    image (more than one Chart.yaml component pins it): a table row keyed
    by the basename itself (Helm chart column "-" — see
    lib.upgradedoc.component_order_key's "unmatched sorts last" rule for
    why it naturally lands after every real component), a "### <basename>
    ..." Changes block listing every place it's pinned, a values-deltas
    bullet, and one images-manifest entry per distinct repository (rare
    for the SAME basename to span more than one, but not impossible)."""
    upgrade_docs_baseline = read_upgrade_docs_baseline(CHART_DIR)
    upgrade_path, values_deltas_path = baseline_doc_paths(DOC_DIR, upgrade_docs_baseline, target)

    # Compare against the TRUE release upgrade_docs_baseline (git-resolved) rather than
    # "whatever's on disk right before this run" -- same reasoning as
    # update_docs_single_component/update-component-version's main().
    # A basename bump always targets every matching pin uniformly, so
    # resolve_basename_baseline_version only has an opinion when every
    # touched pin actually started at the same upgrade_docs_baseline version.
    baseline_values = load_baseline_values(VALUES_YAML, upgrade_docs_baseline) if upgrade_docs_baseline is not None else None
    baseline_version = (resolve_basename_baseline_version(baseline_values, pinned)
                         if baseline_values is not None else None)
    old_version = baseline_version if baseline_version is not None else changes[0]["old_version"]
    reset_to_baseline = (baseline_version is not None
                          and normalize_version(new_version) == normalize_version(baseline_version))
    if baseline_version is not None:
        # Keep each path's own per-path old version (used by
        # make_image_changes_section's per-pin listing) consistent with
        # the single collapsed old_version above -- otherwise a second
        # bump in the same cycle would show the FIRST bump's target
        # (e.g. "8.21.0") as each pin's "old" value instead of the true
        # upgrade_docs_baseline (e.g. "8.20.0").
        pinned = [(path, baseline_version) for path, _old_version in pinned]

    if upgrade_path is None:
        print()
        if upgrade_docs_baseline is None:
            print("No release-baseline.yaml upgrade_docs key found — run create-podiumd-version/"
                  "change-podiumd-baseline first; skipping doc updates.")
        else:
            print(f"No upgrade doc found for target {target} — run create-doc-version first "
                  f"to scaffold it; skipping doc updates.")
    elif reset_to_baseline:
        text = upgrade_path.read_text(encoding="utf-8")
        new_text, row_removed = remove_component_row(text, basename)
        new_text, section_removed = remove_changes_section(new_text, basename)
        if row_removed or section_removed:
            upgrade_path.write_text(new_text, encoding="utf-8")
        print()
        print(f"=== Updating {upgrade_path.name} ===")
        print(f"  {basename} is back at its upgrade_docs_baseline {upgrade_docs_baseline} version — nothing left to document")
        if row_removed:
            print("  removed table row")
        if section_removed:
            print(f"  removed '### {basename} ...' Changes section")
    else:
        text = upgrade_path.read_text(encoding="utf-8")
        new_text, table_action = update_component_table(
            text, basename, old_version, new_version, None, "-", deps, values)
        if table_action is not None:
            new_text, _ = remove_changes_section(new_text, basename)
            section = make_image_changes_section(basename, target, old_version, new_version, pinned)
            new_text = insert_changes_section(new_text, section, basename, deps, values)
            upgrade_path.write_text(new_text, encoding="utf-8")
            print()
            print(f"=== Updating {upgrade_path.name} ===")
            print(f"  {table_action} table row")
            print(f"  (re)wrote '### {basename} ...' Changes section")

    if values_deltas_path is not None:
        text = values_deltas_path.read_text(encoding="utf-8")
        text, bullet_removed = remove_component_values_delta(text, basename)
        if reset_to_baseline:
            values_deltas_path.write_text(text, encoding="utf-8")
            print()
            print(f"=== Updating {values_deltas_path.name} ===")
            print(f"  {basename} is back at its upgrade_docs_baseline {upgrade_docs_baseline} version — "
                  f"{'removed its bullet' if bullet_removed else 'nothing to remove'}")
        else:
            new_lines = [image_delta_bullet(basename, old_version, new_version, len(pinned))]
            no_changes_claimed = bool(NO_CHANGES_CLAIMED_RE.search(text))
            values_deltas_path.write_text(append_to_doc(text, new_lines), encoding="utf-8")
            print()
            print(f"=== Updating {values_deltas_path.name} ===")
            for line in new_lines:
                print(f"  {line.rstrip()}")
            if no_changes_claimed:
                print("  note: doc claims 'no gemeente podiumd.yml changes are required' — that's about "
                      "gemeente ACTION, not about whether anything changed, so it may still hold; "
                      "double-check it's still true now that this bullet's been added")
    elif upgrade_path is not None:
        print()
        print(f"No values-deltas.md found for upgrade_docs_baseline {upgrade_docs_baseline} — skipping that update.")

    images_path = images_manifest_path(IMAGES_DIR, target)
    if not images_path.is_file():
        print()
        print(f"No images-{target}.yaml found — skipping that update.")
        return

    by_repository = {}
    for c in changes:
        by_repository.setdefault(c["repository"], c)
    print()
    print(f"=== Updating {images_path.name} ===")
    for repository, c in sorted(by_repository.items()):
        host, repo_path = parse_repo(repository)
        if reset_to_baseline:
            changes_action, entry_updated = remove_image_manifest_entry(
                images_path, basename, repo_path, c["new_version"], c["new_digest"])
            if changes_action:
                print("  removed 'changes:' list entry")
            if entry_updated:
                print(f"  updated entry for {repo_path} (now matches upgrade_docs_baseline — no longer a documented change)")
            continue

        changes_action, entry_updated = update_image_manifest(
            images_path, basename, repo_path, old_version, c["new_version"], c["new_digest"])
        if changes_action:
            print(f"  {changes_action} 'changes:' list entry")
        if entry_updated:
            print(f"  updated entry for {repo_path}")
        else:
            print(f"  No existing entry for {repo_path} — add manually (see "
                  f"docs/images/acr-mirror-naming.md for the correct 'name:' ACR mirror slug):")
            print(f"    # {basename} — {old_version} -> {c['new_version']}")
            print("    - name: <ACR-mirror-name>")
            print(f"      url: {host}/{repo_path}")
            print(f'      version: "{c["new_version"]}"')
            print(f'      digest: "{c["new_digest"]}"')


def update_docs(basename, new_version, changes, values_lines_before_write):
    chart_yaml = load_yaml(CHART_YAML) or {}
    deps = chart_yaml.get("dependencies", [])
    target = str(chart_yaml.get("version"))
    values = load_yaml(VALUES_YAML) or {}

    # <key> <basename> already resolved to a single scope (see
    # lib.image_version.resolve_scoped_matches) before any pin was
    # touched, so `changes` can only ever belong to ONE top-level
    # values.yaml key here — either a real Chart.yaml dependency (the
    # common case) or "global" (the MULTIPLE_KEY case, which never has
    # one, since no dependency is literally named "global").
    groups, full_paths = group_changes_by_component(changes, values_lines_before_write)
    values_key, group = next(iter(groups.items()))
    dep = find_dependency(deps, values_key)
    if dep is not None:
        update_docs_single_component(new_version, target, deps, values, dep, values_key, group, basename)
        return

    update_docs_shared_image(basename, new_version, changes, full_paths, target, deps, values)


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    if len(sys.argv) != 4:
        print(__doc__)
        sys.exit(1)
    key, basename, new_version = sys.argv[1], sys.argv[2], sys.argv[3]

    values_lines = VALUES_YAML.read_text(encoding="utf-8").splitlines()

    changes = update_image_version(VALUES_YAML, key, basename, new_version)
    if not changes:
        print(f"'{basename}' under '{key}' is already at {new_version} everywhere it's pinned — nothing to do.")
        return

    print(f"=== Writing {VALUES_YAML} ===")
    for c in changes:
        print(f"  values.yaml:{c['line']}  ({c['repository']})")
        print(f"    {c['old_version']}@{c['old_digest']}")
        print(f"    {c['new_version']}@{c['new_digest']}")
    print()
    print(f"Updated {len(changes)} pin(s).")

    update_docs(basename, new_version, changes, values_lines)

    print()
    print("=== Regenerating README.md (fix-helm-doc) ===")
    run_script([sys.executable, str(FIX_HELM_DOC_SCRIPT)])

    print()
    print("Done. Re-render the chart to confirm (verify-podiumd or /helm-render-all) before committing.")


if __name__ == "__main__":
    main()
