#!/usr/bin/env python3
# The help text repeats other scripts' argument explanations on purpose;
# tests/lib/test_script_help_consistency.py keeps them equal.
# jscpd:ignore-start
"""
Bump every values.yaml image tag pin sharing an image basename, scoped to
<key>, to a new version.

Checks the version exists upstream and resolves its digest before
writing. Then runs fix-helm-doc and fix-doc-consistency, which writes
the target version's docs (upgrade doc, values-deltas,
images-<target>.yaml, images-baseline.yaml).
Fails when <key> <image-basename> does not match exactly one repository.

Usage:
    update-image-version <key> <image-basename> <image-version>

Arguments:
    <key>             top-level values.yaml key: a Chart.yaml dependency
                      name or alias, a native component (defined in
                      podiumd itself, e.g. frankgateway) or MULTIPLE for
                      global.images
    <image-basename>  last path segment of the image repository
    <image-version>   image tag

Examples:
    update-image-version zac zaakafhandelcomponent 5.4.4
    update-image-version keycloak-operator python 3.15.7-slim
    update-image-version MULTIPLE curl 8.22.0

To bump a component's app and chart version together, use
update-component-version. Re-render the chart (verify-podiumd) before
committing.
"""
# jscpd:ignore-end

import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.chart_yaml import load_chart_dependencies
from lib.chart.paths import CHART_DIR
from lib.chart.paths import CHART_YAML
from lib.chart.paths import VALUES_YAML
from lib.cli import network_errors
from lib.cli import positional_args
from lib.cli import print_section
from lib.component_docs.doc_updates import complete_docs_and_finish
from lib.dependencies import ensure_vendored_dependencies
from lib.image.version import resolve_key_scope
from lib.image.version import update_image_version
from lib.procutil import run_script

FIX_HELM_DOC_SCRIPT = SCRIPT_DIR / "fix-helm-doc"


def main():
    """CLI entry point."""
    key, basename, new_version = positional_args(__doc__, 3)
    ensure_vendored_dependencies(CHART_DIR)

    deps = load_chart_dependencies(CHART_YAML)
    key = resolve_key_scope(key, deps)

    changes = update_image_version(VALUES_YAML, key, basename, new_version)
    if changes:
        print(f"=== Writing {VALUES_YAML} ===")
        for c in changes:
            print(f"  values.yaml:{c['line']}  ({c['repository']})")
            print(f"    {c['old_version']}@{c['old_digest']}")
            print(f"    {c['new_version']}@{c['new_digest']}")
        print()
        print(f"Updated {len(changes)} pin(s).")
    else:
        # An earlier run may have written values.yaml and stopped before its docs.
        print(f"'{basename}' under '{key}' is already at {new_version} everywhere it's pinned; completing docs.")

    print_section("Regenerating README.md (fix-helm-doc)")
    run_script([sys.executable, str(FIX_HELM_DOC_SCRIPT)])

    # Writes the docs.
    complete_docs_and_finish()


if __name__ == "__main__":
    with network_errors("container registry"):
        main()
