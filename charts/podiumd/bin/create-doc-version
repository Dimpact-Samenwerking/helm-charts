#!/usr/bin/env python3
"""
Create TODO stubs for the upgrade docs of the current target version.

Reads the target from Chart.yaml "version:" and the baseline from
etc/release-baseline.yaml "upgrade_docs". Creates whichever of these are
missing: docs/_UPGRADE_PATHS/<baseline>-to-<target>-{upgrade,
gemeente-specific,values-deltas}.md and docs/images/images-<target>.yaml.
Never changes an existing doc. Then runs fix-helm-doc (README.md).

Exits 1 when release-baseline.yaml or its upgrade_docs key is missing
(run create-podiumd-version), or when docs for the target exist under a
different baseline (run fix-doc-consistency to rebase them).

Usage:
    create-doc-version

Example:
    create-doc-version
        # target 4.10.0, upgrade_docs "4.9.0": creates the missing
        # 4.9.0-to-4.10.0-*.md docs and images-4.10.0.yaml
"""

import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# Not installed as a package -- sys.path must be patched before
# lib.* can be imported, so these imports can't move to the top.
# pylint: disable=wrong-import-position
from lib.chart.historical_baselines import SEMVER_RE as BASELINE_VERSION_RE
from lib.chart.paths import CHART_DIR
from lib.chart.paths import CHART_YAML
from lib.chart.paths import DOC_DIR
from lib.chart.paths import IMAGES_DIR
from lib.chart.release_baseline_basics import chart_version
from lib.chart.release_baseline_basics import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.cli import positional_args
from lib.component_docs.baseline_doc_stubs import create_missing_docs
from lib.component_docs.baseline_doc_stubs import existing_doc_baselines
from lib.procutil import run_script

FIX_HELM_DOC_SCRIPT = SCRIPT_DIR / "fix-helm-doc"


def current_chart_version():
    """Returns the target version to scaffold docs for: charts/podiumd/
    Chart.yaml's own "version:" field."""
    return chart_version(CHART_YAML)


def main():
    """CLI entry point: scaffolds whichever of the standard upgrade-path
    docs and images manifest don't already exist for the current chart
    version, refusing if docs already exist for that target under a
    different upgrade_docs_baseline (use fix-doc-consistency for that
    case instead), then regenerates README.md via fix-helm-doc."""
    positional_args(__doc__, 0)

    upgrade_docs_baseline = read_upgrade_docs_baseline(CHART_DIR)
    if upgrade_docs_baseline is None:
        print(
            "error: release-baseline.yaml has no upgrade_docs key (or the file doesn't "
            "exist yet) — run create-podiumd-version to set it first"
        )
        sys.exit(1)

    if not BASELINE_VERSION_RE.match(upgrade_docs_baseline):
        print(f"error: '{upgrade_docs_baseline}' is not a valid MAJOR.MINOR.PATCH version")
        sys.exit(1)
    target = current_chart_version()

    # Creating and rebasing stay separate: stubs next to docs of another
    # baseline would leave two doc sets for one target.
    by_suffix = existing_doc_baselines(DOC_DIR, target)
    mismatched = {
        suffix: entries for suffix, entries in by_suffix.items() if any(b != upgrade_docs_baseline for b, _ in entries)
    }
    if mismatched:
        print(
            f"error: doc(s) already exist for target {target} under a different upgrade_docs_baseline "
            f"than '{upgrade_docs_baseline}' — refusing to create fresh docs next to them:"
        )
        for _suffix, entries in sorted(mismatched.items()):
            for b, path in sorted(entries):
                print(f"  {path.name}  (upgrade_docs_baseline {b})")
        print()
        print("If this upgrade_docs_baseline change is intentional (a rebase), use fix-doc-consistency instead.")
        sys.exit(1)

    print(f"=== Creating docs for upgrade_docs_baseline {upgrade_docs_baseline} -> target {target} ===")
    created = create_missing_docs(DOC_DIR, IMAGES_DIR, upgrade_docs_baseline, target)
    if created:
        for name in created:
            print(f"  {name}: created")
    else:
        print("  nothing to do — every doc already exists")

    print()
    print("=== Regenerating README.md (fix-helm-doc) ===")
    run_script([sys.executable, str(FIX_HELM_DOC_SCRIPT)])


if __name__ == "__main__":
    main()
