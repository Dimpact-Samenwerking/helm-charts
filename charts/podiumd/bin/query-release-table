#!/usr/bin/env python3
"""
Search etc/release-table.csv and print the matching components.

Prints, as an aligned table, each row whose <column> contains <text>:
name, component, alias, image_basename and the four version columns.
A second table lists the tooling rows ("used_by" set) of a matched
component that the first table doesn't already show.
Create the CSV with export-confluence-release-table.

Usage:
    query-release-table <column> <text>

Arguments:
    <column>  section, vendor or component
    <text>    case-insensitive substring; "zac" matches component
              "zaakafhandelcomponent", "open" matches both "Open Zaak"
              and "Open Formulieren"

Examples:
    query-release-table component zac
    query-release-table vendor maykin
    query-release-table section technische
"""

import sys

from pathlib import Path
from typing import Literal
from typing import TypeGuard

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.paths import CHART_DIR
from lib.cli import positional_args
from lib.release_table.csv_rows import ReleaseTableRow
from lib.release_table.csv_rows import read_existing_release_table

DEFAULT_INPUT = CHART_DIR / "etc" / "release-table.csv"

QueryColumn = Literal["section", "vendor", "component"]
VersionColumn = Literal["source_version_app", "source_version_helm", "target_version_app", "target_version_helm"]

COLUMNS: tuple[QueryColumn, ...] = ("section", "vendor", "component")
VERSION_COLUMNS: tuple[VersionColumn, ...] = (
    "source_version_app",
    "source_version_helm",
    "target_version_app",
    "target_version_helm",
)
TARGET_VERSION_COLUMNS: tuple[VersionColumn, ...] = ("target_version_app", "target_version_helm")
TARGET_TO_SOURCE_COLUMN: dict[VersionColumn, VersionColumn] = {
    "target_version_app": "source_version_app",
    "target_version_helm": "source_version_helm",
}


def is_query_column(value: str) -> TypeGuard[QueryColumn]:
    """Whether `value` is one of COLUMNS."""
    return value in COLUMNS


def matching_rows(
    rows: list[ReleaseTableRow], column: QueryColumn | Literal["alias", "name"], text: str
) -> list[ReleaseTableRow]:
    """Rows whose `column` contains `text`, case-insensitively."""
    needle = text.lower()
    return [row for row in rows if needle in row[column].lower()]


def component_matches(rows: list[ReleaseTableRow], text: str) -> list[ReleaseTableRow]:
    """Rows matching a "component" query, first non-empty of:

    component/alias on component rows (no used_by), component/alias on any
    row, then name. component/alias are the resolved Chart.yaml identifiers,
    so "zac" finds zaakafhandelcomponent rather than a row whose display
    name contains "zac"; name catches UNKNOWN/MULTIPLE rows.
    """
    component_rows = [row for row in rows if not row["used_by"]]
    return (
        _component_or_alias_matches(component_rows, text)
        or _component_or_alias_matches(rows, text)
        or matching_rows(rows, "name", text)
    )


def _component_or_alias_matches(rows: list[ReleaseTableRow], text: str) -> list[ReleaseTableRow]:
    """matching_rows on "component", then "alias", without duplicates."""
    from_component = matching_rows(rows, "component", text)
    seen = {id(row) for row in from_component}
    return from_component + [row for row in matching_rows(rows, "alias", text) if id(row) not in seen]


def used_by_rows_for(rows: list[ReleaseTableRow], matches: list[ReleaseTableRow]) -> list[ReleaseTableRow]:
    """Rows not in `matches` with a used_by and the same resolved component as a match.

    Matches without a real component (blank, MULTIPLE, UNKNOWN) add nothing.
    """
    components = {match["component"] for match in matches} - {"", "MULTIPLE", "UNKNOWN"}
    match_ids = {id(match) for match in matches}
    others = [row for row in rows if id(row) not in match_ids]
    return [row for row in others if row["used_by"] and row["component"] in components]


def display_value(row: ReleaseTableRow, column: VersionColumn) -> str:
    """`row[column]`, or "UNCHANGED" for a target column that is empty or equals its source."""
    value = row[column]
    if column in TARGET_VERSION_COLUMNS and (not value or value == row[TARGET_TO_SOURCE_COLUMN[column]]):
        return "UNCHANGED"
    return value


def _table_cells(row: ReleaseTableRow) -> list[str]:
    """print_table's cells for `row`: its names, then its display_value per version column."""
    versions = [display_value(row, col) for col in VERSION_COLUMNS]
    return [row["name"], row["component"], row["alias"], row["image_basename"], *versions]


def print_table(rows: list[ReleaseTableRow]) -> None:
    """Print `rows` as an aligned table of name/component/alias/image_basename and versions."""
    headers = ["name", "component", "alias", "image_basename", *list(VERSION_COLUMNS)]
    table = [_table_cells(row) for row in rows]
    widths = [max(map(len, column)) for column in zip(headers, *table, strict=True)]
    for line in (headers, *table):
        padded = (cell.ljust(width) for cell, width in zip(line, widths, strict=False))
        print("  ".join(padded))


def print_used_by(rows: list[ReleaseTableRow], matches: list[ReleaseTableRow]) -> None:
    """Print the used_by_rows_for `matches` as a second table, when there are any."""
    used_by_matches = used_by_rows_for(rows, matches)
    if used_by_matches:
        print()
        print("Used by matched component(s):")
        print_table(used_by_matches)


def main():
    """CLI entry point."""
    column, text = positional_args(__doc__, 2)
    if not is_query_column(column):
        print(__doc__)
        sys.exit(1)

    rows = read_existing_release_table(DEFAULT_INPUT)
    matches = component_matches(rows, text) if column == "component" else matching_rows(rows, column, text)
    if not matches:
        print(f"no rows found where {column} contains {text!r}")
        sys.exit(1)

    print(f"Matches for {column} {text!r}:")
    print_table(matches)
    print_used_by(rows, matches)


if __name__ == "__main__":
    main()
