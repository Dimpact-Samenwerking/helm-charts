#!/usr/bin/env python3
"""
Verify that a new image tag actually exists (published) for a
values.yaml image pin, BEFORE writing it — a non-existent tag breaks the
pull at deploy time rather than at edit time. Same <target> <new-version>
shape as update-image-version's own arguments: this is that bump's
pre-flight check, run by hand before committing to it.

<image> can be a bare repository basename (e.g. "curl") or a Chart.yaml
dependency's own name/alias, resolved to the single image it pins —
identical resolution to update-image-version's own <target>, and the
same lib.image_version.resolve_basename call. Reads straight from the
CURRENT values.yaml/Chart.yaml, never pulls a chart: unlike
verify-component-version, no chart-version bump is involved here at all
— see that script instead when the Helm chart version is changing too.

Usage:
    verify-image-version <image> <image-version>

Examples:
    verify-image-version curl 8.22.0
    verify-image-version pabc-api 1.1.2
    verify-image-version openklant 2.15.1
        # "openklant" isn't a basename -- resolved as a Chart.yaml
        # dependency whose own values.yaml scope pins exactly one image

Exit code is non-zero if <image> doesn't resolve to a pinned image, or if
<image-version> does not exist yet for one of its distinct repositories
— safe to use as a gate before bumping values.yaml.
"""
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from lib.image_version import check_basename_version, resolve_basename

CHART_DIR = SCRIPT_DIR.parents[0]
VALUES_YAML = CHART_DIR / "values.yaml"


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    if len(sys.argv) != 3:
        print(__doc__)
        sys.exit(1)
    image, image_version = sys.argv[1], sys.argv[2]

    lines = VALUES_YAML.read_text(encoding="utf-8").splitlines()
    basename = resolve_basename(CHART_DIR, lines, image)
    results = check_basename_version(lines, basename, image_version)

    print(f"Checking image version {image_version!r} for {basename!r}:")
    ok = True
    for r in results:
        status = "FOUND  " if r["exists"] else "MISSING"
        suffix = f"  digest={r['digest']}" if r["digest"] else ""
        print(f"  [{status}] {r['host']}/{r['repo_path']}:{image_version}{suffix}")
        ok = ok and r["exists"]

    print()
    print("OK: image version exists" if ok else "FAIL: image version does not exist yet")
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
