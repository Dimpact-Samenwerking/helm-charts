#!/usr/bin/env python3
"""
Verify that a new image tag actually exists (published) for a
values.yaml image pin, BEFORE writing it — a non-existent tag breaks the
pull at deploy time rather than at edit time. Same <key> <basename>
<new-version> shape as update-image-version's own arguments: this is
that bump's pre-flight check, run by hand before committing to it.

<key> is either a Chart.yaml dependency's own top-level values.yaml key
(a component, e.g. "openklant", "zac") or the literal "MULTIPLE" — the
same convention release-table.csv itself uses (see export-confluence-
release-table's component_and_alias) for a base image shared across
several unrelated components via values.yaml's global.images anchor
block. <key> <basename> together must resolve to exactly one real image
pin under that scope — see lib.image_version.resolve_scoped_matches, the
same resolution update-image-version's own <key> <basename> uses. Reads
straight from the CURRENT values.yaml/Chart.yaml, never pulls a chart:
unlike verify-component-version, no chart-version bump is involved here
at all — see that script instead when the Helm chart version is changing
too.

Usage:
    verify-image-version <key> <basename> <image-version>

Examples:
    verify-image-version zac zaakafhandelcomponent 5.4.4
    verify-image-version keycloak-operator python 3.15.7-slim
    verify-image-version MULTIPLE curl 8.22.0

Exit code is non-zero if <key> <basename> doesn't resolve uniquely, or if
<image-version> does not exist yet upstream — safe to use as a gate
before bumping values.yaml.
"""
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from lib.image_version import check_basename_version

CHART_DIR = SCRIPT_DIR.parents[0]
VALUES_YAML = CHART_DIR / "values.yaml"


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    if len(sys.argv) != 4:
        print(__doc__)
        sys.exit(1)
    key, basename, image_version = sys.argv[1], sys.argv[2], sys.argv[3]

    lines = VALUES_YAML.read_text(encoding="utf-8").splitlines()
    results = check_basename_version(lines, key, basename, image_version)

    print(f"Checking image version {image_version!r} for {key!r} {basename!r}:")
    ok = True
    for r in results:
        status = "FOUND  " if r["exists"] else "MISSING"
        suffix = f"  digest={r['digest']}" if r["digest"] else ""
        print(f"  [{status}] {r['host']}/{r['repo_path']}:{image_version}{suffix}")
        ok = ok and r["exists"]

    print()
    print("OK: image version exists" if ok else "FAIL: image version does not exist yet")
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
