#!/usr/bin/env python3
"""
List every container image the podiumd chart configures.

For each Chart.yaml dependency, merges the sub-chart's default values
with podiumd's values.yaml; also lists images set at podiumd's top
level. Each image prints as two lines:

    <key> <basename> <version>  (path: <values path>)
        <repo>:<tag>

The first line is the argument list for update-image-version,
verify-image-version and show-image-baseline-version. When those
scripts cannot use it, the line ends with a hint: "use MULTIPLE
<basename>" (shared global.images.* image) or "unresolvable". The second
line is the full image reference, digest included.

Usage:
    list-podiumd-images [--refresh]

Options:
    --refresh   `helm pull` every pinned sub-chart, ignore vendored .tgz

Requires: helm on PATH; Helm repositories added (/helm-repos) unless all
sub-charts are vendored.
"""

import shutil
import sys
import tarfile
import tempfile

from dataclasses import dataclass
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.chart_yaml import ChartDependency
from lib.chart.chart_yaml import load_chart_dependencies
from lib.chart.chart_yaml import load_chart_yaml
from lib.chart.nested_subchart_identity import nested_subchart_registered_paths
from lib.chart.paths import CHART_DIR
from lib.chart.paths import CHART_YAML
from lib.chart.paths import VALUES_YAML
from lib.chart.pull_and_subchart_resolution import local_chart_dir
from lib.chart.pull_and_subchart_resolution import pull_chart as _pull_chart
from lib.chart.pull_and_subchart_resolution import pulled_chart_dir
from lib.chart.pull_and_subchart_resolution import require_local_chart_dir
from lib.chart.pull_and_subchart_resolution import subchart_dependencies
from lib.chart.registered_paths import version_paths_for
from lib.chart.repo_and_path_resolution import full_repository_for_path
from lib.chart.values_tree_primitives import find_images
from lib.chart.values_tree_primitives import same_name
from lib.chart.values_tree_primitives import text_at
from lib.chart.values_tree_primitives import values_key_of
from lib.chart.values_tree_primitives import version_of
from lib.dependencies import ensure_vendored_dependencies
from lib.image.version import MULTIPLE_KEY
from lib.image.version import image_basename
from lib.image.version import resolve_scoped_matches
from lib.render_scope import CHART_NAME
from lib.render_scope import lint_args_for
from lib.render_scope import render_chart
from lib.render_scope import rendered_chart_paths
from lib.yaml_types import YamlMapping
from lib.yaml_types import YamlValue
from lib.yaml_types import load_yaml_mapping

VENDORED_DIR = CHART_DIR / "charts"


@dataclass
class ChartContext:
    """Chart.yaml dependencies, unmerged values.yaml, and chart-tree paths a real render produced."""

    deps: list[ChartDependency]
    root_values: YamlMapping
    rendered_paths: set[str]


# (key, path, repo, tag, disabled)
ImageRow = tuple[str, str, str, str, bool]


@dataclass
class ImageEntry:
    """One resolved image reference, ready to print."""

    key: str
    basename: str
    version: str
    repo: str
    tag: str
    path: str
    disabled: bool


@dataclass
class ColumnWidths:
    """Column widths for print_image_lines."""

    key: int
    basename: int
    version: int


def pull_chart(dep: ChartDependency, dest: Path):
    """Pull `dep` at its pinned version into `dest`; SystemExit on failure."""
    ok, stderr = _pull_chart(dep, dep["version"], dest)
    if not ok:
        msg = f"error: helm pull failed for {dep['name']}@{dep['version']}\n{stderr}"
        raise SystemExit(msg)


def safe_extract_tgz(tgz_path: Path, dest: Path):
    """Extract a vendored .tgz, rejecting any member that would land outside dest.

    tarfile.extractall() lacks a containment check before Python 3.11.4
    (no `filter` kwarg). The input is trusted, but the check is cheap.
    filter="data" is added where available: it also rejects escaping
    links, absolute paths and device files.
    """
    dest_resolved = dest.resolve()
    with tarfile.open(tgz_path) as tf:
        for member in tf.getmembers():
            member_path = (dest / member.name).resolve()
            if member_path != dest_resolved and dest_resolved not in member_path.parents:
                msg = f"error: {tgz_path} member '{member.name}' would extract outside {dest}"
                raise SystemExit(msg)
        # Member paths validated above.
        if hasattr(tarfile, "data_filter"):
            tf.extractall(dest, filter="data")
        else:
            tf.extractall(dest)  # nosec B202  # noqa: S202


def load_chart(dep: ChartDependency, tmproot: Path, *, refresh: bool):
    """(chart_yaml, values) for `dep`'s sub-chart; values is {} without values.yaml.

    Source: the file:// directory, else the vendored .tgz unless `refresh`,
    else a fresh `helm pull` into `tmproot`.
    """
    local_dir = local_chart_dir(CHART_DIR, dep)
    if local_dir is not None:
        # --refresh does not apply: the source directory is always current.
        require_local_chart_dir(local_dir, dep)
        chart_dir = local_dir
    else:
        vendored = VENDORED_DIR / f"{dep['name']}-{dep['version']}.tgz"
        dest = tmproot / dep["name"]
        dest.mkdir()
        if not refresh and vendored.exists():
            safe_extract_tgz(vendored, dest)
        else:
            pull_chart(dep, dest)
        chart_dir = pulled_chart_dir(dest)

    chart_yaml = load_chart_yaml(chart_dir / "Chart.yaml")
    values_path = chart_dir / "values.yaml"
    values = load_yaml_mapping(values_path) if values_path.exists() else {}
    return chart_yaml, values or {}


def deep_merge(base: YamlValue, override: YamlValue) -> YamlValue:
    """Merge `override` onto `base` like Helm: dicts merge per key, other values
    (lists too) replace, and None means "no override"."""
    if isinstance(base, dict) and isinstance(override, dict):
        merged = dict(base)
        for key, value in override.items():
            merged[key] = deep_merge(base.get(key), value)
        return merged
    return override if override is not None else base


def resolution_note(values_lines: list[str], key: str, basename: str):
    """None if <key> <basename> resolves for the image scripts, else a short hint.

    Suggests MULTIPLE_KEY when the image only resolves under global.images
    (the usual cause).
    """
    if _resolves(values_lines, key, basename):
        return None
    if not same_name(key, MULTIPLE_KEY) and _resolves(values_lines, MULTIPLE_KEY, basename):
        return f"use {MULTIPLE_KEY} {basename}"
    return "unresolvable"


def _resolves(values_lines: list[str], key: str, basename: str) -> bool:
    """True if resolve_scoped_matches accepts <key> <basename>; it exits on failure."""
    try:
        resolve_scoped_matches(values_lines, key, basename)
    except SystemExit:
        return False
    return True


def _sorted_image_entries(rows: list[ImageRow]) -> list[ImageEntry]:
    """ImageEntry list sorted by key, then path."""
    entries = [
        ImageEntry(key, image_basename(repo), version_of(tag), repo, tag, path, disabled)
        for key, path, repo, tag, disabled in rows
    ]
    entries.sort(key=lambda e: (e.key, e.path))
    return entries


def _column_widths(entries: list[ImageEntry]):
    return ColumnWidths(
        key=max(len(e.key) for e in entries),
        basename=max(len(e.basename) for e in entries),
        version=max(len(e.version) for e in entries),
    )


def _print_image_entry(entry: ImageEntry, values_lines: list[str], widths: ColumnWidths):
    """Print an entry's two lines: aligned "<key> <basename> <version> (path: ...)"
    with "disabled"/resolution hints, then the full "<repo>:<tag>"."""
    note = resolution_note(values_lines, entry.key, entry.basename)
    line = (
        f"  {entry.key.ljust(widths.key)}  {entry.basename.ljust(widths.basename)}  "
        f"{entry.version.ljust(widths.version)}  (path: {entry.path})"
    )
    hints = (["disabled"] if entry.disabled else []) + ([note] if note else [])
    if hints:
        line += "  — " + "; ".join(hints)
    print(line)
    print(f"      {entry.repo}:{entry.tag}")


def print_image_lines(rows: list[ImageRow], values_lines: list[str]) -> None:
    """Print two lines per row.

    `disabled` means the row's chart-tree path did not render, e.g. a nested
    bitnami/redis disabled via podiumd's "tags: {redis: false}".
    """
    entries = _sorted_image_entries(rows)
    widths = _column_widths(entries)
    for entry in entries:
        _print_image_entry(entry, values_lines, widths)


def row_chart_tree_path(chart_dir: Path, dep: ChartDependency, first_segment: str):
    """Chart-tree path owning a row under `dep` whose dep-relative path starts with `first_segment`.

    `dep`'s own path, or a nested dependency's when `first_segment` matches its
    name or alias (e.g. eck-stack's eck-elasticsearch). Each level uses the
    alias when set: Helm's "# Source:" paths do (kiss-eck, not eck-stack).
    """
    nested = next(
        (d for d in subchart_dependencies(chart_dir, dep) if first_segment in (d.get("alias"), d["name"])), None
    )
    base = f"{CHART_NAME}/charts/{dep.get('alias') or dep['name']}"
    if nested is None:
        return base
    return f"{base}/charts/{nested.get('alias') or nested['name']}"


def component_version_rows(dep: ChartDependency, key: str, merged: YamlMapping, ctx: ChartContext) -> list[ImageRow]:
    """Rows for `dep`'s registered bare version fields, which find_images cannot see.

    E.g. redis-operator's split imageName/imageTag, eck-stack's CRD version
    fields. The tag comes from `merged` (chart defaults included: this tool
    lists the effective image set). The repository comes from
    full_repository_for_path against VENDORED_DIR.parent (tests repoint it)
    and root_values, without pulling; fields without a repository are
    skipped. `disabled` is checked against the row's own chart-tree path,
    which can be a nested subchart toggled independently of `dep`.
    """
    rows: list[ImageRow] = []
    # CHART_DIR: settings.yaml lookup; tests only repoint VENDORED_DIR.
    rels = sorted(
        set(version_paths_for(dep["name"], CHART_DIR)) | set(nested_subchart_registered_paths(dep["name"], CHART_DIR))
    )
    for rel in rels:
        tag = text_at(merged, rel)
        if not (isinstance(tag, str) and tag):
            continue
        path = (key, *tuple(rel.split(".")))
        repo = full_repository_for_path(VENDORED_DIR.parent, ctx.deps, ctx.root_values, path, allow_pull=False)
        if not repo:
            continue
        chart_tree_path = row_chart_tree_path(VENDORED_DIR.parent, dep, rel.split(".", 1)[0])
        rows.append((key, rel, repo, tag, chart_tree_path not in ctx.rendered_paths))
    return rows


def _compute_rendered_paths():
    """Chart-tree paths a real render produces.

    Asks Helm instead of re-implementing condition:/tags: (which also apply
    to nested dependencies). Renders VENDORED_DIR.parent, which tests repoint.
    """
    chart_dir = VENDORED_DIR.parent
    extra_args = lint_args_for(chart_dir)
    render_result = render_chart(chart_dir, extra_args)
    if render_result.returncode != 0:
        msg = f"error: helm template failed to render\n{render_result.stderr}"
        raise SystemExit(msg)
    return rendered_chart_paths(render_result.stdout)


def _top_level_image_rows(root_values: YamlMapping, dep_keys: set[str]) -> list[ImageRow]:
    """Rows for top-level values not tied to a dependency (e.g. global.images.*); never disabled."""
    rows: list[ImageRow] = []
    for key, value in root_values.items():
        if key not in dep_keys:
            rows.extend((key, path, repo, tag, False) for path, repo, tag in find_images(value))
    return rows


def _print_dependency_header(dep: ChartDependency, ctx: ChartContext):
    """Print the "=== <key> (<name> <version>) [disabled] ===" header; return the values key."""
    key = values_key_of(dep)
    dep_chart_tree_path = f"{CHART_NAME}/charts/{key}"
    enabled = dep_chart_tree_path in ctx.rendered_paths
    status = "" if enabled else "  [disabled]"
    print(f"=== {key} ({dep['name']} {dep['version']}){status} ===")
    return key


def _merged_image_rows(dep: ChartDependency, key: str, merged: YamlMapping, ctx: ChartContext) -> list[ImageRow]:
    """Rows for `dep`'s effective images: find_images on `merged` plus component_version_rows."""
    rows: list[ImageRow] = []
    for path, repo, tag in find_images(merged):
        # path is a dotted string, e.g. "redis.image".
        chart_tree_path = row_chart_tree_path(VENDORED_DIR.parent, dep, path.split(".", 1)[0])
        rows.append((key, path, repo, tag, chart_tree_path not in ctx.rendered_paths))
    rows.extend(component_version_rows(dep, key, merged, ctx))
    return rows


def _print_dependency_images(
    dep: ChartDependency, tmproot: Path, ctx: ChartContext, values_lines: list[str], *, refresh: bool
):
    """Print a dependency's section: appVersion, sub-chart dependencies and images."""
    key = _print_dependency_header(dep, ctx)

    try:
        chart_yaml, defaults = load_chart(dep, tmproot, refresh=refresh)
    except SystemExit as e:
        print(f"  {e}\n")
        return

    print(f"  appVersion: {chart_yaml.get('appVersion', 'n/a')}")

    sub_deps = chart_yaml.get("dependencies", [])
    if sub_deps:
        print("  sub-chart dependencies:")
        for d in sub_deps:
            print(f"    - {d['name']}: {d['version']}")

    overrides = ctx.root_values.get(key, {})
    merged = deep_merge(defaults, overrides)
    rows = _merged_image_rows(dep, key, merged if isinstance(merged, dict) else {}, ctx)
    if rows:
        print_image_lines(rows, values_lines)
    else:
        print("  (no image references found)")
    print()


def main():
    """CLI entry point."""
    if "-h" in sys.argv[1:] or "--help" in sys.argv[1:]:
        print(__doc__)
        sys.exit(0)
    refresh = "--refresh" in sys.argv[1:]
    ensure_vendored_dependencies(VENDORED_DIR.parent)

    deps = load_chart_dependencies(CHART_YAML)
    root_values = load_yaml_mapping(VALUES_YAML)
    dep_keys = {values_key_of(dep) for dep in deps}
    values_lines = VALUES_YAML.read_text(encoding="utf-8").splitlines()
    ctx = ChartContext(deps=deps, root_values=root_values, rendered_paths=_compute_rendered_paths())

    tmproot = Path(tempfile.mkdtemp(prefix="list-podiumd-images-"))
    try:
        top_level_images = _top_level_image_rows(root_values, dep_keys)
        if top_level_images:
            print("=== podiumd top-level values (not part of a dependency) ===")
            print_image_lines(top_level_images, values_lines)
            print()

        for dep in ctx.deps:
            _print_dependency_images(dep, tmproot, ctx, values_lines, refresh=refresh)
    finally:
        shutil.rmtree(tmproot, ignore_errors=True)


if __name__ == "__main__":
    main()
