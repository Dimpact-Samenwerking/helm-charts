#!/usr/bin/env python3
"""
List every container image (repository + tag) actually configured for the
podiumd chart: for each Chart.yaml dependency, the sub-chart's default
values.yaml merged with podiumd's own overrides in values.yaml, plus any
images configured directly at the top level of podiumd's own values.yaml.

Each image is printed as two lines. The first is short: "<key> <basename>
<version>  (path: ...)" — <key> <basename> <version> is the same
argument order update-image-version/verify-image-version/show-image-
baseline-version take, so it doubles as the exact arguments to hand one
of those scripts; the values.yaml path it was found at is right there
too. The second, indented line has the full "<repo>:<tag>" (digest
included, never truncated) — for filling in a Confluence release-notes
row (repo:tag/digest, appVersion, chart version, sub-chart dependencies)
or manual lookup.

<key> <basename> is only real, resolvable input for those other scripts
when it's a literal digest pin in THIS chart's own values.yaml — the
same lib.image_version.resolve_scoped_matches check they use. A row
whose image instead comes from the sub-chart's own default (no podiumd
override at all), from a shared values.yaml global.images.* image
aliased into more than one component, or from a split tag/sha or
non-digest pin those tools can't see structurally, gets a short trailing
hint on its FIRST line ("use MULTIPLE <basename>", or "unresolvable")
instead of a silently-wrong copy/paste — kept brief so it fits
comfortably alongside <key> <basename> <version> and the path.

Usage:
    list-podiumd-images [--refresh]

    --refresh   Ignore locally vendored charts/podiumd/charts/*.tgz and
                always `helm pull` the pinned version instead.

Requires the Helm repositories to already be added (see /helm-repos or
charts/podiumd/scripts/add-helm-repos.sh) and the `helm` CLI on PATH, unless
every dependency is already vendored locally (e.g. after `helm dependency
update`), in which case no network access is needed at all.
"""
import sys
import tempfile
import shutil
import tarfile
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from lib.chart import (
    find_images, full_repository_for_path, get_path, load_yaml, local_chart_dir,
    nested_subchart_registered_paths, pulled_chart_dir, subchart_dependencies, version_of, version_paths_for,
)
from lib.chart import pull_chart as _pull_chart
from lib.image_version import MULTIPLE_KEY, image_basename, resolve_scoped_matches
from lib.render_scope import CHART_NAME, lint_args_for, render_chart, rendered_chart_paths

PODIUMD_DIR = SCRIPT_DIR.parents[0]
CHART_YAML = PODIUMD_DIR / "Chart.yaml"
VALUES_YAML = PODIUMD_DIR / "values.yaml"
VENDORED_DIR = PODIUMD_DIR / "charts"


def pull_chart(dep, dest):
    ok, stderr = _pull_chart(dep, dep["version"], dest)
    if not ok:
        raise SystemExit(f"error: helm pull failed for {dep['name']}@{dep['version']}\n{stderr}")


def load_chart(dep, tmproot, refresh):
    local_dir = local_chart_dir(PODIUMD_DIR, dep)
    if local_dir is not None:
        # A "file://" dependency has no remote to pull from and no vendored
        # .tgz shape to extract — --refresh is meaningless for it either
        # way, since reading its own source directory is already always
        # current, never stale.
        if not local_dir.is_dir():
            raise SystemExit(f"error: dependency '{dep['name']}' declares local path repository "
                              f"({dep['repository']}), but {local_dir} does not exist")
        chart_dir = local_dir
    else:
        vendored = VENDORED_DIR / f"{dep['name']}-{dep['version']}.tgz"
        dest = tmproot / dep["name"]
        dest.mkdir()
        if not refresh and vendored.exists():
            with tarfile.open(vendored) as tf:
                tf.extractall(dest)
        else:
            pull_chart(dep, dest)
        chart_dir = pulled_chart_dir(dest)

    chart_yaml = load_yaml(chart_dir / "Chart.yaml")
    values_path = chart_dir / "values.yaml"
    values = load_yaml(values_path) if values_path.exists() else {}
    return chart_yaml, values or {}


def deep_merge(base, override):
    if isinstance(base, dict) and isinstance(override, dict):
        merged = dict(base)
        for key, value in override.items():
            merged[key] = deep_merge(base.get(key), value)
        return merged
    return override if override is not None else base


def resolution_note(values_lines, key, basename):
    """None if <key> <basename> is real, resolvable input for update-
    image-version/verify-image-version/show-image-baseline-version (see
    lib.image_version.resolve_scoped_matches) — otherwise a short hint
    so a reader doesn't copy/paste a pair that will just fail elsewhere.
    Falls back to checking MULTIPLE_KEY (values.yaml's global.images.*
    scope) before giving up, since that's the single most common reason
    a per-component <key> doesn't resolve: the image lives under
    global.images and is only ALIASED into this component, with no
    literal pin of its own here — kept to the one thing a reader needs
    (the key that DOES work) so it still fits on the row's short first
    line alongside <key> <basename> <version> and the values.yaml path."""
    try:
        resolve_scoped_matches(values_lines, key, basename)
        return None
    except SystemExit:
        pass
    if key != MULTIPLE_KEY:
        try:
            resolve_scoped_matches(values_lines, MULTIPLE_KEY, basename)
            return f"use {MULTIPLE_KEY} {basename}"
        except SystemExit:
            pass
    return "unresolvable"


def print_image_lines(rows, values_lines):
    """rows: [(key, path, repo, tag, disabled), ...] — `disabled` is True
    when this row's own chart-tree path (see lib.render_scope.
    rendered_chart_paths and row_chart_tree_path below) never actually
    rendered: a dependency (or one of ITS OWN nested dependencies —
    e.g. a Maykin chart's own bundled bitnami/redis, globally disabled
    via podiumd's top-level "tags: {redis: false}") disabled via Helm's
    condition:/tags: mechanism. Prints two lines per row (see module
    docstring): a short, column-aligned "<key> <basename> <version>
    (path: ...)" line — <key> <basename> <version> is exactly the
    copy/paste-able input for update-image-version/verify-image-
    version/show-image-baseline-version, plus a trailing "disabled"
    hint (never silently indistinguishable from a real, live image) and
    any resolution_note, since that's precisely what decides whether
    this row's <key> <basename> is real input for those scripts —
    followed by an indented line with the full "<repo>:<tag>" (digest
    included, never truncated), for Confluence or manual lookup."""
    entries = []
    for key, path, repo, tag, disabled in rows:
        entries.append((key, image_basename(repo), version_of(tag), repo, tag, path, disabled))
    entries.sort(key=lambda e: (e[0], e[5]))
    kwidth = max(len(e[0]) for e in entries)
    bwidth = max(len(e[1]) for e in entries)
    vwidth = max(len(e[2]) for e in entries)
    for key, basename, version, repo, tag, path, disabled in entries:
        note = resolution_note(values_lines, key, basename)
        line = (f"  {key.ljust(kwidth)}  {basename.ljust(bwidth)}  {version.ljust(vwidth)}  "
                f"(path: {path})")
        hints = (["disabled"] if disabled else []) + ([note] if note else [])
        if hints:
            line += "  — " + "; ".join(hints)
        print(line)
        print(f"      {repo}:{tag}")


def row_chart_tree_path(chart_dir, dep, first_segment):
    """The chart-tree path (see lib.render_scope.rendered_chart_paths)
    that actually OWNS a row nested under `dep`'s own scope at
    `first_segment` (the row's own dep-relative path's first segment,
    e.g. "redis" for a Maykin chart's own bundled bitnami/redis sidecar,
    or "eck-elasticsearch" for eck-stack's own nested eck-elasticsearch
    sub-subchart) — `dep`'s own top-level chart-tree path normally, but
    the path of one of `dep`'s OWN declared Chart.yaml dependencies
    instead when `first_segment` matches one of them (name or alias) —
    same convention lib.chart.resolve_subchart_default already uses for
    this exact question (there, for a subchart-default-only image;
    here, for any row regardless of where its tag actually came from).

    Each level is keyed by that dependency's own VALUES-KEY (alias if
    it declares one, else its real name) — Helm's own "# Source:"
    annotations name a chart-tree directory by alias when present,
    confirmed live against the real chart (eck-stack, aliased
    "kiss-eck", renders under "podiumd/charts/kiss-eck/...", never
    ".../eck-stack/...")."""
    nested = next((d for d in subchart_dependencies(chart_dir, dep)
                    if first_segment in (d.get("alias"), d["name"])), None)
    base = f"{CHART_NAME}/charts/{dep.get('alias') or dep['name']}"
    if nested is None:
        return base
    return f"{base}/charts/{nested.get('alias') or nested['name']}"


def component_version_rows(dep, key, merged, deps, root_values, rendered_paths):
    """Extra (key, path, repo, tag, disabled) rows for `dep`'s own lib.chart.
    COMPONENT_VERSION_PATHS/COMPONENT_VERSION_PATH_NESTED_SUBCHARTS-
    registered bare version fields — the ONE image shape find_images'
    generic "{repository, tag}" dict match structurally can never see at
    all (redis-operator's own split imageName/imageTag sibling fields;
    eck-stack's own eck-elasticsearch/eck-kibana/eck-enterprise-search
    CRD-version-only fields), the exact same registry lib.upgradedoc.
    find_component_version_tags/lib.chart.paths_by_repository already
    resolve for the doc-generation side — reused here via the SAME
    resolution functions, never re-derived.

    Tag comes from `merged` (chart defaults + podiumd's own overrides,
    for THIS one dependency) rather than root_values alone — unlike the
    doc-generation side, which only ever cares about podiumd's own
    explicit overrides, this tool's whole point is the full EFFECTIVE
    image set, chart defaults included.

    Repository comes from full_repository_for_path — the exact same
    per-path resolution chain paths_by_repository uses (podiumd's own
    override, then a registered sibling field, then a registered nested
    subchart's own documented default, then the dependency's own
    vendored subchart default) — called against VENDORED_DIR.parent
    (podiumd's own chart root, where every dependency's vendored .tgz
    actually lives — read via VENDORED_DIR, not the module-level
    PODIUMD_DIR constant directly, so this stays correct under whatever
    tests/conftest.py's own `lpi` fixture repoints VENDORED_DIR to,
    exactly like load_chart's own vendored-.tgz lookup already does) and
    root_values (podiumd's own, unmerged values.yaml): the exact shape
    those functions were built for, NOT this script's own per-dependency
    tmproot-extracted chart_dir (a different directory entirely, one
    level further in — the SUBCHART's own root). Never pulls
    (allow_pull=False, matching paths_by_repository's own default):
    whatever `load_chart` already resolved for this dependency's OWN
    chart version is enough; a bare version field with no resolvable
    repository anywhere (not the case for either real field registered
    today, but always possible in principle) is silently skipped — same
    "not every image has a resolvable repository" philosophy paths_by_
    repository's own docstring already documents, rather than printing
    a row with no real repository.

    `rendered_paths` (see lib.render_scope.rendered_chart_paths) gates
    each row's own `disabled` flag (see print_image_lines) against ITS
    OWN owning chart-tree path — row_chart_tree_path, which may be a
    NESTED path when `rel`'s own first segment matches one of `dep`'s
    OWN declared Chart.yaml dependencies (e.g. eck-stack's own
    eck-elasticsearch/eck-kibana/eck-enterprise-search sub-subcharts) —
    never just `dep`'s own top-level enabled/disabled status, which a
    per-field toggle can disagree with independently."""
    rows = []
    rels = sorted(set(version_paths_for(dep["name"])) | set(nested_subchart_registered_paths(dep["name"])))
    for rel in rels:
        tag = get_path(merged, rel)
        if not (isinstance(tag, str) and tag):
            continue
        path = (key,) + tuple(rel.split("."))
        repo = full_repository_for_path(VENDORED_DIR.parent, deps, root_values, path, allow_pull=False)
        if not repo:
            continue
        chart_tree_path = row_chart_tree_path(VENDORED_DIR.parent, dep, rel.split(".", 1)[0])
        rows.append((key, rel, repo, tag, chart_tree_path not in rendered_paths))
    return rows


def main():
    if "-h" in sys.argv[1:] or "--help" in sys.argv[1:]:
        print(__doc__)
        sys.exit(0)
    refresh = "--refresh" in sys.argv[1:]

    deps = load_yaml(CHART_YAML)["dependencies"]
    root_values = load_yaml(VALUES_YAML) or {}
    dep_keys = {dep.get("alias", dep["name"]) for dep in deps}
    values_lines = VALUES_YAML.read_text(encoding="utf-8").splitlines()

    # Real ground truth for "is this dependency (or one of ITS OWN nested
    # dependencies) actually enabled" — Helm's own condition:/tags:
    # mechanism (either can apply transitively to a nested dependency
    # too, e.g. a Maykin chart's own bundled bitnami/redis, globally
    # disabled via podiumd's top-level "tags: {redis: false}") is asked
    # directly via a real render, rather than re-implemented here (see
    # row_chart_tree_path/component_version_rows below). Rendered
    # against VENDORED_DIR.parent, not PODIUMD_DIR directly, same
    # reason component_version_rows already does — stays correct under
    # whatever tests/conftest.py's own `lpi` fixture repoints
    # VENDORED_DIR to.
    chart_dir = VENDORED_DIR.parent
    extra_args = lint_args_for(chart_dir)
    render_result = render_chart(chart_dir, extra_args)
    if render_result.returncode != 0:
        raise SystemExit(f"error: helm template failed to render\n{render_result.stderr}")
    rendered_paths = rendered_chart_paths(render_result.stdout)

    tmproot = Path(tempfile.mkdtemp(prefix="list-podiumd-images-"))
    try:
        # Top-level values not tied to any dependency (e.g. global.images.*)
        top_level_images = []
        for key, value in root_values.items():
            if key not in dep_keys:
                top_level_images.extend((key, path, repo, tag, False) for path, repo, tag in find_images(value))
        if top_level_images:
            print("=== podiumd top-level values (not part of a dependency) ===")
            print_image_lines(top_level_images, values_lines)
            print()

        for dep in deps:
            key = dep.get("alias", dep["name"])
            dep_chart_tree_path = f"{CHART_NAME}/charts/{key}"
            enabled = dep_chart_tree_path in rendered_paths
            status = "" if enabled else "  [disabled]"
            print(f"=== {key} ({dep['name']} {dep['version']}){status} ===")

            try:
                chart_yaml, defaults = load_chart(dep, tmproot, refresh)
            except SystemExit as e:
                print(f"  {e}\n")
                continue

            print(f"  appVersion: {chart_yaml.get('appVersion', 'n/a')}")

            sub_deps = chart_yaml.get("dependencies", [])
            if sub_deps:
                print("  sub-chart dependencies:")
                for d in sub_deps:
                    print(f"    - {d['name']}: {d['version']}")

            overrides = root_values.get(key, {})
            merged = deep_merge(defaults, overrides)
            rows = []
            for path, repo, tag in find_images(merged):
                # find_images' own path is a dotted STRING (e.g.
                # "redis.image"), not a tuple — its first dotted segment
                # is what row_chart_tree_path needs.
                chart_tree_path = row_chart_tree_path(VENDORED_DIR.parent, dep, path.split(".", 1)[0])
                rows.append((key, path, repo, tag, chart_tree_path not in rendered_paths))
            rows.extend(component_version_rows(dep, key, merged, deps, root_values, rendered_paths))
            if rows:
                print_image_lines(rows, values_lines)
            else:
                print("  (no image references found)")
            print()
    finally:
        shutil.rmtree(tmproot, ignore_errors=True)


if __name__ == "__main__":
    main()
