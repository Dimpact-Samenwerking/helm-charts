#!/usr/bin/env python3
"""Estimate the size of the Helm release Secret a chart would produce.

Kubernetes caps a Secret at 1 MiB; a release over it fails to install or
upgrade. The estimate uses the same encoding Helm does, so a chart
approaching the limit is flagged before a cluster rejects it. For podiumd
this also runs as verify-podiumd's "Release secret size" step.

Examples:
    verify-helm-secret-size --chart charts/podiumd \\
        -f charts/podiumd/ci/lint-values.yaml --record
    verify-helm-secret-size --chart charts/monitoring-logging --record

Requires: helm on PATH.
"""

import argparse
import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# Not installed as a package -- sys.path must be patched before
# lib.* can be imported, so these imports can't move to the top.
# pylint: disable=wrong-import-position
from lib.dependencies import ensure_vendored_dependencies
from lib.procutil import run
from lib.release_secret_size import build_release
from lib.release_secret_size import encoded_secret_size
from lib.release_secret_size import format_report
from lib.release_secret_size import over_limit_warning
from lib.release_secret_size import record_result
from lib.settings import release_secret_kubernetes_limit_bytes
from lib.settings import release_secret_warn_at_fraction_of_limit
from lib.yaml_types import load_yaml_mapping


def _parse_args():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--chart", required=True, help="path to the chart directory")
    parser.add_argument("-f", "--values", help="values override file, e.g. ci/lint-values.yaml")
    parser.add_argument("--name", help="release name for `helm template` (defaults to chart dir name)")
    parser.add_argument("--namespace", default="default", help="release namespace (default: default)")
    parser.add_argument(
        "--record", action="store_true", help="add or update the row in <chart>/docs/release-secret-size.md"
    )
    return parser.parse_args()


def _render(chart_dir: Path, name: str, values_path: Path | None):
    """`helm template` for `chart_dir`. --skip-schema-validation only
    exists on newer Helm (this repo's own KISS sub-chart JSON schema needs
    it skipped there, per /helm-render-all's own notes) — tried first, but
    never assumed: an older `helm` on PATH (no such flag at all) falls
    back to the plain command instead of hard-failing on "unknown flag",
    the same tolerance lib.render_scope.render_chart's own callers get for
    free by never passing it in the first place (verify-podiumd's own
    render never needed it against this chart's current schema either,
    empirically)."""
    helm_cmd = ["helm", "template", name, str(chart_dir)]
    if values_path:
        helm_cmd += ["-f", str(values_path)]
    rendered = run([*helm_cmd, "--skip-schema-validation"], capture_output=True, text=True)
    if rendered.returncode != 0 and "unknown flag: --skip-schema-validation" in rendered.stderr:
        rendered = run(helm_cmd, capture_output=True, text=True)
    return rendered


def main():
    """CLI entry point: renders `--chart` with helm template, estimates the
    resulting Helm release Secret's gzip+base64 size against the Kubernetes
    1 MiB limit, optionally records a row via --record, and exits 1 if the
    size is at or above the configured warn threshold."""
    args = _parse_args()

    chart_dir = Path(args.chart).resolve()
    ensure_vendored_dependencies(chart_dir)
    name = args.name or chart_dir.name

    values_path = Path(args.values).resolve() if args.values else None
    values_override = load_yaml_mapping(values_path) if values_path else None

    rendered = _render(chart_dir, name, values_path)
    if rendered.returncode != 0:
        print(rendered.stderr, file=sys.stderr)
        sys.exit(1)

    secret_limit = release_secret_kubernetes_limit_bytes(chart_dir)
    warn_threshold = release_secret_warn_at_fraction_of_limit(chart_dir)

    release, version, warnings = build_release(chart_dir, values_override, rendered.stdout, name, args.namespace)
    for warning in warnings:
        print(f"WARNING: {warning}", file=sys.stderr)

    estimate = encoded_secret_size(release, secret_limit)
    print(format_report(chart_dir.name, version, estimate))

    if args.record:
        doc_path = record_result(chart_dir, chart_dir.name, str(version), estimate.size, estimate.pct)
        print(f"recorded:       {doc_path}")

    if estimate.pct >= warn_threshold:
        print(f"\nWARNING: {over_limit_warning(chart_dir.name, version, estimate)}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
