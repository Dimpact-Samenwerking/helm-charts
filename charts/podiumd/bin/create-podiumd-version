#!/usr/bin/env python3
"""
Start a new podiumd release cycle on a feature/podiumd-<X.Y.Z> branch.

Takes the target version from the branch name and the outgoing version
from Chart.yaml's version. Then:
  - writes the outgoing version to charts/podiumd/etc/release-
    baseline.yaml as upgrade_docs; on a minor bump also as release_table
  - sets Chart.yaml version and appVersion to the target
  - runs create-doc-version to create the missing upgrade docs

Rerunnable: when Chart.yaml is already at the target, the outgoing
version is release-baseline.yaml's upgrade_docs. Only values that differ
are written; when everything is set, nothing changes.

The jump must be one patch step (4.9.0 -> 4.9.1) or one minor step
(4.9.1 -> 4.10.0). Fails when the branch name has another shape, the
jump is anything else, or a baseline to record has no podiumd-<version>
tag or feature/podiumd-<version> branch. On a rerun, fails when
upgrade_docs is missing (set it with change-podiumd-baseline).

Usage:
    create-podiumd-version

Example:
    # on feature/podiumd-4.9.1, Chart.yaml at 4.9.0
    create-podiumd-version    # Chart.yaml -> 4.9.1, upgrade_docs 4.9.0
"""

import re
import sys

from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

# sys.path must be patched before lib.* can be imported.
# pylint: disable=wrong-import-position
from lib.chart.historical_baselines import SEMVER_RE as CHART_VERSION_RE
from lib.chart.paths import CHART_DIR
from lib.chart.paths import CHART_YAML
from lib.chart.release_baseline_basics import chart_version
from lib.chart.release_baseline_basics import release_table_baseline as read_release_table_baseline
from lib.chart.release_baseline_basics import upgrade_docs_baseline as read_upgrade_docs_baseline
from lib.chart.release_baseline_basics import write_release_baselines
from lib.chart.values_tree_primitives import replace_scalar_value
from lib.cli import positional_args
from lib.gitutil import current_branch
from lib.gitutil import find_repo_root
from lib.gitutil import resolve_baseline_ref
from lib.procutil import run_script

CREATE_DOC_VERSION_SCRIPT = SCRIPT_DIR / "create-doc-version"

BRANCH_RE = re.compile(r"^feature/podiumd-(\d+\.\d+\.\d+)$")


def current_chart_version():
    """Chart.yaml's current version."""
    return chart_version(CHART_YAML)


def version_tuple(v: str):
    """Parse "MAJOR.MINOR.PATCH" into an int tuple; ValueError if not dot-separated ints."""
    return tuple(int(part) for part in v.split("."))


def bump_kind(baseline: str, target: str):
    """ "patch", "minor", or None when not a single patch/minor increment."""
    b_major, b_minor, b_patch = version_tuple(baseline)
    t_major, t_minor, t_patch = version_tuple(target)
    if b_major == t_major and b_minor == t_minor and t_patch == b_patch + 1:
        return "patch"
    if b_major == t_major and t_minor == b_minor + 1 and t_patch == 0:
        return "minor"
    return None


def update_chart_version(new_version: str) -> list[str]:
    """Set Chart.yaml "version:" and "appVersion:" to new_version.

    Returns the changed field names in file order; writes nothing when none change.
    """
    lines = CHART_YAML.read_text(encoding="utf-8").splitlines(keepends=True)
    changed: list[str] = []
    found_version = False
    for i, line in enumerate(lines):
        m = re.match(r"^(version|appVersion):\s", line)
        if not m:
            continue
        found_version = found_version or m.group(1) == "version"
        new_line = replace_scalar_value(line, new_version)
        if new_line != line:
            lines[i] = new_line
            changed.append(m.group(1))
    if not found_version:
        msg = f"error: could not find a top-level 'version:' line in {CHART_YAML}"
        raise SystemExit(msg)
    if changed:
        CHART_YAML.write_text("".join(lines), encoding="utf-8")
    return changed


def _resolve_baseline_refs(repo_root: Path, upgrade_docs: str, release_table: str | None) -> dict[str, str]:
    """{"upgrade_docs": ref, "release_table": ref} for the two new baseline
    values; exits 1 if release_table is None or either value has no ref."""
    resolved_refs: dict[str, str] = {}
    for label, value in (("upgrade_docs", upgrade_docs), ("release_table", release_table)):
        if value is None:
            print(
                "error: release_table baseline is not yet recorded in release-baseline.yaml "
                "— cannot open a patch release without one already set (a minor-bump run "
                "records it for the first time; there's no fallback for a patch bump)"
            )
            sys.exit(1)
        ref, error = resolve_baseline_ref(repo_root, value)
        if ref is None:
            print(f"error: {label} baseline '{value}': {error}")
            sys.exit(1)
        resolved_refs[label] = ref
    return resolved_refs


def outgoing_version(chart_version_now: str, target: str) -> str:
    """The version this release cycle moves away from: Chart.yaml's
    version, or on a rerun (Chart.yaml already at target) the recorded
    upgrade_docs baseline. Exits 1 when a rerun's upgrade_docs is
    missing or is not a plain MAJOR.MINOR.PATCH."""
    if chart_version_now != target:
        return chart_version_now
    recorded = read_upgrade_docs_baseline(CHART_DIR)
    if recorded is None or not CHART_VERSION_RE.match(recorded):
        print(
            f"error: {CHART_YAML.name} is already at {target}, but release-baseline.yaml "
            f"upgrade_docs is {recorded!r} — set it with change-podiumd-baseline"
        )
        sys.exit(1)
    return recorded


def main():
    """CLI entry point."""
    positional_args(__doc__, 0)

    repo_root = find_repo_root(CHART_DIR)
    if repo_root is None:
        print("error: not inside a git repository")
        sys.exit(1)

    branch = current_branch(repo_root)
    m = BRANCH_RE.match(branch)
    if not m:
        print(
            f"error: current branch '{branch or '(detached HEAD)'}' does not match "
            f"'feature/podiumd-<MAJOR.MINOR.PATCH>' — refusing to guess the target version"
        )
        sys.exit(1)
    target = m.group(1)

    chart_version_now = current_chart_version()
    if not CHART_VERSION_RE.match(chart_version_now):
        print(f"error: {CHART_YAML}'s version '{chart_version_now}' is not a plain MAJOR.MINOR.PATCH")
        sys.exit(1)
    baseline = outgoing_version(chart_version_now, target)

    kind = bump_kind(baseline, target)
    if kind is None:
        print(
            f"error: {baseline} -> {target} is not a single patch increment (same "
            f"major.minor, patch+1) or a single minor increment (same major, minor+1, "
            f"patch 0) — refusing. A major-version change is out of scope for this tool; "
            f"a skipped version or a same-or-lower target isn't supported either."
        )
        sys.exit(1)

    # A minor bump marks a Confluence-documented release, so release_table
    # moves with it; a patch bump keeps the recorded one.
    recorded_release_table = read_release_table_baseline(CHART_DIR)
    new_release_table = baseline if kind == "minor" else recorded_release_table

    resolved_refs = _resolve_baseline_refs(repo_root, baseline, new_release_table)

    # Baselines before Chart.yaml: a run interrupted in between still
    # sees the outgoing version in Chart.yaml and redoes both.
    baselines_changed = read_upgrade_docs_baseline(CHART_DIR) != baseline or recorded_release_table != new_release_table
    if baselines_changed:
        write_release_baselines(CHART_DIR, upgrade_docs=baseline, release_table=(baseline if kind == "minor" else None))

    changed = update_chart_version(target)
    if changed:
        print(f"{CHART_YAML.name}: {', '.join(changed)} {baseline} -> {target} ({kind} bump)")
    else:
        print(f"{CHART_YAML.name}: already at {target} ({kind} bump from {baseline})")

    state = "" if baselines_changed else ", already set"
    print(f"release-baseline.yaml: upgrade_docs {baseline} (resolved to {resolved_refs['upgrade_docs']}{state})")
    if kind == "minor":
        print(f"release-baseline.yaml: release_table {baseline} (resolved to {resolved_refs['release_table']}{state})")
    else:
        print(
            f"release-baseline.yaml: release_table unchanged ({new_release_table}, "
            f"resolved to {resolved_refs['release_table']})"
        )

    print()
    print(f"=== Running create-doc-version (upgrade_docs baseline {baseline}) ===")
    result = run_script([sys.executable, str(CREATE_DOC_VERSION_SCRIPT)])
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
