#!/usr/bin/env python3
"""
Open a new podiumd release cycle: bump charts/podiumd/Chart.yaml's own
version/appVersion to the target named by the current branch, record the
outgoing version in charts/podiumd/release-baseline.yaml's upgrade_docs
key (and, on a minor bump only, its release_table key too — see below),
then scaffold the upgrade-path docs for the outgoing version as the new
upgrade_docs baseline (runs create-doc-version, which only ever creates
— see that script for why this never risks rebasing docs that should
have been created fresh).

Reads everything from repo state — no arguments:
  - baseline: the chart's current version (Chart.yaml's "version:", before
    this script touches it) — the release being left behind.
  - target: parsed from the current branch name, which must be exactly
    "feature/podiumd-<MAJOR.MINOR.PATCH>" (this repo's branching
    convention — see README.md#branching-strategy).

The baseline -> target jump must be EXACTLY one of:
  - a single patch increment (same major.minor, patch+1) — only
    upgrade_docs is advanced to the outgoing baseline; release_table is
    left untouched (still whatever it already was), and
  - a single minor increment (same major, minor+1, patch 0) — BOTH
    upgrade_docs and release_table are advanced to the outgoing baseline
    (a minor bump is treated as "a real, Confluence-documented milestone
    just shipped").
A major-version change is out of scope for this tool entirely and
refused the same as any other invalid jump (a skipped version, or a
same-or-lower target).

Refuses to run if:
  - the branch name doesn't match that shape,
  - the baseline -> target jump isn't a single patch or minor increment
    as described above, or
  - either baseline this run would end up recording — upgrade_docs (the
    outgoing version, always) and release_table (the outgoing version on
    a minor bump, or whatever's already recorded on a patch bump) —
    doesn't resolve to an actual podiumd-<version> tag or
    feature/podiumd-<version> branch (same check as
    change-podiumd-baseline, via lib.gitutil.resolve_baseline_ref). On a
    patch bump this also means: refuses if release_table isn't already
    recorded at all — there's no "absent is fine" leniency here, since
    release-baseline.yaml is meant to always carry both keys once it
    exists.

Usage:
    create-podiumd-version

Example:
    # on branch feature/podiumd-4.9.1, with Chart.yaml at version: 4.9.0
    # and release-baseline.yaml already recording release_table: "4.8.5"
    create-podiumd-version
        # bumps Chart.yaml's version/appVersion 4.9.0 -> 4.9.1 (a patch
        # increment), writes upgrade_docs: "4.9.0" (release_table stays
        # "4.8.5"), then runs create-doc-version 4.9.0

    # on branch feature/podiumd-4.10.0, with Chart.yaml at version: 4.9.1
    create-podiumd-version
        # bumps Chart.yaml's version/appVersion 4.9.1 -> 4.10.0 (a minor
        # increment), writes BOTH upgrade_docs and release_table to
        # "4.9.1", then runs create-doc-version 4.9.1
"""
import re
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from lib.chart import SEMVER_RE as CHART_VERSION_RE
from lib.chart import chart_version, replace_scalar_value, write_release_baselines
from lib.chart import release_table_baseline as read_release_table_baseline
from lib.gitutil import current_branch, find_repo_root, resolve_baseline_ref
from lib.procutil import run_script

CHART_DIR = SCRIPT_DIR.parent
CHART_YAML = CHART_DIR / "Chart.yaml"
CREATE_DOC_VERSION_SCRIPT = SCRIPT_DIR / "create-doc-version"

BRANCH_RE = re.compile(r"^feature/podiumd-(\d+\.\d+\.\d+)$")


def current_chart_version():
    return chart_version(CHART_YAML)


def version_tuple(v):
    return tuple(int(part) for part in v.split("."))


def bump_kind(baseline, target):
    """"patch", "minor", or None (not a valid single-increment jump —
    covers a same-or-lower target, a skipped version, and any
    major-version change, which is out of scope for this tool
    entirely)."""
    b_major, b_minor, b_patch = version_tuple(baseline)
    t_major, t_minor, t_patch = version_tuple(target)
    if b_major == t_major and b_minor == t_minor and t_patch == b_patch + 1:
        return "patch"
    if b_major == t_major and t_minor == b_minor + 1 and t_patch == 0:
        return "minor"
    return None


def update_chart_version(new_version):
    """Bump Chart.yaml's top-level "version:" and "appVersion:" (this
    repo's own chart always keeps the two in lockstep — see git history of
    every prior release bump) to new_version. Returns the field names
    actually changed, in file order."""
    lines = CHART_YAML.read_text(encoding="utf-8").splitlines(keepends=True)
    changed = []
    for i, line in enumerate(lines):
        if re.match(r"^version:\s", line):
            lines[i] = replace_scalar_value(line, new_version)
            changed.append("version")
        elif re.match(r"^appVersion:\s", line):
            lines[i] = replace_scalar_value(line, new_version)
            changed.append("appVersion")
    if "version" not in changed:
        raise SystemExit(f"error: could not find a top-level 'version:' line in {CHART_YAML}")
    CHART_YAML.write_text("".join(lines), encoding="utf-8")
    return changed


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)
    if len(sys.argv) != 1:
        print(__doc__)
        sys.exit(1)

    repo_root = find_repo_root(CHART_DIR)
    if repo_root is None:
        print("error: not inside a git repository")
        sys.exit(1)

    branch = current_branch(repo_root)
    m = BRANCH_RE.match(branch)
    if not m:
        print(f"error: current branch '{branch or '(detached HEAD)'}' does not match "
              f"'feature/podiumd-<MAJOR.MINOR.PATCH>' — refusing to guess the target version")
        sys.exit(1)
    target = m.group(1)

    baseline = current_chart_version()
    if not CHART_VERSION_RE.match(baseline):
        print(f"error: {CHART_YAML}'s version '{baseline}' is not a plain MAJOR.MINOR.PATCH")
        sys.exit(1)

    kind = bump_kind(baseline, target)
    if kind is None:
        print(f"error: {baseline} -> {target} is not a single patch increment (same "
              f"major.minor, patch+1) or a single minor increment (same major, minor+1, "
              f"patch 0) — refusing. A major-version change is out of scope for this tool; "
              f"a skipped version or a same-or-lower target isn't supported either.")
        sys.exit(1)

    new_release_table = baseline if kind == "minor" else read_release_table_baseline(CHART_DIR)

    resolved_refs = {}
    for label, value in (("upgrade_docs", baseline), ("release_table", new_release_table)):
        if value is None:
            print("error: release_table baseline is not yet recorded in release-baseline.yaml "
                  "— cannot open a patch release without one already set (a minor-bump run "
                  "records it for the first time; there's no fallback for a patch bump)")
            sys.exit(1)
        ref, error = resolve_baseline_ref(repo_root, value)
        if error:
            print(f"error: {label} baseline '{value}': {error}")
            sys.exit(1)
        resolved_refs[label] = ref

    changed = update_chart_version(target)
    print(f"{CHART_YAML.name}: {', '.join(changed)} {baseline} -> {target} ({kind} bump)")

    write_release_baselines(CHART_DIR, upgrade_docs=baseline,
                             release_table=(baseline if kind == "minor" else None))
    print(f"release-baseline.yaml: upgrade_docs {baseline} "
          f"(resolved to {resolved_refs['upgrade_docs']})")
    if kind == "minor":
        print(f"release-baseline.yaml: release_table {baseline} "
              f"(resolved to {resolved_refs['release_table']})")
    else:
        print(f"release-baseline.yaml: release_table unchanged ({new_release_table}, "
              f"resolved to {resolved_refs['release_table']})")

    print()
    print(f"=== Running create-doc-version {baseline} ===")
    result = run_script([sys.executable, str(CREATE_DOC_VERSION_SCRIPT), baseline])
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
