{
  "uri": "/api/v2/zoeken*",
  "name": "apiproxy-kvk-search",
  "labels": { "managed-by": "iac" },
  "plugins": {
    "proxy-rewrite": { "regex_uri": ["^/(.*)", "/test/$1"] },
    "serverless-pre-function": {
      "phase": "rewrite",
      "functions": ["return function(_, ctx) require(\"apisix.core\").request.set_header(ctx, \"apikey\", os.getenv(\"KVK_API_KEY\")) end"]
    }
  },
  "upstream": { "scheme": "https", "pass_host": "rewrite", "upstream_host": "api.kvk.nl", "nodes": { "api.kvk.nl:443": 1 }, "type": "roundrobin" }
}
